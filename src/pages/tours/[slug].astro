---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { TOURS, getTourBySlug } from '../../data/tours';
import TourHeroGallery from '../../components/tours/TourHeroGallery';
import ItineraryAccordion from '../../components/tours/ItineraryAccordion';
import BookingForm from '../../components/tours/BookingForm';
import TourRouteMap from '../../components/tours/TourRouteMap';
import TourCard from '../../components/tours/TourCard.astro';
import { SITE } from '../../data/site';

export async function getStaticPaths() {
  return TOURS.map(tour => ({ params: { slug: tour.slug } }));
}

const { slug } = Astro.params;
const tour = getTourBySlug(slug as string);
if (!tour) return Astro.redirect('/tours');

const related = TOURS.filter(t => t.slug !== tour.slug && t.category === tour.category).slice(0, 2);

const heroImages = [tour.heroImage, ...tour.galleryImages].filter(Boolean).slice(0, 6);

const heroChips = [
  { icon: '💰', label: tour.price },
  { icon: '🕐', label: tour.duration },
  { icon: '📍', label: `${tour.mapRoute.length} destinations` },
  { icon: '👥', label: tour.bestFor[0] ?? '100% Private' },
  { icon: '⚡', label: `Pace: ${tour.pace}` },
  ...(tour.bestSeason.length ? [{ icon: '📅', label: `Best: ${tour.bestSeason[0]}` }] : []),
];

const paceColors: Record<string, string> = {
  Relaxed:  'bg-green-100 text-green-700',
  Moderate: 'bg-amber-100 text-amber-700',
  Active:   'bg-red-100 text-red-700',
};
---

<BaseLayout
  title={tour.seoTitle}
  description={tour.seoDescription}
  image={tour.heroImage}
  type="article"
>
  <!-- ① Auto-cycling hero gallery with glassmorphism title card -->
  <TourHeroGallery
    images={heroImages}
    title={tour.title}
    subtitle={tour.subtitle}
    chips={heroChips}
    description={tour.summary}
    client:load
  />

  <!-- ② Sticky price bar -->
  <div class="sticky top-16 lg:top-20 z-30 bg-white/95 backdrop-blur-md border-b border-stone shadow-sm">
    <div class="section-wrap py-2.5 flex items-center justify-between gap-4">
      <div class="flex items-center gap-4 overflow-x-auto scrollbar-hidden">
        <span class="text-forest-700 font-bold text-lg whitespace-nowrap flex-shrink-0">{tour.price}</span>
        <span class="text-warmgray text-xs whitespace-nowrap flex-shrink-0 hidden sm:block">{tour.priceNote}</span>
        <span class={`hidden sm:inline-flex text-xs font-medium px-2.5 py-1 rounded-full ${paceColors[tour.pace]}`}>
          {tour.pace} pace
        </span>
      </div>
      <div class="flex items-center gap-2 flex-shrink-0">
        <a href={`https://wa.me/${SITE.whatsapp}`} target="_blank" rel="noopener noreferrer"
           class="hidden sm:flex items-center gap-1.5 text-xs font-semibold text-[#25D366]
                  border border-[#25D366] px-3 py-2 rounded-full hover:bg-[#25D366] hover:text-white transition-all">
          <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
          </svg>
          WhatsApp
        </a>
        <a href="#book" class="btn-primary py-2 px-4 text-xs">Book This Tour</a>
      </div>
    </div>
  </div>

  <!-- ③ Main content: itinerary + booking sidebar -->
  <section class="py-12 sm:py-16 bg-stone/25">
    <div class="section-wrap">
      <div class="flex flex-col-reverse md:grid md:grid-cols-[1fr_300px] lg:grid-cols-[1fr_340px] gap-8 lg:gap-10 items-start">

        <!-- Sticky booking sidebar (renders second on mobile so it appears above content) -->
        <div class="md:col-start-2 md:row-start-1 lg:sticky lg:top-28 w-full" id="book">
          <div class="reveal">
            <BookingForm
              tourTitle={tour.title}
              destinations={tour.mapRoute}
              priceNote={tour.priceNote}
              whatsapp={SITE.whatsapp}
              client:load
            />
          </div>
        </div>

        <!-- Left column: all tour content -->
        <div class="md:col-start-1 md:row-start-1 space-y-8 w-full">

          <!-- Day-by-day itinerary -->
          <div class="bg-white border border-stone rounded-3xl p-6 md:p-8 shadow-card reveal">
            <h2 class="font-display text-2xl md:text-3xl text-forest-700 mb-7">
              Day-by-Day Itinerary
            </h2>
            <ItineraryAccordion days={tour.itinerary} client:visible />
          </div>

          <!-- Tour highlights -->
          <div class="bg-white border border-stone rounded-3xl p-6 md:p-8 shadow-card reveal">
            <h2 class="font-display text-2xl md:text-3xl text-forest-700 mb-6">Tour Highlights</h2>
            <ul class="grid grid-cols-1 md:grid-cols-2 gap-3">
              {tour.highlights.map(item => (
                <li class="flex items-start gap-2.5 text-sm md:text-base text-warmgray">
                  <svg class="w-4 h-4 text-forest-600 mt-0.5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
                  </svg>
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </div>

          <!-- Included / Excluded -->
          {(tour.included.length > 0 || tour.excluded.length > 0) && (
            <div class="bg-white border border-stone rounded-3xl p-6 md:p-8 shadow-card reveal">
              <h2 class="font-display text-2xl md:text-3xl text-forest-700 mb-7">What's Included</h2>
              <div class="grid grid-cols-1 md:grid-cols-2 gap-6 md:gap-8">
                {tour.included.length > 0 && (
                  <div>
                    <p class="text-xs font-bold tracking-widest text-green-600 uppercase mb-4">Included</p>
                    <ul class="space-y-3">
                      {tour.included.map(item => (
                        <li class="flex items-start gap-3">
                          <svg class="w-4 h-4 text-green-500 mt-0.5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
                          </svg>
                          <span class="text-sm md:text-base text-forest-700 leading-snug">{item}</span>
                        </li>
                      ))}
                    </ul>
                  </div>
                )}
                {tour.excluded.length > 0 && (
                  <div>
                    <p class="text-xs font-bold tracking-widest text-warmgray uppercase mb-4">Not Included</p>
                    <ul class="space-y-3">
                      {tour.excluded.map(item => (
                        <li class="flex items-start gap-3">
                          <svg class="w-4 h-4 text-stone-400 mt-0.5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z"/>
                          </svg>
                          <span class="text-sm md:text-base text-warmgray leading-snug">{item}</span>
                        </li>
                      ))}
                    </ul>
                  </div>
                )}
              </div>
            </div>
          )}
        </div>
      </div>
    </div>
  </section>

  <!-- ④ Route map — full width section -->
  {tour.routeStops && tour.routeStops.length > 1 && (
    <section class="pb-16 md:pb-24 bg-ivory">
      <div class="section-wrap">
        <div class="mb-6 md:mb-8 reveal">
          <p class="section-eyebrow">The Journey</p>
          <h2 class="font-display text-2xl md:text-3xl text-forest-700 tracking-tight">Route Map</h2>
          <p class="text-sm md:text-base text-warmgray mt-1.5">
            See the full journey across Sri Lanka at a glance. Numbers match itinerary days.
          </p>
        </div>

        <div class="reveal">
          <TourRouteMap stops={tour.routeStops} client:only="react" />
        </div>

        <p class="text-xs text-warmgray mt-3">
          Route follows actual roads via OpenStreetMap · Hold Ctrl and scroll to zoom
        </p>
      </div>
    </section>
  )}

  <!-- ⑤ Related tours -->
  {related.length > 0 && (
    <section class="py-16 sm:py-20 bg-stone/30">
      <div class="section-wrap">
        <h2 class="font-display text-2xl sm:text-3xl text-forest-700 mb-8 reveal">You May Also Like</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          {related.map(t => (
            <div class="reveal">
              <TourCard tour={t} />
            </div>
          ))}
        </div>
        <div class="mt-8 text-center">
          <a href="/tours" class="btn-outline-forest">View All Tours</a>
        </div>
      </div>
    </section>
  )}
</BaseLayout>
