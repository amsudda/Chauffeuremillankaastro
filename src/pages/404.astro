---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Page Not Found | Chauffeur Emil Lanka Tour"
  description="Page not found. Explore private Sri Lanka tours with Emil Jayasekara — wildlife safaris, hill country escapes, cultural journeys & custom itineraries."
  noindex={true}
>
  <section class="min-h-screen bg-forest-gradient flex items-center justify-center px-4">
    <div class="text-center max-w-lg">
      <p class="text-gold-400 font-display text-8xl font-bold mb-6 animate-float">404</p>
      <h1 class="font-display text-3xl sm:text-4xl text-ivory mb-4">
        This Page Has Wandered Off
      </h1>
      <p class="text-white/60 leading-relaxed mb-8">
        Like a traveller who took a wrong turn in Kandy's streets — charming, but not quite where you wanted to be.
        Let's get you back on track.
      </p>
      <div class="flex flex-col sm:flex-row gap-3 justify-center">
        <a href="/" class="btn-primary">Go Home</a>
        <a href="/tours" class="btn-secondary">Browse Tours</a>
      </div>
    </div>
  </section>
</BaseLayout>
