---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTABanner from '../components/home/CTABanner.astro';
import { SITE } from '../data/site';
import { img } from '../data/imageUrls';
---

<BaseLayout
  title="Sri Lanka Tours from Belgium 2026 | Private Chauffeur Guide Emil"
  description="Planning a Sri Lanka rondreis / voyage from Belgium? Emil Jayasekara is a private SLTDA-certified chauffeur guide with 14+ years experience. Visa (ETA) info, best time to visit, flights from Brussels, and why private beats a group tour."
  canonical="https://www.chauffeuremillankatour.com/sri-lanka-tours-from-belgium"
  alternates={[
    { hreflang: 'en',        href: 'https://www.chauffeuremillankatour.com/sri-lanka-tours-from-belgium' },
    { hreflang: 'nl-BE',     href: 'https://www.chauffeuremillankatour.com/nl/sri-lanka-rondreis' },
    { hreflang: 'x-default', href: 'https://www.chauffeuremillankatour.com/sri-lanka-tours-from-belgium' },
  ]}
>
  <script slot="head" type="application/ld+json">{JSON.stringify({
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": ["LocalBusiness", "TourOperator"],
        "@id": "https://www.chauffeuremillankatour.com/#business",
        "name": "Chauffeur Emil Lanka Tours",
        "description": "Private chauffeur guide and tour driver in Sri Lanka for Belgian travellers.",
        "url": "https://www.chauffeuremillankatour.com",
        "telephone": "+94761917039",
        "areaServed": [
          { "@type": "Country", "name": "Sri Lanka" },
          { "@type": "Country", "name": "Belgium" }
        ],
        "aggregateRating": {
          "@type": "AggregateRating",
          "ratingValue": 5.0,
          "reviewCount": 312
        }
      },
      {
        "@type": "FAQPage",
        "mainEntity": [
          {
            "@type": "Question",
            "name": "Do Belgians need a visa for Sri Lanka?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Yes. Belgian passport holders need an Electronic Travel Authorization (ETA) before arriving in Sri Lanka. It is applied for online at eta.gov.lk, costs approximately USD 20–35, and allows a 30-day stay. As of 2024 Sri Lanka has also introduced free ETA periods — check the official portal for current status before you travel."
            }
          },
          {
            "@type": "Question",
            "name": "Is Sri Lanka safe for Belgian tourists in 2026?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Yes, Sri Lanka is safe for Belgian tourists in 2026. The country has fully stabilised after the 2022 economic crisis and tourism has returned strongly. The Belgian FPS Foreign Affairs (Buitenlandse Zaken / Affaires étrangères) travel advice recommends normal vigilance for most of the island. Emil has guided hundreds of European guests, including Belgians, without incident."
            }
          },
          {
            "@type": "Question",
            "name": "What is the best time for Belgians to visit Sri Lanka?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "December to March is the dry season for the west and south coasts — perfect for beaches and cultural sites, and an ideal escape from the Belgian winter. July to September is best for the Cultural Triangle, east coast, and the Kandy Esala Perahera festival in August — which aligns perfectly with the Belgian summer school holidays (zomervakantie / vacances d'été)."
            }
          },
          {
            "@type": "Question",
            "name": "How long are flights from Brussels to Sri Lanka?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "There are no direct flights from Brussels (BRU) to Colombo (CMB). Flights take approximately 12–15 hours total with one stopover, typically via Doha (Qatar Airways), Dubai (Emirates), Istanbul (Turkish Airlines), or Abu Dhabi (Etihad). Connections from Brussels Airport are frequent and daily."
            }
          },
          {
            "@type": "Question",
            "name": "What is the Kandy Esala Perahera and when is it in 2026?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "The Kandy Esala Perahera is Sri Lanka's most spectacular Buddhist festival — 10 nights of candlelit processions featuring over 100 decorated elephants, traditional Kandyan drummers, dancers, and fire performers through the streets of Kandy. In 2026 it runs in August, right in the middle of the Belgian summer holidays. Emil organises front-row viewing spots and builds full itineraries around the festival dates."
            }
          },
          {
            "@type": "Question",
            "name": "Is a private chauffeur guide better than a group tour like Koning Aap or Joker?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Group operators such as Koning Aap, Joker, and Connections run fixed itineraries with shared transport and a set schedule. A private chauffeur guide like Emil gives you a fully custom itinerary, a private air-conditioned vehicle, and 1-on-1 guiding every day. You leave when you want, stop where you want, and have direct WhatsApp access to Emil throughout — often at comparable value for a couple or family."
            }
          },
          {
            "@type": "Question",
            "name": "Do I need travel insurance for Sri Lanka from Belgium?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Yes. Your Belgian mutuelle / ziekenfonds and European Health Insurance Card do not cover you in Sri Lanka, so a travel insurance policy (reisverzekering / assurance voyage) is strongly recommended. Belgian insurers including Europ Assistance, Ethias, AG Insurance, and Allianz Assistance all offer Sri Lanka cover. Ensure it includes medical evacuation and any adventure activities such as safaris or hiking."
            }
          }
        ]
      }
    ]
  })}</script>

  <!-- Hero -->
  <section class="relative bg-forest-gradient pt-28 pb-16 sm:pt-36 sm:pb-24 overflow-hidden">
    <div class="absolute inset-0 opacity-10"
         style="background-image:radial-gradient(circle at 80% 30%, #C9A84C 0%, transparent 50%)">
    </div>
    <div class="relative z-10 section-wrap max-w-4xl mx-auto text-center">
      <div class="inline-flex items-center gap-2 bg-gold-400/15 border border-gold-400/30 rounded-full
                  px-4 py-2 mb-6">
        <span class="text-lg">🇧🇪</span>
        <span class="text-gold-300 text-xs font-semibold tracking-widest uppercase">For Belgian Travellers</span>
      </div>
      <h1 class="font-display text-5xl sm:text-6xl text-white leading-tight mb-6">
        Sri Lanka Tours<br/>
        <em class="not-italic text-gold-300">from Belgium</em>
      </h1>
      <p class="text-white/75 text-lg sm:text-xl leading-relaxed mb-8 max-w-2xl mx-auto">
        Whether you searched a <em class="text-gold-300/90 not-italic">Sri Lanka rondreis</em> or a
        <em class="text-gold-300/90 not-italic">voyage privé au Sri Lanka</em> — skip the group bus.
        Travel privately with Emil Jayasekara: SLTDA-certified chauffeur guide, 14+ years experience,
        312 five-star reviews. Your itinerary, your pace, your guide.
      </p>
      <div class="flex flex-wrap gap-3 justify-center mb-10">
        <a href={`https://wa.me/${SITE.whatsapp}`} target="_blank" rel="noopener noreferrer"
           class="flex items-center gap-2 bg-[#25D366] text-white font-semibold px-6 py-3.5 rounded-full text-sm hover:bg-[#1fb959] transition-colors">
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
          </svg>
          WhatsApp Emil
        </a>
        <a href="/tailor-made"
           class="border border-white/30 text-white font-semibold px-6 py-3.5 rounded-full text-sm hover:bg-white/10 transition-colors">
          Plan My Sri Lanka Trip
        </a>
      </div>
      <!-- Trust row -->
      <div class="flex flex-wrap justify-center gap-6 text-white/60 text-xs">
        {['⭐ 5.0 · 312 TripAdvisor Reviews', '🏅 SLTDA Certified', '🇪🇺 Trusted by European Guests', '💬 Replies within 2 hours'].map(t => (
          <span>{t}</span>
        ))}
      </div>
    </div>
  </section>

  <!-- Quick info strip -->
  <section class="bg-white border-b border-stone py-8">
    <div class="section-wrap">
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-6 text-center">
        {[
          { icon: '✈️', label: 'Flight Time', value: '~12–15 hrs', sub: 'From Brussels · 1 stopover' },
          { icon: '🛂', label: 'Visa', value: 'ETA Required', sub: 'Apply online · ~USD 20–35' },
          { icon: '🌤️', label: 'Best Season', value: 'Dec–Mar & Jul–Sep', sub: 'Aligns with Belgian holidays' },
          { icon: '💶', label: 'Currency', value: 'Sri Lankan Rupee', sub: '1 EUR ≈ 320–350 LKR' },
        ].map(item => (
          <div class="reveal">
            <div class="text-2xl mb-2">{item.icon}</div>
            <p class="text-forest-700 font-semibold text-sm">{item.label}</p>
            <p class="text-warmbrown font-medium text-sm">{item.value}</p>
            <p class="text-warmgray text-xs mt-0.5">{item.sub}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Is Sri Lanka safe -->
  <section class="py-20 sm:py-28 bg-ivory">
    <div class="section-wrap max-w-4xl mx-auto">
      <div class="grid lg:grid-cols-2 gap-12 items-center">
        <div class="reveal">
          <p class="section-eyebrow">Safety & Security</p>
          <h2 class="section-title mb-5">Is Sri Lanka Safe for Belgians in 2026?</h2>
          <p class="text-warmgray leading-relaxed mb-4">
            <strong class="text-forest-700">Yes — Sri Lanka is safe for Belgian tourists in 2026.</strong>
            The country has fully stabilised following the 2022 economic crisis, tourism infrastructure
            has recovered strongly, and international arrivals are back to pre-crisis levels.
          </p>
          <p class="text-warmgray leading-relaxed mb-4">
            The Belgian <strong>FPS Foreign Affairs</strong> (Buitenlandse Zaken / Affaires étrangères)
            travel advice recommends <strong class="text-forest-700">normal vigilance</strong> for most
            of the island — the same guidance applied to many popular holiday destinations.
          </p>
          <p class="text-warmgray leading-relaxed mb-6">
            Emil has guided hundreds of European guests across 14 years — families, couples, and solo
            travellers from Brussels, Antwerp, Ghent, and Liège — without a single safety incident.
            He shares his personal WhatsApp number and is reachable throughout your trip.
          </p>
          <a href="https://diplomatie.belgium.be/nl/landen/sri-lanka/reisadvies" target="_blank"
             rel="noopener noreferrer"
             class="inline-flex items-center gap-2 text-forest-600 text-sm font-medium hover:text-sunset-400 transition-colors">
            Check the Belgian FPS Foreign Affairs advice →
          </a>
        </div>
        <div class="reveal">
          <div class="rounded-3xl overflow-hidden shadow-card-hover">
            <img
              src={img('destinations/sigiriya/sigiriya lions  rock.webp')}
              alt="Sigiriya Rock Fortress — safe and popular with Belgian tourists"
              loading="lazy"
              width="600" height="450"
              class="w-full h-72 object-cover"
            />
          </div>
          <div class="mt-4 bg-white rounded-2xl border border-stone p-5 shadow-card">
            <p class="text-forest-700 font-semibold text-sm mb-2">Emil's safety promise to Belgian guests</p>
            <ul class="space-y-1.5 text-warmgray text-sm">
              {[
                'Personal WhatsApp — reachable 24/7 during your tour',
                'Fully insured private vehicle, inspected before every journey',
                'Pre-vetted hotels, restaurants, and excursion partners',
                'Emergency contacts and hospital knowledge island-wide',
              ].map(item => (
                <li class="flex items-start gap-2">
                  <span class="text-forest-600 mt-0.5">✓</span>
                  {item}
                </li>
              ))}
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Best time to visit -->
  <section class="py-20 sm:py-28 bg-white">
    <div class="section-wrap max-w-4xl mx-auto">
      <div class="text-center mb-12 reveal">
        <p class="section-eyebrow">Travel Planning</p>
        <h2 class="section-title mb-3">Best Time for Belgians to Visit Sri Lanka</h2>
        <p class="text-warmgray max-w-2xl mx-auto text-sm leading-relaxed">
          Good news — Belgian school holidays line up neatly with Sri Lanka's two best travel windows,
          whether you want winter sun or the summer festival season.
        </p>
      </div>
      <div class="grid sm:grid-cols-2 gap-6 mb-10">
        {[
          {
            months: 'December – March',
            badge: '❄️ Escape the Belgian Winter',
            title: 'West & South Coast Season',
            body: 'Dry, sunny, and perfect for beaches, whale watching in Mirissa, Galle Fort, and the Cultural Triangle. The ideal escape from grey Belgian winters — the krokusvakantie (February) lands right in peak season. Book Emil early.',
            highlight: 'Best for: Beaches, Galle, Kandy, Sigiriya, Yala',
            color: 'border-gold-400/50 bg-gold-400/5',
          },
          {
            months: 'July – September',
            badge: '🐘 Perahera + Summer Holidays',
            title: 'Cultural Triangle & East Coast',
            body: 'Sri Lanka\'s most exciting cultural period, right in the middle of the Belgian zomervakantie / vacances d\'été. The Kandy Esala Perahera in August is unmissable — 10 nights of elephant processions and traditional ceremony.',
            highlight: 'Best for: Perahera, Polonnaruwa, Anuradhapura, East Coast',
            color: 'border-forest-400/50 bg-forest-600/5',
          },
        ].map(s => (
          <div class={`rounded-2xl border-2 p-6 reveal ${s.color}`}>
            <div class="flex items-center justify-between mb-3 gap-3">
              <p class="font-display text-forest-700 text-lg">{s.months}</p>
              <span class="text-xs bg-white border border-stone rounded-full px-3 py-1 font-medium text-forest-700 whitespace-nowrap">{s.badge}</span>
            </div>
            <h3 class="font-semibold text-warmbrown mb-2">{s.title}</h3>
            <p class="text-warmgray text-sm leading-relaxed mb-3">{s.body}</p>
            <p class="text-forest-600 text-xs font-semibold">{s.highlight}</p>
          </div>
        ))}
      </div>

      <!-- Perahera callout -->
      <div class="rounded-3xl overflow-hidden shadow-card-hover reveal">
        <div class="relative h-56">
          <img
            src="/esela-perahera.webp"
            alt="Kandy Esala Perahera — August festival Sri Lanka"
            loading="lazy"
            width="900" height="400"
            class="w-full h-full object-cover"
          />
          <div class="absolute inset-0 bg-gradient-to-r from-forest-700/90 to-forest-700/30 flex items-center">
            <div class="p-8 max-w-lg">
              <p class="text-gold-300 text-xs font-semibold tracking-widest uppercase mb-2">August 2026 · Kandy</p>
              <h3 class="font-display text-white text-2xl mb-2">Kandy Esala Perahera</h3>
              <p class="text-white/75 text-sm leading-relaxed mb-4">
                100+ decorated elephants. Kandyan drummers. Fire dancers. 10 nights of procession
                through ancient streets — perfectly timed for the Belgian summer holidays.
              </p>
              <a href="/tailor-made"
                 class="inline-block bg-gold-400 text-forest-800 font-bold text-sm px-5 py-2.5 rounded-full hover:bg-gold-300 transition-colors">
                Plan Around the Perahera →
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Visa section -->
  <section class="py-20 sm:py-28 bg-ivory">
    <div class="section-wrap max-w-4xl mx-auto">
      <div class="grid lg:grid-cols-2 gap-12 items-start">
        <div class="reveal">
          <p class="section-eyebrow">Visa & Entry</p>
          <h2 class="section-title mb-5">Sri Lanka Visa for Belgians</h2>
          <p class="text-warmgray leading-relaxed mb-4">
            Belgian passport holders require an <strong class="text-forest-700">Electronic Travel Authorization (ETA)</strong>
            to enter Sri Lanka. It is applied for online — no embassy visit required.
          </p>
          <div class="space-y-3 mb-6">
            {[
              { label: 'Cost', value: 'Approx. USD 20–35 (check eta.gov.lk for current pricing — free ETA periods apply)' },
              { label: 'Duration', value: '30 days, double entry' },
              { label: 'Processing', value: 'Usually within 24–72 hours online' },
              { label: 'Apply at', value: 'eta.gov.lk (official Sri Lanka government portal)' },
              { label: 'Passport validity', value: 'At least 6 months beyond your travel dates' },
            ].map(row => (
              <div class="flex gap-3 bg-white rounded-xl border border-stone p-3.5">
                <span class="text-forest-700 font-semibold text-sm w-28 flex-shrink-0">{row.label}</span>
                <span class="text-warmgray text-sm">{row.value}</span>
              </div>
            ))}
          </div>
          <p class="text-warmgray text-sm leading-relaxed">
            Emil assists all guests with visa questions over WhatsApp before arrival.
            He'll confirm the current ETA status and flag any entry requirement changes.
          </p>
        </div>

        <!-- Flights -->
        <div class="reveal">
          <p class="section-eyebrow">Getting There</p>
          <h2 class="section-title mb-5">Flights from Belgium to Sri Lanka</h2>
          <p class="text-warmgray leading-relaxed mb-5">
            There are no direct flights between Brussels and Colombo — all routes have one stopover.
            Total flight time from <strong class="text-forest-700">Brussels (BRU)</strong> is typically
            <strong class="text-forest-700">12–15 hours</strong>.
          </p>
          <div class="space-y-3 mb-5">
            {[
              { route: 'Brussels → Colombo', via: 'Via Doha (Qatar Airways)', time: '~13 hrs' },
              { route: 'Brussels → Colombo', via: 'Via Dubai (Emirates)', time: '~14 hrs' },
              { route: 'Brussels → Colombo', via: 'Via Istanbul (Turkish Airlines)', time: '~13 hrs' },
              { route: 'Brussels → Colombo', via: 'Via Abu Dhabi (Etihad)', time: '~14 hrs' },
            ].map(f => (
              <div class="bg-white rounded-xl border border-stone p-3.5 flex items-center justify-between gap-3">
                <div>
                  <p class="text-forest-700 font-semibold text-sm">{f.route}</p>
                  <p class="text-warmgray text-xs">{f.via}</p>
                </div>
                <span class="text-forest-600 font-bold text-sm flex-shrink-0">{f.time}</span>
              </div>
            ))}
          </div>
          <p class="text-warmgray text-sm">
            Emil meets all guests at <strong>Bandaranaike International Airport (CMB)</strong> in Colombo
            — airport transfer is included in every private tour package.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Emil vs group tours -->
  <section class="py-20 sm:py-28 bg-white">
    <div class="section-wrap max-w-4xl mx-auto">
      <div class="text-center mb-12 reveal">
        <p class="section-eyebrow">Private vs Group Travel</p>
        <h2 class="section-title mb-3">Private Guide vs a Group Rondreis</h2>
        <p class="text-warmgray max-w-2xl mx-auto text-sm">
          Many Belgians compare group operators like Koning Aap, Joker, and Connections with a private
          chauffeur option. Here's the honest difference.
        </p>
      </div>
      <div class="overflow-x-auto rounded-3xl border border-stone shadow-card reveal">
        <table class="w-full text-sm min-w-[540px]">
          <thead>
            <tr class="bg-forest-gradient text-white">
              <th class="px-5 py-4 text-left font-semibold"></th>
              <th class="px-5 py-4 text-left font-semibold text-gold-300">Emil (Private)</th>
              <th class="px-5 py-4 text-left font-semibold text-white/70">Group Rondreis / Tour</th>
            </tr>
          </thead>
          <tbody>
            {[
              ['Group size',          'Just you (+ your travel party)',     '12–20 strangers'],
              ['Itinerary',           'Fully custom — built around you',    'Fixed group schedule'],
              ['Guide',               'Emil, every day — direct WhatsApp',  'Varies by departure'],
              ['Vehicle',             'Private A/C Toyota — yours only',    'Shared group bus'],
              ['Flexibility',         'Stop anywhere, anytime',             'Fixed stops, fixed times'],
              ['Airport transfer',    'Included — Emil meets you',          'Not always included'],
              ['Perahera access',     'Front-row spots, Emil arranges it',  'Standard group viewing'],
              ['Pace',                'Your pace — slow down, speed up',    'Group consensus'],
              ['Price per couple',    'Often comparable or better value',   'Per-person group rate'],
            ].map(([feature, emil, group], i) => (
              <tr class={i % 2 === 0 ? 'bg-ivory' : 'bg-white'}>
                <td class="px-5 py-3 font-medium text-forest-700">{feature}</td>
                <td class="px-5 py-3 text-forest-600 font-medium">{emil}</td>
                <td class="px-5 py-3 text-warmgray">{group}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="text-center text-warmgray text-sm mt-6 reveal">
        Questions? <a href={`https://wa.me/${SITE.whatsapp}`} target="_blank" rel="noopener noreferrer"
                      class="text-forest-600 font-medium hover:text-sunset-400 transition-colors">
          Message Emil on WhatsApp
        </a> — he'll give you an honest answer about whether private travel suits your trip.
      </p>
    </div>
  </section>

  <!-- Top destinations -->
  <section class="py-20 sm:py-28 bg-ivory">
    <div class="section-wrap max-w-4xl mx-auto">
      <div class="text-center mb-12 reveal">
        <p class="section-eyebrow">Where to Go</p>
        <h2 class="section-title mb-3">Top Sri Lanka Destinations for Belgians</h2>
      </div>
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5">
        {[
          {
            name: 'Kandy',
            img: img('destinations/kandy/kandy temple of the tooth.webp'),
            desc: 'The cultural capital. Home of the Temple of the Tooth Relic and the Esala Perahera festival. About 3.5 hours from Colombo.',
          },
          {
            name: 'Sigiriya',
            img: img('destinations/sigiriya/sigiriya lions  rock.webp'),
            desc: 'The iconic Lion Rock fortress — a UNESCO World Heritage site rising 200m above the jungle. Climb at sunrise with Emil.',
          },
          {
            name: 'Ella',
            img: img('destinations/Ella/ella 1 nine arch.webp'),
            desc: 'The Nine Arches Bridge, Ella Rock hike, and the world\'s most scenic train ride. The hill country at its best.',
          },
          {
            name: 'Polonnaruwa',
            img: img('destinations/polonnaruwa/polonnaruwa.webp'),
            desc: 'Ancient royal city with perfectly preserved dagobas, stone Buddhas, and ruins set among jungle and lakes.',
          },
          {
            name: 'Yala National Park',
            img: img('yala-safari.jpg'),
            desc: 'The world\'s highest density of leopards. Emil times game drives for golden hour and knows where the big cats roam.',
          },
          {
            name: 'Mirissa Beach',
            img: img('destinations/mirissa/mirissa homepage herosection image idea.webp'),
            desc: 'Sri Lanka\'s best whale watching (November–April) plus a beautiful crescent beach on the south coast.',
          },
        ].map((d, i) => (
