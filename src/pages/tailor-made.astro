---
import BaseLayout from '../layouts/BaseLayout.astro';
import TailorMadeForm from '../components/tours/TailorMadeForm';
import TourAdvisorPanel from '../components/tours/TourAdvisorPanel';
import { SITE } from '../data/site';
import { img } from '../data/imageUrls';
---

<BaseLayout
  title="Plan My Tailor-Made Tour | Custom Sri Lanka Itinerary | Chauffeur Emil Lanka Tours"
  description="Design your perfect Sri Lanka holiday with Emil. Tell us your interests, travel style, and dates — Emil will craft a free bespoke itinerary just for you within 24 hours."
>

  <!-- Hero -->
  <section class="relative bg-forest-gradient pt-28 pb-20 sm:pt-36 sm:pb-28 overflow-hidden">
    <div
      class="absolute inset-0 opacity-15"
      style="background-image: url(https://images.unsplash.com/photo-1506905925346-21bda4d32df4?w=1400&q=20&fit=crop); background-size: cover; background-position: center;"
    ></div>

    <!-- Decorative gold lines -->
    <div class="absolute top-0 left-0 w-px h-full bg-gradient-to-b from-transparent via-gold-400/20 to-transparent ml-12 hidden lg:block"></div>
    <div class="absolute top-0 right-0 w-px h-full bg-gradient-to-b from-transparent via-gold-400/20 to-transparent mr-12 hidden lg:block"></div>

    <div class="relative z-10 section-wrap text-center">
      <div class="inline-flex items-center gap-2 bg-gold-400/15 border border-gold-400/30 rounded-full px-4 py-1.5 mb-6">
        <span class="text-gold-300 text-xs font-semibold tracking-[0.2em] uppercase">Tailor-Made Experience</span>
      </div>
      <h1 class="font-display text-4xl sm:text-5xl lg:text-6xl text-ivory leading-tight mb-5">
        Your Dream Sri Lanka<br/>
        <span class="text-gold-300">Designed Around You</span>
      </h1>
      <p class="text-white/70 text-lg max-w-xl mx-auto leading-relaxed mb-8">
        No two travellers are the same. Tell Emil your passions, travel style, and dates —
        he'll build a private itinerary that fits you perfectly, completely free.
      </p>

      <!-- Trust pills -->
      <div class="flex flex-wrap justify-center gap-3">
        {[
          '✓ Free itinerary planning',
          '✓ No obligation',
          '✓ Reply within 2 hours',
          '✓ 14+ years expertise',
        ].map(badge => (
          <span class="bg-white/10 border border-white/20 text-white/80 text-xs font-medium px-4 py-1.5 rounded-full">
            {badge}
          </span>
        ))}
      </div>
    </div>
  </section>

  <!-- Main content -->
  <section class="py-16 sm:py-24 bg-ivory">
    <div class="section-wrap">
      <div class="grid grid-cols-1 lg:grid-cols-5 gap-12 xl:gap-16 items-start">

        <!-- Left sidebar: Featured tours showcase -->
        <aside class="lg:col-span-2 reveal">

          <!-- Sticky container -->
          <div class="lg:sticky lg:top-24 space-y-5">

            <!-- Header -->
            <div>
              <p class="section-eyebrow mb-1">Or browse a ready-made tour</p>
              <h2 class="font-display text-2xl text-forest-700 leading-tight">
                Popular <span class="text-gold-500">Packages</span>
              </h2>
              <p class="text-warmgray text-xs mt-1.5 leading-relaxed">
                Not sure where to start? Explore our most-loved itineraries — any of these can be customised too.
              </p>
            </div>

            <!-- Tour Cards Stack -->
            <div class="space-y-3">
              {[
                {
                  title: 'Wild Sri Lanka Safari',
                  duration: '7 Days / 6 Nights',
                  category: 'Wildlife',
                  slug: 'wildlife-safari-7-days',
                  image: img('yala-safari.jpg'),
                  highlights: ['Yala Leopards', 'Udawalawe Elephants', 'Wilpattu'],
                  badge: 'Bestseller',
                },
                {
                  title: 'Cultural Triangle Explorer',
                  duration: '5 Days / 4 Nights',
                  category: 'Cultural Tour',
                  slug: 'cultural-triangle-5-days',
                  image: img('sigiriya.jpg'),
                  highlights: ['Sigiriya', 'Polonnaruwa', 'Anuradhapura'],
                  badge: null,
                },
                {
                  title: 'Hill Country Escape',
                  duration: '4 Days / 3 Nights',
                  category: 'Scenic & Nature',
                  slug: 'hill-country-4-days',
                  image: img('destinations/Ella/ella homepage herosection image idea.webp'),
                  highlights: ['Nine Arch Bridge', 'Tea Plantations', 'Ella Rock'],
                  badge: 'Most Scenic',
                },
                {
                  title: 'Complete Sri Lanka Tour',
                  duration: '14 Days / 13 Nights',
                  category: 'All-Inclusive',
                  slug: 'complete-sri-lanka-14-days',
                  image: img('hero-sri-lanka.jpg'),
                  highlights: ['All Regions', 'Wildlife + Culture', 'Beach Finale'],
                  badge: 'Best Value',
                },
              ].map(tour => (
                <a
                  href={`/tours/${tour.slug}`}
                  class="group flex items-stretch gap-0 rounded-xl overflow-hidden border border-stone bg-white shadow-sm hover:shadow-md hover:border-forest-600/40 transition-all duration-300"
                >
                  <!-- Image -->
                  <div class="relative w-28 flex-shrink-0 overflow-hidden">
                    <img
                      src={tour.image}
                      alt={tour.title}
                      loading="lazy"
                      class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-110"
                    />
                    <div class="absolute inset-0 bg-gradient-to-r from-transparent to-black/10" />
                    {tour.badge && (
                      <span class="absolute top-2 left-2 bg-[#C86F33] text-white text-[9px] font-bold uppercase tracking-wide px-2 py-0.5 rounded leading-none">
                        {tour.badge}
                      </span>
                    )}
                  </div>

                  <!-- Content -->
                  <div class="flex-1 px-3.5 py-3 flex flex-col justify-between min-w-0">
                    <div>
                      <p class="text-[10px] font-semibold text-forest-600 uppercase tracking-wider mb-0.5">{tour.category}</p>
                      <h3 class="font-display text-sm text-forest-700 leading-tight line-clamp-1 group-hover:text-forest-600 transition-colors">
                        {tour.title}
                      </h3>
                      <!-- Highlights pills -->
                      <div class="flex flex-wrap gap-1 mt-1.5">
                        {tour.highlights.map(h => (
                          <span class="text-[9px] bg-stone/60 text-warmbrown px-1.5 py-0.5 rounded-full leading-none">{h}</span>
                        ))}
                      </div>
                    </div>
                    <!-- Footer -->
                    <div class="flex items-center justify-between mt-2 pt-2 border-t border-stone/50">
                      <div class="flex items-center gap-1 text-warmgray">
                        <svg class="w-3 h-3 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                          <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
                        </svg>
                        <span class="text-[10px]">{tour.duration}</span>
                      </div>
                      <span class="text-[10px] font-semibold text-forest-600 group-hover:underline flex items-center gap-0.5">
                        View
                        <svg class="w-2.5 h-2.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                          <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/>
                        </svg>
                      </span>
                    </div>
                  </div>
                </a>
              ))}
            </div>

            <!-- See all tours CTA -->
            <a
              href="/tours"
              class="flex items-center justify-center gap-2 w-full py-3 rounded-xl border-2 border-dashed border-forest-600/40 text-forest-600 text-sm font-semibold hover:bg-forest-600/5 hover:border-forest-600 transition-all duration-200 group"
            >
              <svg class="w-4 h-4 group-hover:translate-x-0.5 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/>
              </svg>
              See All Tour Packages
            </a>

            <!-- Emil trust card -->
            <div class="bg-forest-gradient rounded-2xl p-5 text-white relative overflow-hidden">
              <div class="absolute top-0 right-0 w-24 h-24 bg-white/5 rounded-full -translate-y-8 translate-x-8" />
              <div class="absolute bottom-0 left-0 w-16 h-16 bg-gold-400/10 rounded-full translate-y-6 -translate-x-6" />
              <div class="relative z-10">
                <div class="flex items-center gap-2 mb-3">
                  <div class="w-8 h-8 rounded-full bg-gold-400/30 flex items-center justify-center flex-shrink-0">
                    <svg class="w-4 h-4 text-gold-300" fill="currentColor" viewBox="0 0 20 20">
                      <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-6-3a2 2 0 11-4 0 2 2 0 014 0zm-2 4a5 5 0 00-4.546 2.916A5.986 5.986 0 0010 16a5.986 5.986 0 004.546-2.084A5 5 0 0010 11z" clip-rule="evenodd"/>
                    </svg>
                  </div>
                  <div>
                    <p class="font-semibold text-sm text-white leading-none">Emil Jayasekara</p>
                    <p class="text-white/60 text-[10px]">Your Personal Driver-Guide · 14 yrs</p>
                  </div>
                </div>
                <p class="text-white/80 text-xs leading-relaxed italic">
                  "None of my tours follow a fixed script. Fill in the form and I'll shape your perfect Sri Lanka journey — around what you love."
                </p>
                <div class="flex gap-0.5 mt-3">
                  {[1,2,3,4,5].map(_ => (
                    <svg class="w-3.5 h-3.5 text-gold-400" fill="currentColor" viewBox="0 0 20 20">
                      <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                    </svg>
                  ))}
                  <span class="text-white/60 text-[10px] ml-1 self-center">5.0 · 3,000+ guests</span>
                </div>
              </div>
            </div>

            <!-- Live AI Advisor Panel -->
            <TourAdvisorPanel client:load />

          </div>
        </aside>

        <!-- Right: The form -->
        <div class="lg:col-span-3 bg-white rounded-2xl shadow-card border border-stone overflow-hidden reveal">
          <!-- Form header -->
          <div class="bg-forest-gradient px-6 py-6 sm:px-8">
            <p class="text-gold-300 text-xs font-semibold tracking-[0.2em] uppercase mb-1">100% Free · No Obligation</p>
            <h2 class="font-display text-white text-2xl leading-tight">Build Your Perfect Itinerary</h2>
            <p class="text-white/60 text-xs mt-1.5">Fill in what you know — Emil will handle the rest.</p>
          </div>

          <div class="p-6 sm:p-8">
            <TailorMadeForm client:load whatsapp={SITE.whatsapp} />
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- Destination inspiration strip -->
  <section class="py-16 bg-white border-t border-stone">
    <div class="section-wrap">
      <p class="section-eyebrow text-center mb-3">Popular Destinations</p>
      <h2 class="font-display text-2xl sm:text-3xl text-forest-700 text-center mb-10">
        Where Will Your Story Begin?
      </h2>
      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-4">
        {[
          { name: 'Sigiriya',    img: img('destinations/sigiriya/sigiriya lions  rock.webp') },
          { name: 'Ella',        img: img('destinations/Ella/ella homepage herosection image idea.webp') },
          { name: 'Yala',        img: img('destinations/yala/yala.webp') },
          { name: 'Mirissa',     img: img('destinations/mirissa/mirissa homepage herosection image idea.webp') },
          { name: 'Kandy',       img: img('destinations/kandy/kandy temple of the tooth.webp') },
          { name: 'Galle',       img: img('destinations/Galle/galle hero image idea.webp') },
        ].map(d => (
          <div class="group relative rounded-xl overflow-hidden aspect-[3/4] reveal">
            <img
              src={d.img}
              alt={d.name}
              loading="lazy"
              class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-forest-700/80 via-transparent to-transparent"></div>
            <p class="absolute bottom-3 left-0 right-0 text-center text-white text-sm font-semibold">{d.name}</p>
          </div>
        ))}
      </div>
      <p class="text-center text-warmgray text-sm mt-8">
        Not sure where to go? Tell Emil your interests and he'll suggest the perfect route.
      </p>
    </div>
  </section>

</BaseLayout>
