---
import BaseLayout from '../layouts/BaseLayout.astro';
import TailorMadeForm from '../components/tours/TailorMadeForm';
import { SITE } from '../data/site';
import { img } from '../data/imageUrls';
---

<BaseLayout
  title="Plan My Tailor-Made Tour | Custom Sri Lanka Itinerary | Chauffeur Emil Lanka Tours"
  description="Design your perfect Sri Lanka holiday with Emil. Tell us your interests, travel style, and dates — Emil will craft a free bespoke itinerary just for you within 24 hours."
>

  <!-- Hero -->
  <section class="relative bg-forest-gradient pt-28 pb-20 sm:pt-36 sm:pb-28 overflow-hidden">
    <div
      class="absolute inset-0 opacity-15"
      style="background-image: url(https://images.unsplash.com/photo-1506905925346-21bda4d32df4?w=1400&q=20&fit=crop); background-size: cover; background-position: center;"
    ></div>

    <!-- Decorative gold lines -->
    <div class="absolute top-0 left-0 w-px h-full bg-gradient-to-b from-transparent via-gold-400/20 to-transparent ml-12 hidden lg:block"></div>
    <div class="absolute top-0 right-0 w-px h-full bg-gradient-to-b from-transparent via-gold-400/20 to-transparent mr-12 hidden lg:block"></div>

    <div class="relative z-10 section-wrap text-center">
      <div class="inline-flex items-center gap-2 bg-gold-400/15 border border-gold-400/30 rounded-full px-4 py-1.5 mb-6">
        <span class="text-gold-300 text-xs font-semibold tracking-[0.2em] uppercase">Tailor-Made Experience</span>
      </div>
      <h1 class="font-display text-4xl sm:text-5xl lg:text-6xl text-ivory leading-tight mb-5">
        Your Dream Sri Lanka<br/>
        <span class="text-gold-300">Designed Around You</span>
      </h1>
      <p class="text-white/70 text-lg max-w-xl mx-auto leading-relaxed mb-8">
        No two travellers are the same. Tell Emil your passions, travel style, and dates —
        he'll build a private itinerary that fits you perfectly, completely free.
      </p>

      <!-- Trust pills -->
      <div class="flex flex-wrap justify-center gap-3">
        {[
          '✓ Free itinerary planning',
          '✓ No obligation',
          '✓ Reply within 2 hours',
          '✓ 14+ years expertise',
        ].map(badge => (
          <span class="bg-white/10 border border-white/20 text-white/80 text-xs font-medium px-4 py-1.5 rounded-full">
            {badge}
          </span>
        ))}
      </div>
    </div>
  </section>

  <!-- Main content -->
  <section class="py-16 sm:py-24 bg-ivory">
    <div class="section-wrap">
      <div class="grid grid-cols-1 lg:grid-cols-5 gap-12 xl:gap-16 items-start">

        <!-- Left sidebar: why tailor-made -->
        <aside class="lg:col-span-2 space-y-8 reveal">

          <!-- Intro -->
          <div>
            <h2 class="section-title text-2xl sm:text-3xl mb-3">
              Why a Tailor-Made Tour?
            </h2>
            <p class="text-warmgray leading-relaxed text-sm">
              Sri Lanka is endlessly varied. A pre-packaged tour can't account for your pace,
              your passions, or your perfect day. Emil builds every itinerary from scratch —
              just for you.
            </p>
          </div>

          <!-- Feature list -->
          <div class="space-y-4">
            {[
              {
                icon: `<svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7"/></svg>`,
                title: 'Your Route, Your Pace',
                body: 'No fixed coaches or rushing. Linger where you love, skip what doesn\'t excite you.',
              },
              {
                icon: `<svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4"/></svg>`,
                title: 'Every Detail Personalised',
                body: 'Accommodation style, meal preferences, hidden stops — Emil handles every detail.',
              },
              {
                icon: `<svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"/></svg>`,
                title: 'Local Insider Knowledge',
                body: '14 years of guiding means Emil knows the secret viewpoints, the best local restaurants, the off-season gems.',
              },
              {
                icon: `<svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>`,
                title: 'Safe & Fully Supported',
                body: 'SLTDA-certified, fully insured, with 24/7 on-trip support from Emil himself.',
              },
            ].map(f => (
              <div class="flex items-start gap-4">
                <div class="w-10 h-10 rounded-xl bg-forest-600/10 text-forest-600 flex items-center justify-center flex-shrink-0">
                  <span class="w-5 h-5" set:html={f.icon}></span>
                </div>
                <div>
                  <p class="font-semibold text-forest-700 text-sm">{f.title}</p>
                  <p class="text-warmgray text-xs mt-0.5 leading-relaxed">{f.body}</p>
                </div>
              </div>
            ))}
          </div>

          <!-- What happens next -->
          <div class="bg-white border border-stone rounded-2xl p-6 shadow-card">
            <h3 class="font-semibold text-forest-700 mb-4 text-sm">What Happens After You Submit?</h3>
            <ol class="space-y-3">
              {[
                'Emil reviews your request personally within 2 hours',
                'He sends a free bespoke itinerary tailored to your preferences',
                'You refine it together until every detail is perfect',
                'Confirm with a 30% deposit — then just pack your bags',
              ].map((step, i) => (
                <li class="flex items-start gap-3 text-xs text-warmgray">
                  <span class="w-5 h-5 rounded-full bg-forest-600 text-white text-xs font-bold
                               flex items-center justify-center flex-shrink-0 mt-0.5">
                    {i + 1}
                  </span>
                  {step}
                </li>
              ))}
            </ol>
          </div>

          <!-- Social proof -->
          <div class="flex items-center gap-4">
            <div class="flex -space-x-2">
              {['KN', 'SW', 'MF', 'RC', 'TL'].map(initials => (
                <div class="w-9 h-9 rounded-full bg-forest-600 border-2 border-ivory flex items-center
                             justify-center text-white text-xs font-bold">
                  {initials}
                </div>
              ))}
            </div>
            <div>
              <div class="flex gap-0.5">
                {[1,2,3,4,5].map(_ => (
                  <svg class="w-4 h-4 text-gold-400" fill="currentColor" viewBox="0 0 20 20">
                    <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                  </svg>
                ))}
              </div>
              <p class="text-xs text-warmgray">Trusted by 3,000+ travellers from 40+ countries</p>
            </div>
          </div>

        </aside>

        <!-- Right: The form -->
        <div class="lg:col-span-3 bg-white rounded-2xl shadow-card border border-stone overflow-hidden reveal">
          <!-- Form header -->
          <div class="bg-forest-gradient px-6 py-6 sm:px-8">
            <p class="text-gold-300 text-xs font-semibold tracking-[0.2em] uppercase mb-1">100% Free · No Obligation</p>
            <h2 class="font-display text-white text-2xl leading-tight">Build Your Perfect Itinerary</h2>
            <p class="text-white/60 text-xs mt-1.5">Fill in what you know — Emil will handle the rest.</p>
          </div>

          <div class="p-6 sm:p-8">
            <TailorMadeForm client:load whatsapp={SITE.whatsapp} />
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- Destination inspiration strip -->
  <section class="py-16 bg-white border-t border-stone">
    <div class="section-wrap">
      <p class="section-eyebrow text-center mb-3">Popular Destinations</p>
      <h2 class="font-display text-2xl sm:text-3xl text-forest-700 text-center mb-10">
        Where Will Your Story Begin?
      </h2>
      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-4">
        {[
          { name: 'Sigiriya',    img: img('destinations/sigiriya/sigiriya lions  rock.webp') },
          { name: 'Ella',        img: img('destinations/Ella/ella homepage herosection image idea.webp') },
          { name: 'Yala',        img: img('destinations/yala/yala.webp') },
          { name: 'Mirissa',     img: img('destinations/mirissa/mirissa homepage herosection image idea.webp') },
          { name: 'Kandy',       img: img('destinations/kandy/kandy temple of the tooth.webp') },
          { name: 'Galle',       img: img('destinations/Galle/galle hero image idea.webp') },
        ].map(d => (
          <div class="group relative rounded-xl overflow-hidden aspect-[3/4] reveal">
            <img
              src={d.img}
              alt={d.name}
              loading="lazy"
              class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-forest-700/80 via-transparent to-transparent"></div>
            <p class="absolute bottom-3 left-0 right-0 text-center text-white text-sm font-semibold">{d.name}</p>
          </div>
        ))}
      </div>
      <p class="text-center text-warmgray text-sm mt-8">
        Not sure where to go? Tell Emil your interests and he'll suggest the perfect route.
      </p>
    </div>
  </section>

</BaseLayout>
