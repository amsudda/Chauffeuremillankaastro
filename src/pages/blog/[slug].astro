---
import { documentToHtmlString } from '@contentful/rich-text-html-renderer';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getAllPosts, getPostBySlug } from '../../lib/contentful';

export async function getStaticPaths() {
  const posts = await getAllPosts();
  return posts.filter(p => p.slug).map(p => ({ params: { slug: p.slug } }));
}

const { slug } = Astro.params;
const post = await getPostBySlug(slug!);

if (!post) return Astro.redirect('/blog');

const bodyHtml = post.body ? documentToHtmlString(post.body) : '';

function formatDate(iso: string) {
  return new Date(iso).toLocaleDateString('en-GB', {
    day: 'numeric', month: 'long', year: 'numeric',
  });
}
---

<BaseLayout
  title={`${post.title} | ChauffeurEmilLankaTour Blog`}
  description={post.excerpt}
>
  <!-- Hero -->
  <section class="relative pt-20 overflow-hidden bg-forest-700">
    {post.coverImage ? (
      <>
        <div class="absolute inset-0">
          <img
            src={post.coverImage}
            alt={post.title}
            class="w-full h-full object-cover opacity-30"
          />
        </div>
        <div class="absolute inset-0 bg-gradient-to-b from-forest-700/60 via-forest-700/40 to-forest-700"></div>
      </>
    ) : null}
    <div class="relative z-10 section-wrap max-w-3xl mx-auto pt-16 pb-12 text-center">
      <div class="flex items-center justify-center gap-3 mb-5">
        <span class="text-xs font-semibold text-gold-300 uppercase tracking-wider">
          {post.category}
        </span>
        <span class="text-white/40">·</span>
        <span class="text-xs text-white/60">{post.readTime}</span>
      </div>
      <h1 class="font-display text-3xl sm:text-4xl lg:text-5xl text-ivory leading-tight mb-6">
        {post.title}
      </h1>
      <p class="text-white/70 text-lg leading-relaxed mb-8">{post.excerpt}</p>
      <div class="flex items-center justify-center gap-3">
        <div class="w-10 h-10 rounded-full bg-gold-400 flex items-center justify-center text-forest-700 font-bold">
          E
        </div>
        <div class="text-left">
          <p class="text-sm font-semibold text-white">Emil Jayasekara</p>
          <p class="text-xs text-white/60">{formatDate(post.publishedAt)}</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Article body -->
  <article class="py-14 sm:py-20 bg-ivory">
    <div class="section-wrap max-w-2xl mx-auto">

      <!-- Tags -->
      {post.tags.length > 0 && (
        <div class="flex flex-wrap gap-2 mb-10">
          {post.tags.map((tag: string) => (
            <span class="text-xs font-medium text-forest-700 bg-forest-600/10 border border-forest-200
                         px-3 py-1 rounded-full">
              {tag}
            </span>
          ))}
        </div>
      )}

      <!-- Rich text content -->
      <div class="prose prose-lg prose-forest max-w-none" set:html={bodyHtml} />

      <!-- Divider -->
      <hr class="my-12 border-stone" />

      <!-- Author card -->
      <div class="bg-white border border-stone rounded-2xl p-6 flex items-start gap-5">
        <div class="w-14 h-14 rounded-full bg-forest-600 flex items-center justify-center
                    text-white font-display font-bold text-xl flex-shrink-0">
          E
        </div>
        <div>
          <p class="font-semibold text-forest-700 mb-1">Emil Jayasekara</p>
          <p class="text-xs text-gold-600 uppercase tracking-wider mb-2">Senior Private Chauffeur Guide · 14+ Years</p>
          <p class="text-warmgray text-sm leading-relaxed">
            Born and raised in Sri Lanka, Emil shares insider knowledge from thousands of
            miles on island roads — wildlife, culture, food, and hidden corners few tourists ever find.
          </p>
        </div>
      </div>

      <!-- Back link -->
      <div class="mt-10 text-center">
        <a href="/blog" class="text-sm text-forest-600 font-medium hover:text-sunset-400 transition-colors
                               inline-flex items-center gap-2">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/>
          </svg>
          Back to Blog
        </a>
      </div>
    </div>
  </article>

  <!-- CTA -->
  <section class="py-16 bg-forest-gradient text-center">
    <div class="section-wrap max-w-xl mx-auto">
      <h2 class="font-display text-3xl text-ivory mb-3">Inspired? Let's Plan Your Trip</h2>
      <p class="text-white/70 mb-8">
        Emil will build a private itinerary around your exact interests — no group tours, no compromises.
      </p>
      <a href="/tailor-made" class="btn-primary inline-flex">Plan My Tour with Emil</a>
    </div>
  </section>
</BaseLayout>

<style is:global>
  /* Rich text article styling */
  .prose-forest h2 {
    @apply font-display text-2xl text-forest-700 mt-10 mb-4;
  }
  .prose-forest h3 {
    @apply font-display text-xl text-forest-700 mt-8 mb-3;
  }
  .prose-forest p {
    @apply text-warmbrown leading-relaxed mb-5;
  }
  .prose-forest a {
    @apply text-forest-600 underline underline-offset-2 hover:text-sunset-400 transition-colors;
  }
  .prose-forest ul {
    @apply list-disc list-outside pl-6 mb-5 space-y-2 text-warmbrown;
  }
  .prose-forest ol {
    @apply list-decimal list-outside pl-6 mb-5 space-y-2 text-warmbrown;
  }
  .prose-forest blockquote {
    @apply border-l-4 border-gold-400 pl-5 italic text-warmgray my-6;
  }
  .prose-forest img {
    @apply rounded-2xl w-full my-8 shadow-card;
  }
  .prose-forest strong {
    @apply text-forest-700 font-semibold;
  }
  .prose-forest hr {
    @apply border-stone my-8;
  }
</style>
