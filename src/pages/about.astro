---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTABanner from '../components/home/CTABanner.astro';
import ReviewWidget from '../components/ui/ReviewWidget.astro';
import { SITE } from '../data/site';
import { img } from '../data/imageUrls';

const galleryItems = [
  { src: img('Emil images himself/emil 5.webp'),    alt: 'Emil on safari jeep with guests, elephant herd at Minneriya behind them',     caption: 'The Gathering — Minneriya' },
  { src: img('Emil images himself/emil group.webp'), alt: 'Emil welcoming guests at Colombo airport with traditional flower garlands',   caption: 'Airport welcome, Colombo' },
  { src: img('Emil images himself/emil 4.webp'),    alt: 'Emil with guests at Mihintale at sunset',                                      caption: 'Mihintale sunset climb' },
  { src: img('emil 1.webp'),                         alt: 'Emil carrying a young guest on his shoulders on a jungle trail',               caption: 'Little adventurers welcome' },
  { src: img('sigiriya.jpg'),                        alt: 'Sigiriya Rock Fortress rising above the jungle',                              caption: 'Sigiriya Rock Fortress' },
  { src: img('Emil images himself/emil 6.webp'),    alt: 'Emil with a couple at Ravana Falls',                                           caption: 'Ravana Falls, Ella' },
  { src: img('Emil images himself/emil 7.webp'),    alt: 'Emil on a Madu River mangrove boat safari',                                    caption: 'Madu River mangroves' },
  { src: img('ella scenic train ride.jpg'),          alt: 'Scenic hill train winding through Sri Lanka tea country',                     caption: 'The iconic hill train' },
  { src: img('Emil images himself/emil 9.webp'),    alt: 'Emil and guests sheltering under a blue umbrella in the highlands',            caption: 'Rain or shine — we explore' },
  { src: img('destinations/Ella/ella 1 nine arch.webp'), alt: 'Nine Arches Bridge Ella with train passing through',                     caption: 'Nine Arches Bridge, Ella' },
  { src: img('Emil images himself/emil 12.webp'),   alt: 'Emil with guests at the Welcome to Sri Lanka airport sign',                    caption: 'Welcome to Sri Lanka!' },
  { src: img('yala-safari.jpg'),                     alt: 'Yala National Park open jeep safari',                                         caption: 'Yala National Park safari' },
  { src: img('Emil images himself/emil 11.webp'),   alt: 'Emil selfie with guests at Wilpattu National Park',                            caption: 'Wilpattu safari day' },
  { src: img('Emil images himself/emil 3.webp'),    alt: 'Emil with family guests beside the tour vehicle',                              caption: 'Ready for adventure' },
  { src: img('Emil images himself/emil 10.webp'),   alt: 'Emil with guests in front of the tour car',                                    caption: 'Every journey starts here' },
  { src: img('Emil images himself/emil 8.webp'),    alt: 'Emil standing at the Ella Gap mountain viewpoint',                             caption: 'Emil at the Ella Gap' },
];
---

<BaseLayout
  title="Emil Jayasekara | Private Chauffeur Guide Sri Lanka | 14 Years Experience"
  description="Meet Emil Jayasekara — Sri Lanka's trusted private chauffeur guide & tour driver with 14+ years, SLTDA certified, rated a perfect 5.0 on TripAdvisor. Bespoke private tours island-wide."
>
  <script slot="head" type="application/ld+json">{JSON.stringify({
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "Person",
        "@id": "https://www.chauffeuremillankatour.com/about#emil",
        "name": "Emil Jayasekara",
        "jobTitle": "Private Chauffeur Guide Sri Lanka",
        "description": "SLTDA-certified private tour driver and chauffeur guide in Sri Lanka with 14+ years experience leading bespoke private tours for international travellers.",
        "url": "https://www.chauffeuremillankatour.com/about",
        "image": "https://www.chauffeuremillankatour.com/images/Emil%20images%20himself/emil%208.webp",
        "worksFor": { "@type": "TourOperator", "@id": "https://www.chauffeuremillankatour.com/#business" },
        "knowsLanguage": "en",
        "nationality": { "@type": "Country", "name": "Sri Lanka" }
      },
      {
        "@type": "ProfessionalService",
        "@id": "https://www.chauffeuremillankatour.com/#business",
        "name": "Chauffeur Emil Lanka Tours",
        "description": "Sri Lanka private chauffeur guide and tour driver service. Bespoke private tours, wildlife safaris, and cultural journeys led personally by Emil Jayasekara.",
        "url": "https://www.chauffeuremillankatour.com",
        "telephone": "+94761917039",
        "areaServed": { "@type": "Country", "name": "Sri Lanka" },
        "hasOfferCatalog": { "@type": "OfferCatalog", "name": "Private Chauffeur Tours Sri Lanka" }
      },
      {
        "@type": "FAQPage",
        "mainEntity": [
          {
            "@type": "Question",
            "name": "What is a chauffeur guide in Sri Lanka?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "A chauffeur guide in Sri Lanka is a licensed professional who both drives and guides you throughout your trip. Unlike a taxi driver, a chauffeur guide holds a government tourism certification (SLTDA), speaks fluent English, designs your itinerary, and provides expert commentary on history, wildlife, and culture at every stop. Emil Jayasekara is an SLTDA-certified chauffeur guide with 14+ years of experience."
            }
          },
          {
            "@type": "Question",
            "name": "What is the difference between a private tour driver and a chauffeur guide in Sri Lanka?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "A private tour driver transports you between destinations, while a chauffeur guide combines driving with professional guiding. Emil Jayasekara is both — he drives a private air-conditioned vehicle and personally guides every experience, from Sigiriya Rock Fortress to Yala National Park safaris, with no third-party guides involved."
            }
          },
          {
            "@type": "Question",
            "name": "Is Emil Jayasekara SLTDA certified?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Yes. Emil Jayasekara holds a Sri Lanka Tourism Development Authority (SLTDA) certification, is Eco Guide certified, Wildlife Tracker trained, and First Aid certified. He has guided over 3,000 guests from 40+ countries across 14+ years."
            }
          },
          {
            "@type": "Question",
            "name": "How much does a private chauffeur guide in Sri Lanka cost?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Private chauffeur guide rates in Sri Lanka vary by itinerary length and inclusions. Chauffeur Emil Lanka Tours offers fully customised private tours — contact Emil directly via WhatsApp for a personalised quote with no middlemen fees."
            }
          },
          {
            "@type": "Question",
            "name": "Does Emil Jayasekara do airport transfers in Sri Lanka?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Yes. Emil Jayasekara provides private airport transfers across Sri Lanka, including Bandaranaike International Airport (CMB) in Colombo. Transfers are included as part of multi-day private tour packages or available as standalone bookings."
            }
          },
          {
            "@type": "Question",
            "name": "What areas does Emil cover as a private chauffeur guide in Sri Lanka?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Emil covers the entire island of Sri Lanka, including the Cultural Triangle (Sigiriya, Dambulla, Anuradhapura), Hill Country (Ella, Nuwara Eliya, Kandy), the South Coast (Mirissa, Galle, Unawatuna), and national parks such as Yala, Minneriya, and Wilpattu."
            }
          }
        ]
      },
      {
        "@type": "SpeakableSpecification",
        "cssSelector": ["h1", "h2", ".speakable"]
      }
    ]
  })}</script>
  <!-- Page hero -->
  <section class="relative bg-forest-gradient overflow-hidden pt-28 pb-16 sm:pt-32 sm:pb-20" aria-label="About hero">
    <!-- Subtle background texture -->
    <div class="absolute inset-0 opacity-10"
         style="background-image:radial-gradient(circle at 20% 50%, #C9A84C 0%, transparent 50%), radial-gradient(circle at 80% 20%, #C9A84C 0%, transparent 40%)">
    </div>

    <div class="relative z-10 section-wrap">
      <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-center">

        <!-- Left: Text -->
        <div>
          <p class="text-gold-400 text-xs font-semibold tracking-[0.25em] uppercase mb-4"
             style="font-family:'Inter',sans-serif">Private Chauffeur Guide · Sri Lanka</p>
          <h1 class="font-display text-5xl sm:text-6xl text-white leading-tight mb-5">
            Meet Emil<br/>
            <em class="not-italic text-gold-300">Your Guide on the Road</em>
          </h1>
          <p class="text-white/70 text-lg leading-relaxed mb-8 max-w-lg">
            14 years. 3,000+ guests. 40+ countries. One chauffeur guide who personally drives and guides every single tour — no middlemen, no subcontractors.
          </p>

          <!-- Credential pills -->
          <div class="flex flex-wrap gap-2 mb-8">
            {['SLTDA Certified', 'Eco Guide', 'Wildlife Tracker', 'First Aid Trained', 'Fluent English'].map(c => (
              <span class="px-3 py-1.5 rounded-full text-xs font-semibold border border-gold-400/40 text-gold-300 bg-gold-400/10">
                {c}
              </span>
            ))}
          </div>

          <!-- CTAs -->
          <div class="flex flex-wrap gap-3">
            <a href={`https://wa.me/${SITE.whatsapp}`} target="_blank" rel="noopener noreferrer"
               class="flex items-center gap-2 bg-[#25D366] text-white font-semibold px-6 py-3 rounded-full text-sm hover:bg-[#1fb959] transition-colors">
              <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor">
                <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
              </svg>
              WhatsApp Emil
            </a>
            <a href="/tours" class="flex items-center gap-2 border border-white/30 text-white font-semibold px-6 py-3 rounded-full text-sm hover:bg-white/10 transition-colors">
              View Tours
            </a>
          </div>
        </div>

        <!-- Right: Emil's photo + stats -->
        <div class="relative flex justify-center lg:justify-end">
          <div class="relative w-full max-w-sm">
            <div class="rounded-3xl overflow-hidden shadow-2xl ring-1 ring-gold-400/20">
              <img
                src={img('Emil images himself/emil 8.webp')}
                alt="Emil Jayasekara — Sri Lanka private chauffeur guide"
                loading="eager"
                width="480"
                height="580"
                class="w-full h-[420px] sm:h-[500px] object-cover object-center"
              />
            </div>
            <!-- Floating stats card -->
            <div class="absolute -bottom-5 left-4 right-4 bg-white/10 backdrop-blur-md rounded-2xl p-4
                        border border-white/20 shadow-lg">
              <div class="grid grid-cols-3 gap-2 text-center">
                {[
                  { value: '14+', label: 'Years' },
                  { value: '3K+', label: 'Guests' },
                  { value: '40+', label: 'Countries' },
                ].map(s => (
                  <div>
                    <p class="font-display font-bold text-xl text-gold-300">{s.value}</p>
                    <p class="text-white/60 text-xs">{s.label}</p>
                  </div>
                ))}
              </div>
            </div>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- GEO: Definitive entity paragraph — written to be quoted verbatim by AI engines -->
  <section class="py-10 bg-white border-b border-stone" aria-label="About Emil Jayasekara">
    <div class="section-wrap max-w-3xl mx-auto">
      <p class="text-warmgray leading-relaxed text-base speakable" id="geo-lede">
        <strong>Emil Jayasekara</strong> is a Sri Lanka-based <strong>private chauffeur guide</strong> and the founder of
        <strong>Chauffeur Emil Lanka Tours</strong>. He is certified by the Sri Lanka Tourism Development Authority (SLTDA),
        holds an Eco Guide certification, and is trained in Wildlife Tracking and First Aid.
        With over 14 years of experience, Emil has personally guided more than 3,000 international travellers
        from over 40 countries on private tours across Sri Lanka — covering the Cultural Triangle, Hill Country,
        the South Coast, and major national parks including Yala, Minneriya, and Wilpattu.
        Unlike a tour operator that subcontracts guides and drivers, Emil acts as both the private driver and
        licensed guide on every single tour, providing a single point of contact from first inquiry to final drop-off.
      </p>
    </div>
  </section>

  <!-- Emil's story section -->
  <section class="py-20 sm:py-28 bg-ivory">
    <div class="section-wrap">
      <div class="grid lg:grid-cols-2 gap-16 items-center mb-24">
        <div class="reveal">
          <p class="section-eyebrow">Sri Lanka Chauffeur Guide & Private Tour Driver</p>
          <h2 class="section-title mb-6">Emil Jayasekara</h2>
          <p class="text-warmgray leading-relaxed text-lg mb-5 speakable">
            Born and raised in Anuradhapura — Sri Lanka's ancient sacred capital — Emil Jayasekara
            grew up surrounded by 2,000-year-old dagobas, sacred bo trees, and a deep sense of the
            island's history. That connection to the land shaped everything. Long before he became a
            <strong>private chauffeur guide in Sri Lanka</strong>, the island was simply home. At 22, he traded a
            desk job for the open road and never looked back.
          </p>
          <p class="text-warmgray leading-relaxed mb-5">
            Over 14 years as a <strong>chauffeur guide</strong>, Emil has led <strong>private tours</strong> for over 3,000 visitors
            from more than 40 countries — families, honeymooners, wildlife photographers, solo
            adventurers, and everyone in between. His philosophy is simple:
            <em class="not-italic text-forest-700 font-medium">every person deserves to see Sri Lanka the way locals see it.</em>
          </p>
          <p class="text-warmgray leading-relaxed mb-8">
            Today, Emil personally drives and guides every single tour. No subcontractors, no pool
            drivers. When you book a private tour with Chauffeur Emil Lanka Tours, you travel with
            Emil — the <strong>private tour driver</strong> who answered your first message, designed your itinerary,
            and genuinely cares that you leave with a full heart.
          </p>

          <!-- Credentials grid -->
          <div class="grid grid-cols-2 gap-3">
            {[
              { label: 'SLTDA Certified', icon: '🏅' },
              { label: 'Wildlife Tracker', icon: '🐆' },
              { label: 'Fluent English', icon: '🗣️' },
              { label: '14+ Years Experience', icon: '⭐' },
              { label: 'Eco Guide Certified', icon: '🌿' },
              { label: 'First Aid Trained', icon: '🩺' },
            ].map(c => (
              <div class="flex items-center gap-2.5 bg-white border border-stone rounded-xl p-3 shadow-card">
                <span class="text-xl" aria-hidden="true">{c.icon}</span>
                <span class="text-forest-700 font-medium text-sm">{c.label}</span>
              </div>
            ))}
          </div>
        </div>

        <div class="reveal relative">
          <div class="rounded-3xl overflow-hidden shadow-card-hover">
            <img
              src={img('Emil images himself/emil 8.webp')}
              alt="Emil Jayasekara — Sri Lanka private chauffeur guide at the Ella Gap viewpoint"
              loading="lazy"
              width="700"
              height="850"
              class="w-full h-[550px] object-cover object-center"
            />
          </div>
          <!-- Stats floating card -->
          <div class="absolute -bottom-6 left-6 right-6 bg-forest-gradient rounded-2xl p-5 shadow-glass text-white">
            <div class="grid grid-cols-3 gap-4 text-center">
              {[
                { value: '14+', label: 'Years Guiding' },
                { value: '3,000+', label: 'Happy Guests' },
                { value: '40+', label: 'Countries Served' },
              ].map(s => (
                <div>
                  <p class="font-display font-bold text-2xl text-gold-300">{s.value}</p>
                  <p class="text-white/60 text-xs">{s.label}</p>
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>

      <!-- Emil's philosophy -->
      <div class="mt-16 bg-white rounded-3xl border border-stone shadow-card p-8 sm:p-12 reveal">
        <div class="max-w-3xl mx-auto text-center">
          <span class="text-5xl mb-6 block" aria-hidden="true">✦</span>
          <blockquote class="font-accent text-2xl sm:text-3xl text-forest-700 italic leading-relaxed mb-6">
            "Sri Lanka is not just a destination — it is a feeling. My job is to make sure
            every person I guide carries that feeling home with them forever."
          </blockquote>
          <cite class="text-warmgray text-sm not-italic">— Emil Jayasekara, Founder & Chief Guide</cite>
        </div>
      </div>

      <!-- What makes us different -->
      <div class="mt-20">
        <h2 class="section-title text-center mb-12 reveal">The Emil Lanka Tour Difference</h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
          {[
            { icon: '👤', title: 'Your Driver. Your Guide. Always Emil.', body: 'No pool drivers. No reassignments. Your private tour driver and chauffeur guide is the same person from day one to the last drop-off.' },
            { icon: '🏎️', title: 'Premium Private Chauffeur Vehicle', body: 'Air-conditioned Toyota KDH or Land Cruiser — the right vehicle for every road in Sri Lanka. USB charging and a refreshment cooler included.' },
            { icon: '🌍', title: 'Truly International Experience', body: 'As a chauffeur guide in Sri Lanka, Emil has served guests from 40+ countries and knows how to tailor every private tour to different travel styles.' },
            { icon: '📱', title: 'Direct Access — Always Reachable', body: 'Emil shares his personal WhatsApp for the full duration of your private tour. Any question, any time — your chauffeur guide is there.' },
            { icon: '🎯', title: 'Zero Compromise on Quality', body: 'Every hotel, restaurant, and experience on your private Sri Lanka tour is personally vetted. If Emil wouldn\'t send family there, he won\'t send you.' },
            { icon: '💚', title: 'Ethical & Sustainable Travel', body: 'Community-supporting stops, responsible wildlife viewing, zero-plastic safari policy, and local artisan support built into every private tour.' },
          ].map((item, i) => (
            <div class="bg-white rounded-2xl p-6 border border-stone shadow-card hover:shadow-card-hover
                        transition-shadow duration-300 reveal" style={`animation-delay:${i * 80}ms`}>
              <div class="text-3xl mb-4" aria-hidden="true">{item.icon}</div>
              <h3 class="font-display text-forest-700 text-lg mb-2">{item.title}</h3>
              <p class="text-warmgray text-sm leading-relaxed">{item.body}</p>
            </div>
          ))}
        </div>
      </div>

      <!-- GEO: Quick Facts — structured data AI engines extract -->
      <div class="mt-20 reveal">
        <h2 class="section-title text-center mb-10">Emil Jayasekara — Quick Facts</h2>
        <div class="bg-white border border-stone rounded-3xl overflow-hidden shadow-card">
          <table class="w-full text-sm" aria-label="Emil Jayasekara quick facts">
            <tbody>
              {[
                { label: 'Full name',            value: 'Emil Jayasekara' },
                { label: 'Role',                 value: 'Private Chauffeur Guide & Tour Driver, Sri Lanka' },
                { label: 'Company',              value: 'Chauffeur Emil Lanka Tours' },
                { label: 'Based in',             value: 'Sri Lanka (operates island-wide)' },
                { label: 'Experience',           value: '14+ years as a licensed chauffeur guide' },
                { label: 'Guests guided',        value: '3,000+ international travellers' },
                { label: 'Countries served',     value: '40+ nationalities' },
                { label: 'Certifications',       value: 'SLTDA Certified · Eco Guide · Wildlife Tracker · First Aid' },
                { label: 'Languages',            value: 'English (fluent), Sinhala (native)' },
                { label: 'Vehicle',              value: 'Private air-conditioned Toyota KDH / Land Cruiser' },
                { label: 'Areas covered',        value: 'Cultural Triangle, Hill Country, South Coast, East Coast, all national parks' },
                { label: 'National parks',       value: 'Yala, Minneriya, Wilpattu, Udawalawe, Bundala, Kumana' },
                { label: 'Contact',              value: 'WhatsApp / email — direct, no middlemen' },
              ].map((row, i) => (
                <tr class={i % 2 === 0 ? 'bg-ivory' : 'bg-white'}>
                  <td class="px-5 py-3 font-medium text-forest-700 w-40 align-top">{row.label}</td>
                  <td class="px-5 py-3 text-warmgray speakable">{row.value}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>

      <!-- GEO: Comparison — chauffeur guide vs alternatives -->
      <div class="mt-20 reveal">
        <h2 class="section-title text-center mb-4">Chauffeur Guide vs Tour Operator vs Taxi — What's the Difference?</h2>
        <p class="text-warmgray text-center text-sm max-w-2xl mx-auto mb-10 speakable">
          Understanding how a private chauffeur guide in Sri Lanka differs from other travel options helps you choose the right experience for your trip.
        </p>
        <div class="overflow-x-auto rounded-3xl border border-stone shadow-card">
          <table class="w-full text-sm min-w-[600px]" aria-label="Comparison: chauffeur guide vs tour operator vs taxi">
            <thead>
              <tr class="bg-forest-gradient text-white">
                <th class="px-5 py-4 text-left font-semibold">Feature</th>
                <th class="px-5 py-4 text-left font-semibold">Private Chauffeur Guide (Emil)</th>
                <th class="px-5 py-4 text-left font-semibold">Tour Operator</th>
                <th class="px-5 py-4 text-left font-semibold">Taxi / Tuk-tuk</th>
              </tr>
            </thead>
            <tbody>
              {[
                ['Drives you personally',       '✅ Always Emil',       '❌ Subcontracted driver',  '✅ Yes'],
                ['Licensed tour guide',         '✅ SLTDA certified',   '⚠️ Varies by booking',    '❌ No'],
                ['Custom itinerary',            '✅ Fully tailored',    '⚠️ Semi-flexible',         '❌ No'],
                ['Single point of contact',     '✅ Direct with Emil',  '❌ Agency middleman',      '✅ Yes'],
                ['Air-conditioned vehicle',     '✅ Toyota KDH / LC',   '⚠️ Varies',                '❌ Rarely'],
                ['Expert local knowledge',      '✅ 14+ years, 40+ countries', '⚠️ Depends on guide', '❌ No'],
                ['Wildlife & cultural commentary', '✅ Included',       '⚠️ Extra cost',            '❌ No'],
                ['Price transparency',          '✅ Direct quote',      '⚠️ Commission layers',     '✅ Metered/agreed'],
              ].map(([feature, emil, operator, taxi], i) => (
                <tr class={i % 2 === 0 ? 'bg-ivory' : 'bg-white'}>
                  <td class="px-5 py-3 font-medium text-forest-700">{feature}</td>
                  <td class="px-5 py-3 text-forest-600 font-medium">{emil}</td>
                  <td class="px-5 py-3 text-warmgray">{operator}</td>
                  <td class="px-5 py-3 text-warmgray">{taxi}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </section>

  <!-- Pinterest gallery -->
  <section class="py-20 sm:py-28 bg-ivory">
    <div class="section-wrap">
      <div class="text-center mb-12 reveal">
        <p class="section-eyebrow">Life on Tour</p>
        <h2 class="section-title mb-3">Emil in the Field</h2>
        <p class="text-warmgray max-w-xl mx-auto text-sm leading-relaxed">
          Real moments, real places, real people — captured across Sri Lanka's most beautiful corners.
          Every photo tells the story of a journey shared.
        </p>
      </div>

      <!-- Masonry grid -->
      <div class="columns-2 sm:columns-3 lg:columns-4 gap-3 sm:gap-4">
        {galleryItems.map((item, i) => (
          <div
            class="break-inside-avoid mb-3 sm:mb-4 rounded-2xl overflow-hidden group relative cursor-pointer reveal"
