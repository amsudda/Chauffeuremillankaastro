---
import BaseLayout from '../layouts/BaseLayout.astro';
import InquiryForm from '../components/tours/InquiryForm';
import ObfuscatedEmail from '../components/ui/ObfuscatedEmail';
import { SITE } from '../data/site';

const waUrl = `https://wa.me/${SITE.whatsapp}?text=Hello%20Emil%2C%20I%27d%20like%20to%20enquire%20about%20a%20private%20Sri%20Lanka%20tour`;
const encodedEmail = 'rzvywlnlnfrxnen5@tznvy.pbz';
---

<BaseLayout
  title="Contact Emil | Plan Your Sri Lanka Tour | Chauffeur Emil Lanka Tours"
  description="Contact Emil Jayasekara to plan your private Sri Lanka tour. WhatsApp, email, or enquiry form. Free itinerary within 24 hours. No obligation."
>
  <!-- Page hero -->
  <section class="relative bg-forest-gradient pt-28 pb-16 sm:pt-36 sm:pb-20 overflow-hidden">
    <div class="absolute inset-0 opacity-10"
         style="background-image: url(https://images.unsplash.com/photo-1596402184320-417e7178b2cd?w=1200&q=20&fit=crop); background-size: cover;">
    </div>
    <div class="relative z-10 section-wrap text-center">
      <p class="section-eyebrow">Say Hello</p>
      <h1 class="font-display text-4xl sm:text-5xl text-ivory mb-4">Get in Touch with Emil</h1>
      <p class="text-white/70 text-lg max-w-lg mx-auto">
        Have a question? Want to know more? Send Emil a message and he'll get back to you within 24 hours.
        Looking to plan a tour? <a href="/tailor-made" class="text-gold-300 underline underline-offset-2 hover:text-gold-200">Use the Tour Planner →</a>
      </p>
    </div>
  </section>

  <section class="py-16 sm:py-24 bg-ivory">
    <div class="section-wrap">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 xl:gap-16 items-start">

        <!-- Left: Contact details + info -->
        <div class="space-y-8 reveal">
          <div>
            <h2 class="section-title text-2xl sm:text-3xl mb-4">How to Reach Emil</h2>
            <p class="text-warmgray leading-relaxed">
              Emil personally manages all enquiries. Whether you have a specific tour in mind
              or simply want advice on what's best for your dates and interests, he's the right
              person to ask.
            </p>
          </div>

          <!-- Contact methods -->
          <div class="space-y-4">
            <!-- WhatsApp -->
            <a
              href={waUrl}
              target="_blank" rel="noopener noreferrer"
              class="flex items-start gap-4 bg-white border border-stone rounded-2xl p-5
                     shadow-card hover:shadow-card-hover transition-all duration-300 group"
            >
              <div class="w-11 h-11 rounded-xl flex items-center justify-center flex-shrink-0 text-white"
                   style="background-color:#25D366">
                <span class="w-5 h-5" set:html={`<svg fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>`}></span>
              </div>
              <div class="flex-1 min-w-0">
                <p class="text-xs text-warmgray mb-0.5">WhatsApp</p>
                <p class="text-forest-700 font-semibold group-hover:text-sunset-400 transition-colors">{SITE.phone}</p>
                <p class="text-warmgray text-xs mt-1">Fastest response — usually within 2 hours</p>
              </div>
              <svg class="w-5 h-5 text-stone group-hover:text-sunset-400 transition-colors self-center flex-shrink-0"
                   fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
              </svg>
            </a>

            <!-- Email (obfuscated — decoded client-side to block scrapers) -->
            <div class="flex items-start gap-4 bg-white border border-stone rounded-2xl p-5
                        shadow-card hover:shadow-card-hover transition-all duration-300 group">
              <div class="w-11 h-11 rounded-xl flex items-center justify-center flex-shrink-0 text-white"
                   style="background-color:#1B3A2D">
                <span class="w-5 h-5" set:html={`<svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>`}></span>
              </div>
              <div class="flex-1 min-w-0">
                <p class="text-xs text-warmgray mb-0.5">Email</p>
                <p class="text-forest-700 font-semibold group-hover:text-sunset-400 transition-colors">
                  <ObfuscatedEmail
                    client:load
                    encoded={encodedEmail}
                    className="text-forest-700 font-semibold group-hover:text-sunset-400 transition-colors"
                  />
                </p>
                <p class="text-warmgray text-xs mt-1">Responses within 24 hours</p>
              </div>
              <svg class="w-5 h-5 text-stone group-hover:text-sunset-400 transition-colors self-center flex-shrink-0"
                   fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
              </svg>
            </div>

            <!-- Phone -->
            <a
              href={`tel:${SITE.phone}`}
              class="flex items-start gap-4 bg-white border border-stone rounded-2xl p-5
                     shadow-card hover:shadow-card-hover transition-all duration-300 group"
            >
              <div class="w-11 h-11 rounded-xl flex items-center justify-center flex-shrink-0 text-white"
                   style="background-color:#C9A84C">
                <span class="w-5 h-5" set:html={`<svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>`}></span>
              </div>
              <div class="flex-1 min-w-0">
                <p class="text-xs text-warmgray mb-0.5">Phone</p>
                <p class="text-forest-700 font-semibold group-hover:text-sunset-400 transition-colors">{SITE.phone}</p>
                <p class="text-warmgray text-xs mt-1">Calls welcome 7am–9pm Sri Lanka time (UTC+5:30)</p>
              </div>
              <svg class="w-5 h-5 text-stone group-hover:text-sunset-400 transition-colors self-center flex-shrink-0"
                   fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
              </svg>
            </a>
          </div>

          <!-- What happens next -->
          <div class="bg-forest-600/8 border border-forest-200 rounded-2xl p-6">
            <h3 class="font-semibold text-forest-700 mb-4">What Happens After You Enquire?</h3>
            <ol class="space-y-3">
              {[
                'Emil personally reviews your request within 2 hours',
                'He sends a free draft itinerary tailored to your dates & interests',
                'You refine the plan together until it\'s exactly right',
                'Confirm with a 30% deposit — then just pack your bags',
              ].map((step, i) => (
                <li class="flex items-start gap-3 text-sm text-warmgray">
                  <span class="w-6 h-6 rounded-full bg-forest-600 text-white text-xs font-bold
                               flex items-center justify-center flex-shrink-0 mt-0.5">
                    {i + 1}
                  </span>
                  {step}
                </li>
              ))}
            </ol>
          </div>

          <!-- Social proof -->
          <div class="flex items-center gap-4">
            <div class="flex -space-x-2">
              {['KN', 'SW', 'MF', 'RC'].map(initials => (
                <div class="w-9 h-9 rounded-full bg-forest-600 border-2 border-white flex items-center
                             justify-center text-white text-xs font-bold">
                  {initials}
                </div>
              ))}
            </div>
            <div>
              <div class="flex gap-0.5">
                {[1,2,3,4,5].map(_ => (
                  <svg class="w-4 h-4 text-gold-400" fill="currentColor" viewBox="0 0 20 20">
                    <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                  </svg>
                ))}
              </div>
              <p class="text-xs text-warmgray">Trusted by 3,000+ travellers from 40+ countries</p>
            </div>
          </div>
        </div>

        <!-- Right: Inquiry form -->
        <div class="reveal">
          <InquiryForm client:load />
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
