          "ratingValue": 5.0,
          "reviewCount": 35
        }
      },
      {
        "@type": "ItemList",
        "name": "Sehenswürdigkeiten Sri Lanka",
        "numberOfItems": 8,
        "itemListElement": [
          { "@type":"ListItem","position":1,"name":"Sigiriya Löwenfelsen","url":"https://www.chauffeuremillankatour.com/de/sehenswuerdigkeiten-sri-lanka#sigiriya" },
          { "@type":"ListItem","position":2,"name":"Mirissa Strand & Walbeobachtung","url":"https://www.chauffeuremillankatour.com/de/sehenswuerdigkeiten-sri-lanka#mirissa" },
          { "@type":"ListItem","position":3,"name":"Yala Nationalpark","url":"https://www.chauffeuremillankatour.com/de/sehenswuerdigkeiten-sri-lanka#yala" },
          { "@type":"ListItem","position":4,"name":"Udawalawe Nationalpark","url":"https://www.chauffeuremillankatour.com/de/sehenswuerdigkeiten-sri-lanka#udawalawe" },
          { "@type":"ListItem","position":5,"name":"Sri Dalada Maligawa — Zahntempel Kandy","url":"https://www.chauffeuremillankatour.com/de/sehenswuerdigkeiten-sri-lanka#zahntempel" },
          { "@type":"ListItem","position":6,"name":"Galle Dutch Fort","url":"https://www.chauffeuremillankatour.com/de/sehenswuerdigkeiten-sri-lanka#galle" },
          { "@type":"ListItem","position":7,"name":"Nine Arch Bridge Ella","url":"https://www.chauffeuremillankatour.com/de/sehenswuerdigkeiten-sri-lanka#nine-arch" },
