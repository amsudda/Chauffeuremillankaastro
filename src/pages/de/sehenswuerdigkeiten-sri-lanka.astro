  <style>
    .attraction-num {
      font-family: 'Playfair Display', serif;
      font-size: clamp(6rem, 15vw, 11rem);
      font-weight: 700;
      line-height: 1;
      opacity: 0.07;
      position: absolute;
      top: -1.5rem;
      left: -1rem;
      pointer-events: none;
      user-select: none;
      letter-spacing: -0.05em;
    }
    .tip-box {
      border-left: 3px solid currentColor;
      background: rgba(255,255,255,0.7);
      backdrop-filter: blur(4px);
    }
    .fact-pill {
      display: inline-flex;
      align-items: center;
      gap: 0.3rem;
      font-size: 0.72rem;
      font-weight: 600;
      padding: 0.3rem 0.8rem;
      border-radius: 9999px;
      border: 1.5px solid currentColor;
    }
    /* Scroll-triggered fade-slide */
    .slide-in { opacity:0; transform:translateY(40px); transition: opacity 0.75s ease, transform 0.75s ease; }
    .slide-in.visible { opacity:1; transform:translateY(0); }
    .slide-right { opacity:0; transform:translateX(-40px); transition: opacity 0.7s ease, transform 0.7s ease; }
    .slide-right.visible { opacity:1; transform:translateX(0); }
    .slide-left { opacity:0; transform:translateX(40px); transition: opacity 0.7s ease, transform 0.7s ease; }
    .slide-left.visible { opacity:1; transform:translateX(0); }
  </style>

  <!-- ── HERO ── -->
  <section class="relative min-h-[85vh] flex items-center justify-center overflow-hidden bg-[#0D1F16]">
    <!-- layered background texture -->
    <div class="absolute inset-0"
         style="background:radial-gradient(ellipse at 20% 50%, rgba(201,168,76,0.12) 0%, transparent 60%),
                radial-gradient(ellipse at 80% 30%, rgba(27,58,45,0.8) 0%, transparent 50%)">
    </div>
    <div class="absolute inset-0 opacity-20"
         style="background-image:url('data:image/svg+xml,%3Csvg width=60 height=60 viewBox=0 0 60 60 xmlns=http://www.w3.org/2000/svg%3E%3Cg fill=none fill-rule=evenodd%3E%3Cg fill=%23C9A84C fill-opacity=0.15%3E%3Cpath d=M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z/%3E%3C/g%3E%3C/g%3E%3C/svg%3E')">
    </div>

    <div class="relative z-10 max-w-5xl mx-auto px-6 text-center py-24">
      <!-- eyebrow -->
      <div class="inline-flex items-center gap-2.5 mb-8">
        <span class="h-px w-10 bg-gold-400/60"></span>
        <span class="text-gold-300 text-xs font-semibold tracking-[0.3em] uppercase">Privater Chauffeur Guide · Sri Lanka</span>
        <span class="h-px w-10 bg-gold-400/60"></span>
      </div>

      <h1 class="font-display text-white leading-tight mb-6"
          style="font-size:clamp(2.8rem,7vw,5.5rem)">
        Die 8 Orte, die<br/>
        <em class="not-italic" style="color:#C9A84C">Sri Lanka unvergesslich</em><br/>
        machen
      </h1>

      <p class="text-white/65 text-lg leading-relaxed max-w-2xl mx-auto mb-10">
        Von Emil Jayasekara — privatem Chauffeur-Guide mit 14 Jahren Erfahrung.
        Keine Reiseführer-Phrasen. Nur Orte, die er selbst liebt
        und die er seinen Gästen immer wieder zeigt.
      </p>

      <!-- Scroll indicator + CTA -->
      <div class="flex flex-wrap items-center justify-center gap-4 mb-16">
        <a href={waUrl} target="_blank" rel="noopener noreferrer"
           class="flex items-center gap-2.5 bg-[#25D366] text-white font-semibold px-7 py-3.5 rounded-full text-sm hover:bg-[#1fb959] transition-colors">
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
          </svg>
          Emil auf WhatsApp fragen
        </a>
        <a href="/tailor-made"
           class="border border-white/30 text-white font-semibold px-7 py-3.5 rounded-full text-sm hover:bg-white/10 transition-colors">
          Meine Reise planen
        </a>
      </div>

      <!-- 8 place quick nav -->
      <div class="flex flex-wrap justify-center gap-2">
        {['Sigiriya','Mirissa','Yala','Udawalawe','Zahntempel','Galle Fort','Nine Arch','Ella Rock'].map((n,i) => (
          <a href={`#attraction-${i}`}
             class="text-white/50 hover:text-gold-300 text-xs font-medium tracking-wide transition-colors border border-white/10 hover:border-gold-400/40 px-3 py-1.5 rounded-full">
            {String(i+1).padStart(2,'0')} {n}
          </a>
        ))}
      </div>
    </div>

    <!-- bottom fade -->
    <div class="absolute bottom-0 inset-x-0 h-24 bg-gradient-to-t from-[#F8F3EC] to-transparent"></div>
  </section>

  <!-- ── ATTRACTION SECTIONS ── -->
  {attractions.map((a, i) => {
    const isEven = i % 2 === 0;
    const ids = ['sigiriya','mirissa','yala','udawalawe','zahntempel','galle','nine-arch','ella-rock'];
    return (
      <section
        id={`attraction-${i}`}
        data-id={ids[i]}
        style={`background-color:${a.bgLight}`}
        class="py-20 sm:py-28 overflow-hidden"
      >
        <div class="max-w-6xl mx-auto px-6 xl:px-8">
