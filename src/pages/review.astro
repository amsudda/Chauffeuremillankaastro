---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../data/site';
import { img } from '../data/imageUrls';
import ReviewWidget from '../components/ui/ReviewWidget.astro';
// though TripAdvisor usually handles the 'Write a Review' button natively on the page.
const tripAdvisorReviewLink = `${SITE.social.tripadvisor}#REVIEWS`;
---

<BaseLayout
  title="Leave a Review | Chauffeur Emil Lanka Tours"
  description="Thank you for travelling with Emil! Your reviews help our small local business grow and allow us to share the magic of Sri Lanka with more guests."
>
  <section class="relative min-h-[85vh] flex items-center justify-center pt-24 pb-16 px-5 sm:px-8 overflow-hidden bg-ivory">
    
    <!-- Background subtle image or pattern -->
    <div class="absolute inset-0 z-0">
      <img src={img('hero-sri-lanka.jpg')} alt="" class="w-full h-full object-cover opacity-10" />
      <div class="absolute inset-0 bg-gradient-to-b from-ivory via-ivory/95 to-ivory"></div>
    </div>

    <div class="relative z-10 w-full max-w-2xl mx-auto text-center reveal">
      
      <!-- Emil Avatar -->
      <div class="mb-8 relative inline-block">
        <div class="w-24 h-24 sm:w-32 sm:h-32 rounded-full overflow-hidden border-4 border-white shadow-xl mx-auto relative z-10">
          <img src={img('emil-boat-portrait.jpg')} alt="Emil Jayasekara" class="w-full h-full object-cover object-[center_30%]" />
        </div>
        <!-- Decorative leaf/star -->
        <div class="absolute -bottom-3 -right-3 bg-gold-400 text-white w-10 h-10 rounded-full flex items-center justify-center shadow-lg border-2 border-white z-20">
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
            <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
          </svg>
        </div>
      </div>

      <!-- Heading -->
      <p class="text-gold-500 font-semibold tracking-[0.2em] uppercase text-xs sm:text-sm mb-4">Thank You</p>
      <h1 class="font-display text-4xl sm:text-5xl text-forest-700 leading-tight mb-6">
        How was your <span class="italic text-forest-600">Sri Lanka</span> journey?
      </h1>

      <!-- Body -->
      <div class="space-y-4 text-warmgray text-base sm:text-lg max-w-lg mx-auto mb-10 leading-relaxed">
        <p>
          I hope you had an unforgettable time exploring Sri Lanka with me. 
        </p>
        <p>
          As an independent chauffeur guide, my business relies almost entirely on word-of-mouth and reviews from wonderful guests like you.
        </p>
        <p>
          If you have a spare 2 minutes, leaving a review on TripAdvisor is the biggest compliment you could give me.
        </p>
      </div>

      <!-- Action Area -->
      <ReviewWidget />
      
    </div>
  </section>
</BaseLayout>
