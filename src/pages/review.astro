---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../data/site';
import { img } from '../data/imageUrls';

// The direct TripAdvisor link. We append #REVIEWS to help scroll the user down, 
// though TripAdvisor usually handles the 'Write a Review' button natively on the page.
const tripAdvisorReviewLink = `${SITE.social.tripadvisor}#REVIEWS`;
---

<BaseLayout
  title="Leave a Review | Chauffeur Emil Lanka Tours"
  description="Thank you for travelling with Emil! Your reviews help our small local business grow and allow us to share the magic of Sri Lanka with more guests."
>
  <section class="relative min-h-[85vh] flex items-center justify-center pt-24 pb-16 px-5 sm:px-8 overflow-hidden bg-ivory">
    
    <!-- Background subtle image or pattern -->
    <div class="absolute inset-0 z-0">
      <img src={img('hero-sri-lanka.jpg')} alt="" class="w-full h-full object-cover opacity-10" />
      <div class="absolute inset-0 bg-gradient-to-b from-ivory via-ivory/95 to-ivory"></div>
    </div>

    <div class="relative z-10 w-full max-w-2xl mx-auto text-center reveal">
      
      <!-- Emil Avatar -->
      <div class="mb-8 relative inline-block">
        <div class="w-24 h-24 sm:w-32 sm:h-32 rounded-full overflow-hidden border-4 border-white shadow-xl mx-auto relative z-10">
          <img src={img('team/emil-portrait.webp')} alt="Emil Jayasekara" class="w-full h-full object-cover" onerror="this.src='/images/emil-guide.jpg'" />
        </div>
        <!-- Decorative leaf/star -->
        <div class="absolute -bottom-3 -right-3 bg-gold-400 text-white w-10 h-10 rounded-full flex items-center justify-center shadow-lg border-2 border-white z-20">
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
            <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
          </svg>
        </div>
      </div>

      <!-- Heading -->
      <p class="text-gold-500 font-semibold tracking-[0.2em] uppercase text-xs sm:text-sm mb-4">Thank You</p>
      <h1 class="font-display text-4xl sm:text-5xl text-forest-700 leading-tight mb-6">
        How was your <span class="italic text-forest-600">Sri Lanka</span> journey?
      </h1>

      <!-- Body -->
      <div class="space-y-4 text-warmgray text-base sm:text-lg max-w-lg mx-auto mb-10 leading-relaxed">
        <p>
          I hope you had an unforgettable time exploring Sri Lanka with me. 
        </p>
        <p>
          As an independent chauffeur guide, my business relies almost entirely on word-of-mouth and reviews from wonderful guests like you.
        </p>
        <p>
          If you have a spare 2 minutes, leaving a review on TripAdvisor is the biggest compliment you could give me.
        </p>
      </div>

      <!-- Action Area -->
      <div class="bg-white p-6 sm:p-8 rounded-3xl shadow-card border border-stone inline-block w-full max-w-lg mx-auto text-left transform transition-transform duration-300 hover:-translate-y-1">
        
        <div class="flex items-center gap-4 mb-6">
          <div class="w-12 h-12 rounded-full bg-[#34E0A1]/10 flex items-center justify-center flex-shrink-0">
            <!-- TripAdvisor Owl Icon SVG -->
            <svg class="w-7 h-7 text-[#000000]" viewBox="0 0 24 24" fill="currentColor">
              <path d="M23.1,13.8l-1.3-1.6c0.5-1.5,0.7-3.2,0.4-4.8c-0.2-1.6-1.1-3.1-2.4-4.1C18,2,15.6,1.4,13.2,1.8C10.7,2.2,8.6,3.6,7.1,5.6C5.5,7.6,4.8,10,5.1,12.5c0.3,2.5,1.6,4.7,3.6,6c-0.3,0.7-0.7,1.4-1.2,2l1.6,1.3l1.5-1.8c1.3,0.9,2.8,1.4,4.4,1.4c2.8,0,5.5-1.4,7.1-3.7l1.7,1.4L23.1,13.8z M15,20c-1.3,0-2.5-0.4-3.6-1c-0.1,0-0.2-0.1-0.3-0.1l-1.2,1.5l-0.8-0.6c0.7-0.8,1.2-1.7,1.6-2.6c0-0.1,0-0.2-0.1-0.3c-1.6-1-2.7-2.6-3.1-4.4c-0.4-1.8,0-3.7,1.1-5.1c1.2-1.5,2.9-2.5,4.8-2.7C15.2,4.4,17,4.8,18.4,5.9c1.4,1,2.3,2.6,2.4,4.3C20.9,12,20,13.6,18.6,14.6c0.1,0.2,0.1,0.3,0.2,0.5c0.4,1.2,0.6,2.5,0.7,3.8L15,20z"/>
              <circle cx="9.5" cy="10.5" r="1.5"/>
              <circle cx="15.5" cy="10.5" r="1.5"/>
            </svg>
          </div>
          <div>
            <h3 class="font-bold text-forest-700 text-lg">TripAdvisor Review</h3>
            <p class="text-xs text-warmgray">Takes about 2 minutes</p>
          </div>
        </div>

        <a 
          href={tripAdvisorReviewLink} 
          target="_blank" 
          rel="noopener noreferrer"
          class="block w-full text-center bg-[#34E0A1] hover:bg-[#28b884] text-forest-900 font-bold py-4 px-6 rounded-xl transition-colors duration-200"
        >
          Write a Review on TripAdvisor
        </a>
        
        <p class="text-[10px] text-warmgray text-center mt-4">
          *You will be securely redirected to TripAdvisor. If you don't have an account, it takes just a few clicks to sign in with Google or Facebook.
        </p>

      </div>
      
    </div>
  </section>
</BaseLayout>
