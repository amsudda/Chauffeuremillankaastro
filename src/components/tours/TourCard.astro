---
import type { Tour } from '../../data/tours';

interface Props { tour: Tour; large?: boolean; }
const { tour, large = false } = Astro.props;

const thumbnails = tour.galleryImages?.slice(0, 3) || [];
const totalExtra = (tour.galleryImages?.length || 0) - 2;
---

<article class="tour-card bg-white rounded-2xl shadow-sm border border-stone/30 group h-full flex flex-col overflow-hidden" aria-label={tour.title}>
  <!-- Image Header (Top Half) -->
  <div class={`relative flex-shrink-0 w-full ${large ? 'h-[26rem]' : 'h-80'} overflow-hidden`}>
    <img
      src={tour.heroImage}
      alt={tour.title}
      loading="lazy"
      class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
    />
    <!-- Gradient overlay for text readability -->
    <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent"></div>

    <!-- Top Badges -->
    <div class="absolute top-4 left-4 right-4 flex items-start justify-between gap-2">
      <span class="bg-[#C86F33] text-white text-[10px] font-bold uppercase tracking-wide px-3 py-1.5 rounded shadow-sm">
        {tour.category}
      </span>
      <span class="bg-black/60 backdrop-blur-md text-white text-xs font-semibold px-3 py-1.5 rounded shadow-sm border border-white/10">
        {tour.duration}
      </span>
    </div>

    <!-- Bottom Content on Image -->
    <div class="absolute bottom-4 left-4 right-4 flex flex-col gap-3">
      <h2 class="text-white font-display text-2xl leading-tight drop-shadow-md">
        {tour.title}
      </h2>
      
      <!-- Thumbnails -->
      {thumbnails.length > 0 && (
        <div class="flex items-center gap-2">
          {thumbnails.map((thumb, index) => {
            const isLast = index === 2;
            const showOverlay = isLast && totalExtra > 0;
            return (
              <div class="relative w-12 h-12 rounded-lg border-2 border-white/80 overflow-hidden shadow-sm flex-shrink-0">
                <img src={thumb} alt="" class="w-full h-full object-cover" loading="lazy" />
                {showOverlay && (
                  <div class="absolute inset-0 bg-black/70 flex items-center justify-center backdrop-blur-sm">
                    <span class="text-white text-xs font-bold">+{totalExtra}</span>
                  </div>
                )}
              </div>
            );
          })}
        </div>
      )}
    </div>
  </div>

  <!-- Content (Bottom Half) -->
  <div class="flex flex-col flex-1 p-5">
    <div class="flex items-start justify-between gap-2 mb-2">
      <h3 class="font-display text-lg text-forest-700 leading-tight">
        {tour.title} - "{tour.subtitle}"
      </h3>
      <svg class="w-5 h-5 text-forest-600 flex-shrink-0 mt-0.5" viewBox="0 0 24 24" fill="currentColor">
        <path fill-rule="evenodd" d="M2.25 12c0-5.385 4.365-9.75 9.75-9.75s9.75 4.365 9.75 9.75-4.365 9.75-9.75 9.75S2.25 17.385 2.25 12zm13.36-1.814a.75.75 0 10-1.22-.872l-3.236 4.53L9.53 12.22a.75.75 0 00-1.06 1.06l2.25 2.25a.75.75 0 001.14-.094l3.75-5.25z" clip-rule="evenodd" />
      </svg>
    </div>

    <!-- Static Reviews (Design Requirement) -->
    <div class="flex items-center gap-1.5 mb-3">
      <div class="flex text-[#FFB800]">
        {[1,2,3,4,5].map(() => (
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
            <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
          </svg>
        ))}
      </div>
      <span class="text-warmgray text-xs font-medium">5.0 (Excellent)</span>
    </div>

    <p class="text-warmgray text-sm leading-relaxed line-clamp-3 mb-5 flex-1">
      {tour.summary}
    </p>

    <!-- Action Area (No Price) -->
    <div class="pt-4 border-t border-stone flex justify-end">
      <a
        href={`/tours/${tour.slug}`}
        class="bg-[#C86F33] hover:bg-[#B35E26] text-white py-2.5 px-6 rounded-lg text-sm font-semibold flex items-center gap-2 transition-colors w-full sm:w-auto justify-center"
        aria-label={`View ${tour.title} details`}
      >
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
          <path stroke-linecap="round" stroke-linejoin="round" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
        </svg>
        Check Itinerary
      </a>
    </div>
  </div>
</article>
