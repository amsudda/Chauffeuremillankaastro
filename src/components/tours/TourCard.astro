---
import type { Tour } from '../../data/tours';

interface Props { tour: Tour; large?: boolean; }
const { tour, large = false } = Astro.props;
---

<article class="tour-card bg-white group h-full flex flex-col" aria-label={tour.title}>
  <!-- Image -->
  <div class={`relative overflow-hidden flex-shrink-0 ${large ? 'h-80 sm:h-96' : 'h-60 sm:h-72'}`}>
    <img
      src={tour.heroImage}
      alt={tour.title}
      loading="lazy"
      width="700"
      height="470"
      class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
    />
    <div class="absolute inset-0 bg-card-overlay"></div>

    <!-- Category + Badge row -->
    <div class="absolute top-4 left-4 right-4 flex items-start justify-between gap-2">
      <span class="bg-forest-700/60 backdrop-blur-sm text-white text-xs font-medium
                   px-3 py-1.5 rounded-full border border-white/20">
        {tour.category}
      </span>
      {tour.badge && (
        <span class="bg-gold-gradient text-forest-700 text-xs font-bold px-3 py-1.5 rounded-full shadow-gold">
          {tour.badge}
        </span>
      )}
    </div>

    <!-- Duration on image -->
    <div class="absolute bottom-4 left-4 flex items-center gap-1.5 text-white/80 text-xs font-medium">
      <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
      </svg>
      {tour.duration}
    </div>
  </div>

  <!-- Content -->
  <div class="flex flex-col flex-1 p-5 sm:p-6">
    <h3 class="font-display text-xl text-forest-700 leading-tight mb-1">
      {tour.title}
    </h3>
    <p class="text-gold-500 text-xs font-medium tracking-wide mb-3">{tour.subtitle}</p>
    <p class="text-warmgray text-sm leading-relaxed line-clamp-2 mb-4 flex-1">
      {tour.summary}
    </p>

    <!-- Highlight chips -->
    <div class="flex flex-wrap gap-1.5 mb-5">
      {tour.highlights.slice(0, 3).map(h => (
        <span class="activity-chip">{h}</span>
      ))}
      {tour.highlights.length > 3 && (
        <span class="activity-chip text-warmgray border-stone">+{tour.highlights.length - 3} more</span>
      )}
    </div>

    <!-- Footer row -->
    <div class="flex items-center justify-between gap-2 pt-4 border-t border-stone">
      {tour.priceFrom ? (
        <span class="text-forest-700 text-sm font-semibold leading-tight">{tour.priceFrom}</span>
      ) : (
        <span></span>
      )}
      <a
        href={`/tours/${tour.slug}`}
        class="btn-primary py-2.5 px-5 text-xs"
        aria-label={`View ${tour.title} details`}
      >
        View Tour
        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
        </svg>
      </a>
    </div>
  </div>
</article>
