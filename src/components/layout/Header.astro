---
import { SITE } from '../../data/site';
import MobileMenu from '../ui/MobileMenu';

const navLinks = [
  { label: 'Home',        href: '/' },
  { label: 'Tours',       href: '/tours' },
  { label: 'Plan My Tour',href: '/tailor-made' },
  { label: 'About Emil',  href: '/about' },
  { label: 'Contact',     href: '/contact' },
];

const moreLinks = [
  { label: 'Blog',         href: '/blog' },
  { label: 'Privacy Policy', href: '/privacy' },
];

const allMobileLinks = [...navLinks, ...moreLinks];

const waUrl = `https://wa.me/${SITE.whatsapp}?text=Hello%20Emil%2C%20I%27d%20like%20to%20enquire%20about%20a%20Sri%20Lanka%20tour`;
---

<style>
  /* ── Light-sweep shimmer on Book Tour button ── */
  .btn-book-tour {
    position: relative;
    overflow: hidden;
  }
  .btn-book-tour::after {
    content: '';
    position: absolute;
    top: 0;
    left: -100%;
    width: 60%;
    height: 100%;
    background: linear-gradient(
      120deg,
      transparent 0%,
      rgba(255,255,255,0.30) 50%,
      transparent 100%
    );
    transition: left 0.75s cubic-bezier(0.4, 0, 0.2, 1);
    pointer-events: none;
  }
  .btn-book-tour:hover::after {
    left: 160%;
  }

  /* ── GET A QUOTE shimmer ── */
  .btn-get-quote {
    position: relative;
    overflow: hidden;
  }
  .btn-get-quote::after {
    content: '';
    position: absolute;
    top: 0;
    left: -100%;
    width: 60%;
    height: 100%;
    background: linear-gradient(
      120deg,
      transparent 0%,
      rgba(255,255,255,0.22) 50%,
      transparent 100%
    );
    transition: left 0.70s cubic-bezier(0.4, 0, 0.2, 1);
    pointer-events: none;
  }
  .btn-get-quote:hover::after {
    left: 160%;
  }

  /* ── Nav link underline sweep ── */
  .nav-item {
    position: relative;
    padding-bottom: 2px;
    white-space: nowrap;
  }
  .nav-item::after {
    content: '';
    position: absolute;
    bottom: -2px;
    left: 0;
    width: 0;
    height: 2px;
    background: #1B3A2D;
    border-radius: 2px;
    transition: width 0.28s ease;
  }
  .nav-item:hover::after,
  .nav-item.active::after {
    width: 100%;
  }

  /* ── More dropdown ── */
  .more-dropdown {
    opacity: 0;
    visibility: hidden;
    transform: translateY(6px);
    transition: opacity 0.2s ease, transform 0.2s ease, visibility 0.2s;
  }
  .more-wrapper:hover .more-dropdown,
  .more-wrapper:focus-within .more-dropdown {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }
</style>

<header id="site-header" class="fixed top-0 left-0 right-0 z-40">

  <!-- ── Top Info Bar (desktop only) ── -->
  <div class="bg-[#1c2b3a] xl:block hidden">
    <div class="max-w-7xl mx-auto px-6 xl:px-8 flex items-center justify-between h-10">

      <!-- Left: phone + email -->
      <div class="flex items-center gap-6 text-[11px] text-white/65">
        <a href={`tel:${SITE.phone.replace(/\s/g,'')}`}
           class="flex items-center gap-1.5 hover:text-white transition-colors duration-200">
          <svg class="w-3 h-3 text-[#4db89e]" fill="currentColor" viewBox="0 0 20 20">
            <path d="M2 3a1 1 0 011-1h2.153a1 1 0 01.986.836l.74 4.435a1 1 0 01-.54 1.06l-1.548.773a11.037 11.037 0 006.105 6.105l.774-1.548a1 1 0 011.059-.54l4.435.74a1 1 0 01.836.986V17a1 1 0 01-1 1h-2C7.82 18 2 12.18 2 5V3z"/>
          </svg>
          {SITE.phone}
        </a>
        <a href={`mailto:${SITE.email}`}
           class="flex items-center gap-1.5 hover:text-white transition-colors duration-200">
          <svg class="w-3 h-3 text-[#4db89e]" fill="currentColor" viewBox="0 0 20 20">
            <path d="M2.003 5.884L10 9.882l7.997-3.998A2 2 0 0016 4H4a2 2 0 00-1.997 1.884z"/>
            <path d="M18 8.118l-8 4-8-4V14a2 2 0 002 2h12a2 2 0 002-2V8.118z"/>
          </svg>
          {SITE.email}
        </a>
      </div>

      <!-- Centre: trust links -->
      <div class="flex items-center gap-1 text-[11px] text-white/50">
        <span class="text-white/20 px-2">|</span>
        <a href="/tours" class="hover:text-white transition-colors duration-200 px-2 whitespace-nowrap">Best Places to Visit in Sri Lanka</a>
        <span class="text-white/20 px-1">|</span>
        <a href="/tailor-made" class="hover:text-white transition-colors duration-200 px-2 whitespace-nowrap">Book Your Private Tour with Emil</a>
        <span class="text-white/20 px-1">|</span>
        <a href="/about" class="hover:text-white transition-colors duration-200 px-2 whitespace-nowrap">About Emil</a>
        <span class="text-white/20 px-2">|</span>
      </div>

      <!-- Right: GET A QUOTE -->
      <a href="/tailor-made"
         class="btn-get-quote bg-[#2e7d6e] hover:bg-[#25a08d] text-white font-semibold
                px-4 py-1.5 text-[11px] tracking-wider uppercase rounded transition-colors duration-200">
        Get a Quote
      </a>
    </div>
  </div>

  <!-- ── Main Navbar ── -->
  <div id="main-nav"
       class="bg-white border-b border-gray-100 transition-shadow duration-300 shadow-sm">
    <div class="max-w-7xl mx-auto px-6 xl:px-8 flex items-center justify-between h-[68px]">

      <!-- Logo -->
      <a href="/" class="flex items-center gap-2.5 sm:gap-3 group shrink-0" aria-label="Chauffeur Emil Lanka Tours home">
        <div class="w-9 h-9 sm:w-11 sm:h-11 rounded-full bg-forest-700 flex items-center justify-center
                    ring-2 ring-[#2e7d6e]/30 group-hover:ring-[#2e7d6e] transition-all duration-300 shrink-0">
          <span class="text-gold-400 font-bold text-lg sm:text-xl" style="font-family:'Playfair Display',serif">E</span>
        </div>
        <div class="leading-tight">
          <div class="text-forest-700 text-xs sm:text-sm font-bold tracking-tight sm:tracking-wide" style="font-family:'Playfair Display',serif">
            ChauffeurEmilLankaTour
          </div>
          <div class="text-[#2e7d6e] text-[8px] sm:text-[9px] font-semibold tracking-[0.15em] sm:tracking-[0.2em] uppercase mt-0.5">
            Sri Lanka Private Tours
          </div>
        </div>
      </a>

      <!-- Desktop Nav Links -->
      <nav class="hidden xl:flex items-center gap-8 flex-1" aria-label="Main navigation">
        {navLinks.map(link => (
          <a href={link.href}
             class="nav-item text-[13.5px] font-medium text-gray-600 hover:text-forest-700 transition-colors duration-200">
            {link.label}
          </a>
        ))}

        <!-- More dropdown -->
        <div class="more-wrapper relative">
          <button class="nav-item flex items-center gap-1 text-[13.5px] font-medium text-gray-600
                         hover:text-forest-700 transition-colors duration-200 bg-transparent border-none cursor-pointer">
            More
            <svg class="w-3.5 h-3.5 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/>
            </svg>
          </button>
          <!-- Dropdown panel -->
          <div class="more-dropdown absolute top-full left-0 mt-3 w-48 bg-white rounded-xl shadow-xl
                      border border-gray-100 overflow-hidden z-50">
            {moreLinks.map(link => (
              <a href={link.href}
                 class="flex items-center gap-2.5 px-4 py-3 text-[13px] text-gray-600
                        hover:bg-gray-50 hover:text-forest-700 transition-colors duration-150
                        border-b border-gray-50 last:border-0">
                <span class="w-1 h-1 rounded-full bg-[#2e7d6e] shrink-0"></span>
                {link.label}
              </a>
            ))}
          </div>
        </div>
      </nav>

      <!-- Desktop Right: Social icons + Book Tour -->
      <div class="hidden xl:flex items-center gap-5">

        <!-- Social icons -->
        <div class="flex items-center gap-1">
          <!-- WhatsApp -->
          <a href={waUrl} target="_blank" rel="noopener noreferrer" aria-label="WhatsApp Emil"
             class="w-8 h-8 flex items-center justify-center rounded-full text-gray-400
                    hover:text-[#25D366] hover:bg-[#25D366]/10 transition-all duration-200">
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
            </svg>
          </a>
          <!-- Instagram -->
          <a href={SITE.social.instagram} target="_blank" rel="noopener noreferrer" aria-label="Instagram"
             class="w-8 h-8 flex items-center justify-center rounded-full text-gray-400
                    hover:text-pink-500 hover:bg-pink-50 transition-all duration-200">
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
            </svg>
          </a>
          <!-- Facebook -->
          <a href={SITE.social.facebook} target="_blank" rel="noopener noreferrer" aria-label="Facebook"
             class="w-8 h-8 flex items-center justify-center rounded-full text-gray-400
                    hover:text-blue-600 hover:bg-blue-50 transition-all duration-200">
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
              <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
            </svg>
          </a>
          <!-- TripAdvisor -->
          <a href={SITE.social.tripadvisor} target="_blank" rel="noopener noreferrer" aria-label="TripAdvisor"
             class="w-8 h-8 flex items-center justify-center rounded-full text-gray-400
                    hover:text-[#34E0A1] hover:bg-[#34E0A1]/10 transition-all duration-200">
            <svg class="w-[17px] h-[17px]" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 2C6.477 2 2 6.477 2 12s4.477 10 10 10 10-4.477 10-10S17.523 2 12 2zm-4.5 6.5a1.5 1.5 0 110 3 1.5 1.5 0 010-3zm9 0a1.5 1.5 0 110 3 1.5 1.5 0 010-3zm-4.5-.75c-2.071 0-3.75 1.679-3.75 3.75 0 .507.1.99.279 1.432L12 15.5l3.471-2.068A3.726 3.726 0 0015.75 12c0-2.071-1.679-3.75-3.75-3.75z"/>
            </svg>
          </a>
        </div>

        <!-- Book Tour CTA with light sweep -->
        <a href="/tailor-made"
           class="btn-book-tour flex items-center gap-2 bg-[#2e7d6e] hover:bg-[#256b5f] text-white
                  font-semibold text-[13px] px-6 py-2.5 rounded-full
                  transition-colors duration-300 whitespace-nowrap shadow-sm hover:shadow-md">
          Book Tour
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
          </svg>
        </a>
      </div>

      <!-- Mobile menu button -->
      <MobileMenu client:load links={allMobileLinks} whatsapp={SITE.whatsapp} />
    </div>
  </div>
</header>

<!-- Spacer: desktop = top-bar (40px) + nav (68px) = 108px; mobile = nav (68px) -->
<div class="xl:h-[108px] h-[68px]"></div>

<script>
  const mainNav = document.getElementById('main-nav');
  window.addEventListener('scroll', () => {
    if (window.scrollY > 10) {
      mainNav?.classList.add('shadow-md');
      mainNav?.classList.remove('shadow-sm');
    } else {
      mainNav?.classList.remove('shadow-md');
      mainNav?.classList.add('shadow-sm');
    }
  }, { passive: true });

  // Mark active nav link
  const links = document.querySelectorAll('.nav-item');
  links.forEach(link => {
    const a = link as HTMLAnchorElement;
    if (a.href && a.pathname === window.location.pathname) {
      a.classList.add('active', 'text-forest-700');
    }
  });
</script>
