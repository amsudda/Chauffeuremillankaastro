---
import { SITE } from '../../data/site';
const taUrl = SITE.social.tripadvisor;
---

<!-- TripAdvisor FAB — sits above WhatsApp button -->
<a
  href={taUrl}
  target="_blank"
  rel="noopener noreferrer"
  aria-label="Read our reviews on TripAdvisor"
  class="tripadvisor-fab bottom-44 right-4 xl:bottom-28 xl:right-6 w-14 h-14 xl:w-16 xl:h-16"
>
  <!-- TripAdvisor owl logo (official brand green) -->
  <svg class="w-8 h-8 sm:w-9 sm:h-9" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
    <path d="M12 2C6.477 2 2 6.477 2 12s4.477 10 10 10 10-4.477 10-10S17.523 2 12 2zm0 1.5c4.694 0 8.5 3.806 8.5 8.5s-3.806 8.5-8.5 8.5S3.5 16.694 3.5 12 7.306 3.5 12 3.5zm-4.5 5a2 2 0 100 4 2 2 0 000-4zm9 0a2 2 0 100 4 2 2 0 000-4zm-4.5-.25C10.12 8.25 8.5 9.87 8.5 11.85c0 .46.09.9.24 1.31L12 15l3.26-1.84c.15-.41.24-.85.24-1.31 0-1.98-1.62-3.6-3.5-3.6zM7.5 8.5a1 1 0 110 2 1 1 0 010-2zm9 0a1 1 0 110 2 1 1 0 010-2zm-4.5.25c1.17 0 2.1.94 2.1 2.1 0 .36-.1.7-.26 1l-1.84 1.04-1.84-1.04a2.07 2.07 0 01-.26-1c0-1.16.93-2.1 2.1-2.1z"/>
  </svg>
  <span class="sr-only">Reviews on TripAdvisor</span>
</a>

<style>
  .tripadvisor-fab {
    position: fixed;
    z-index: 49;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 9999px;
    background-color: #34E0A1;
    color: #000;
    box-shadow: 0 4px 14px rgba(0,0,0,0.25);
    transition: transform 0.2s, box-shadow 0.2s;
  }
  .tripadvisor-fab:hover {
    transform: scale(1.08);
    box-shadow: 0 6px 20px rgba(0,0,0,0.3);
  }
</style>
