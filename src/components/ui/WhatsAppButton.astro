---
import { SITE } from '../../data/site';
const waUrl = `https://wa.me/${SITE.whatsapp}?text=Hello%20Emil%2C%20I%27d%20like%20to%20enquire%20about%20a%20private%20Sri%20Lanka%20tour`;
const taUrl = SITE.social.tripadvisor;
---

<!-- WhatsApp FAB — bottom right, above mobile sticky bar -->
<a
  href={waUrl}
  target="_blank"
  rel="noopener noreferrer"
  aria-label="Chat with Emil on WhatsApp"
  class="whatsapp-fab bottom-24 right-4 xl:bottom-8 xl:right-6 w-14 h-14 xl:w-16 xl:h-16"
>
  <svg class="w-7 h-7 sm:w-8 sm:h-8" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
    <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
  </svg>
  <span class="sr-only">Chat on WhatsApp</span>
</a>

<!-- Mobile sticky bottom bar -->
<div class="sticky-cta xl:hidden px-4 py-3 flex items-center gap-3 border-t border-white/10">
  <a
    href={waUrl}
    target="_blank"
    rel="noopener noreferrer"
    class="flex-1 flex items-center justify-center gap-2 py-3 rounded-full bg-[#25D366]
           text-white font-semibold text-sm"
  >
    <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
      <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
    </svg>
    WhatsApp Emil
  </a>
  <a
    href={taUrl}
    target="_blank"
    rel="noopener noreferrer"
    class="flex items-center justify-center gap-1.5 px-3 py-3 rounded-full bg-[#34E0A1]
           text-black font-semibold text-sm shrink-0"
  >
    <!-- TripAdvisor owl -->
    <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor">
      <path d="M12 2C6.477 2 2 6.477 2 12s4.477 10 10 10 10-4.477 10-10S17.523 2 12 2zm-4.5 6.5a1 1 0 110 2 1 1 0 010-2zm9 0a1 1 0 110 2 1 1 0 010-2zm-4.5-.25c-1.88 0-3.5 1.62-3.5 3.6 0 .46.09.9.24 1.31L12 15l3.26-1.84c.15-.41.24-.85.24-1.31 0-1.98-1.62-3.6-3.5-3.6z"/>
    </svg>
    Reviews
  </a>
  <a
    href="/tailor-made"
    class="flex-1 flex items-center justify-center py-3 rounded-full border-2 border-gold-400
           text-gold-400 font-semibold text-sm hover:bg-gold-400 hover:text-forest-700 transition-colors"
  >
    Plan My Tour
  </a>
</div>
