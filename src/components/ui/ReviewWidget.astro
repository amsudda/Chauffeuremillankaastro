---
import { SITE } from '../../data/site';
const tripAdvisorReviewLink = `${SITE.social.tripadvisor}#REVIEWS`;
---

<div class="bg-white p-6 sm:p-8 rounded-3xl shadow-card border border-stone inline-block w-full max-w-lg mx-auto text-left transform transition-transform duration-300 hover:-translate-y-1">
  <div class="flex items-center gap-4 mb-6">
    <div class="w-12 h-12 rounded-full bg-[#34E0A1]/10 flex items-center justify-center flex-shrink-0">
      <!-- TripAdvisor Owl Icon SVG -->
      <svg class="w-7 h-7 text-[#000000]" viewBox="0 0 24 24" fill="currentColor">
        <path d="M23.1,13.8l-1.3-1.6c0.5-1.5,0.7-3.2,0.4-4.8c-0.2-1.6-1.1-3.1-2.4-4.1C18,2,15.6,1.4,13.2,1.8C10.7,2.2,8.6,3.6,7.1,5.6C5.5,7.6,4.8,10,5.1,12.5c0.3,2.5,1.6,4.7,3.6,6c-0.3,0.7-0.7,1.4-1.2,2l1.6,1.3l1.5-1.8c1.3,0.9,2.8,1.4,4.4,1.4c2.8,0,5.5-1.4,7.1-3.7l1.7,1.4L23.1,13.8z M15,20c-1.3,0-2.5-0.4-3.6-1c-0.1,0-0.2-0.1-0.3-0.1l-1.2,1.5l-0.8-0.6c0.7-0.8,1.2-1.7,1.6-2.6c0-0.1,0-0.2-0.1-0.3c-1.6-1-2.7-2.6-3.1-4.4c-0.4-1.8,0-3.7,1.1-5.1c1.2-1.5,2.9-2.5,4.8-2.7C15.2,4.4,17,4.8,18.4,5.9c1.4,1,2.3,2.6,2.4,4.3C20.9,12,20,13.6,18.6,14.6c0.1,0.2,0.1,0.3,0.2,0.5c0.4,1.2,0.6,2.5,0.7,3.8L15,20z"/>
        <circle cx="9.5" cy="10.5" r="1.5"/>
        <circle cx="15.5" cy="10.5" r="1.5"/>
      </svg>
    </div>
    <div>
      <h3 class="font-bold text-forest-700 text-lg">TripAdvisor Review</h3>
      <p class="text-xs text-warmgray">Takes about 2 minutes</p>
    </div>
  </div>

  <a 
    href={tripAdvisorReviewLink} 
    target="_blank" 
    rel="noopener noreferrer"
    class="block w-full text-center bg-[#34E0A1] hover:bg-[#28b884] text-forest-900 font-bold py-4 px-6 rounded-xl transition-colors duration-200"
  >
    Write a Review on TripAdvisor
  </a>
  
  <p class="text-[10px] text-warmgray text-center mt-4 leading-relaxed">
    *You will be securely redirected to TripAdvisor. If you don't have an account, it takes just a few clicks to sign in with Google or Facebook.
  </p>
</div>
