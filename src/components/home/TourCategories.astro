---
import { TOUR_CATEGORIES } from '../../data/tours';
---

<section id="categories" class="py-20 sm:py-28 bg-ivory" aria-labelledby="cat-heading">
  <div class="section-wrap">

    <!-- Section header -->
    <div class="text-center mb-14 reveal">
      <p class="section-eyebrow">What We Offer</p>
      <h2 id="cat-heading" class="section-title mb-4">
        Five Ways to Fall in Love<br class="hidden sm:block"/> with Sri Lanka
      </h2>
      <p class="text-warmgray max-w-xl mx-auto leading-relaxed">
        Every journey is private, every detail considered. Choose your adventure — or
        let Emil blend them all into one seamless island odyssey.
      </p>
    </div>

    <!-- Category grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5 lg:gap-6">
      {TOUR_CATEGORIES.map((cat, i) => (
        <a
          href={cat.slug}
          class={`tour-card group ${i === 4 ? 'sm:col-span-2 lg:col-span-1' : ''} reveal`}
          style={`animation-delay:${i * 80}ms`}
          aria-label={`Explore ${cat.title} tours`}
        >
          <!-- Image -->
          <div class="relative h-64 sm:h-72 overflow-hidden">
            <img
              src={cat.image}
              alt={cat.title}
              loading="lazy"
              width="700"
              height="470"
              class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
            />
            <div class="absolute inset-0 bg-card-overlay"></div>

            <!-- Icon badge -->
            <div class="absolute top-4 left-4 w-10 h-10 rounded-full bg-white/15 backdrop-blur-sm
                        flex items-center justify-center text-xl border border-white/20">
              {cat.icon}
            </div>

            <!-- Tour count -->
            {cat.tourCount && (
              <div class="absolute top-4 right-4 bg-forest-700/70 backdrop-blur-sm border border-white/20
                          text-white text-xs font-medium px-2.5 py-1 rounded-full">
                {cat.tourCount} tours
              </div>
            )}

            <!-- Content -->
            <div class="absolute bottom-0 left-0 right-0 p-5">
              <h3 class="font-display text-xl text-white mb-1">{cat.title}</h3>
              <p class="text-gold-300 text-xs font-medium tracking-wide">{cat.subtitle}</p>
              <p class="text-white/70 text-sm mt-2 leading-snug line-clamp-2">
                {cat.description}
              </p>

              <!-- Arrow -->
              <div class="mt-4 flex items-center gap-2 text-gold-400 text-xs font-semibold
                          group-hover:gap-3 transition-all duration-300">
                <span>Explore</span>
                <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
                </svg>
              </div>
            </div>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>
