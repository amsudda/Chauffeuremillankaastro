---
import { getFeaturedTours } from '../../data/tours';
import TourCard from '../tours/TourCard.astro';

const tours = getFeaturedTours();
---

<section id="featured-tours" class="py-20 sm:py-28 bg-stone/40" aria-labelledby="featured-heading">
  <div class="section-wrap">

    <!-- Header -->
    <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-4 mb-12 reveal">
      <div>
        <p class="section-eyebrow">Handpicked Journeys</p>
        <h2 id="featured-heading" class="section-title" data-reveal="words">Featured Tours</h2>
      </div>
      <a href="/tours" class="btn-outline-forest self-start sm:self-auto text-sm px-5 py-2.5 flex-shrink-0">
        View All Tours
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
        </svg>
      </a>
    </div>

    <!-- Tour grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-2 gap-6 lg:gap-8">
      {tours.slice(0, 4).map((tour, i) => (
        <div class="reveal" style={`animation-delay:${i * 100}ms`}>
          <TourCard tour={tour} />
        </div>
      ))}
    </div>

    <!-- View All Tours button -->
    <div class="mt-10 text-center reveal">
      <a href="/tours" class="btn-outline-forest inline-flex items-center gap-2 px-8 py-3.5 text-sm">
        View All Tour Packages
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
        </svg>
      </a>
    </div>

    <!-- Bottom CTA -->
    <div class="mt-8 text-center reveal">
      <p class="text-warmgray mb-4">Can't find your perfect match? Emil crafts custom itineraries for every travel style.</p>
      <a href="/tailor-made" class="btn-primary">
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6m0 0v6m0-6h6m-6 0H6"/>
        </svg>
        Design My Custom Tour
      </a>
    </div>
  </div>
</section>
