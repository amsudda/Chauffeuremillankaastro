---
// Scroll-driven interactive effects for the homepage
---

<!-- ─── Flying Plane ──────────────────────────────────────────────────────── -->
<div
  id="scroll-plane"
  aria-hidden="true"
  style="position:fixed;top:18%;left:-120px;z-index:40;pointer-events:none;will-change:transform;opacity:0;transition:opacity 0.6s;"
>
  <!-- Matches the provided airplane icon: solid silhouette, nose upper-right at 45° -->
  <svg width="72" height="72" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"
       style="filter:drop-shadow(1px 2px 4px rgba(0,0,0,0.18))">
    <g transform="rotate(45 12 12)">
      <!-- Material Design 'flight' path — top-down plane, rotated 45° to match icon -->
      <path d="M21 16v-2l-8-5V3.5c0-.83-.67-1.5-1.5-1.5S10 2.67 10 3.5V9l-8 5v2l8-2.5V19l-2 1.5V22l3.5-1 3.5 1v-1.5L13 19v-5.5l8 2.5z"
            fill="#1B3A2D" opacity="0.85"/>
    </g>
  </svg>
  <!-- Contrail trail -->
  <svg width="60" height="6" viewBox="0 0 60 6"
       style="position:absolute;top:50%;right:100%;transform:translateY(-50%);margin-right:2px">
    <line x1="0" y1="3" x2="60" y2="3" stroke="#1B3A2D" stroke-width="1.5" stroke-dasharray="6 5" opacity="0.18"/>
  </svg>
</div>

<!-- ─── Section Breaker: After TrustBar (Birds) ──────────────────────────── -->
<div class="section-breaker breaker-birds" aria-hidden="true">
  <svg viewBox="0 0 1200 60" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg">
    <!-- Bird 1 -->
    <g class="bird b1" transform="translate(180,28)">
      <path d="M0,0 Q-10,-8 -20,0 Q-10,-2 0,0Z" fill="#1B3A2D" opacity="0.18"/>
      <path d="M0,0 Q10,-8 20,0 Q10,-2 0,0Z"  fill="#1B3A2D" opacity="0.18"/>
    </g>
    <!-- Bird 2 -->
    <g class="bird b2" transform="translate(320,18)">
      <path d="M0,0 Q-8,-6 -16,0 Q-8,-2 0,0Z"  fill="#1B3A2D" opacity="0.14"/>
      <path d="M0,0 Q8,-6 16,0 Q8,-2 0,0Z"   fill="#1B3A2D" opacity="0.14"/>
    </g>
    <!-- Bird 3 -->
    <g class="bird b3" transform="translate(500,35)">
      <path d="M0,0 Q-12,-9 -22,0 Q-12,-2 0,0Z" fill="#C9A84C" opacity="0.2"/>
      <path d="M0,0 Q12,-9 22,0 Q12,-2 0,0Z"  fill="#C9A84C" opacity="0.2"/>
    </g>
    <!-- Bird 4 -->
    <g class="bird b4" transform="translate(740,22)">
      <path d="M0,0 Q-9,-7 -18,0 Q-9,-2 0,0Z"  fill="#1B3A2D" opacity="0.13"/>
      <path d="M0,0 Q9,-7 18,0 Q9,-2 0,0Z"   fill="#1B3A2D" opacity="0.13"/>
    </g>
    <!-- Bird 5 -->
    <g class="bird b5" transform="translate(950,30)">
      <path d="M0,0 Q-11,-8 -20,0 Q-11,-2 0,0Z" fill="#1B3A2D" opacity="0.15"/>
      <path d="M0,0 Q11,-8 20,0 Q11,-2 0,0Z"  fill="#1B3A2D" opacity="0.15"/>
    </g>
  </svg>
</div>

<!-- ─── Section Breaker: After TourCategories (Wave + Palm) ──────────────── -->
<div class="section-breaker breaker-wave" aria-hidden="true">
  <svg viewBox="0 0 1200 70" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg">
    <path class="wave-path" d="M0,40 C200,10 400,60 600,35 C800,10 1000,55 1200,30 L1200,70 L0,70 Z"
          fill="#1B3A2D" opacity="0.05"/>
    <path class="wave-path-2" d="M0,50 C300,20 600,65 900,40 C1050,28 1150,48 1200,42 L1200,70 L0,70 Z"
          fill="#C9A84C" opacity="0.06"/>
    <!-- Palm silhouette left -->
    <g transform="translate(60,5)" opacity="0.12">
      <line x1="0" y1="55" x2="0" y2="20" stroke="#1B3A2D" stroke-width="3"/>
      <path d="M0,20 Q-25,-5 -40,5 Q-20,8 0,20Z"  fill="#1B3A2D"/>
      <path d="M0,20 Q25,-5 40,5 Q20,8 0,20Z"   fill="#1B3A2D"/>
      <path d="M0,20 Q-10,-15 5,-25 Q5,-5 0,20Z"  fill="#1B3A2D"/>
    </g>
    <!-- Palm silhouette right -->
    <g transform="translate(1145,5)" opacity="0.10">
      <line x1="0" y1="55" x2="0" y2="20" stroke="#1B3A2D" stroke-width="3"/>
      <path d="M0,20 Q-22,-4 -36,5 Q-18,8 0,20Z" fill="#1B3A2D"/>
      <path d="M0,20 Q22,-4 36,5 Q18,8 0,20Z"  fill="#1B3A2D"/>
      <path d="M0,20 Q-8,-12 4,-22 Q4,-4 0,20Z"  fill="#1B3A2D"/>
    </g>
  </svg>
</div>

<!-- ─── Section Breaker: After FeaturedTours (Dotted Road) ───────────────── -->
<div class="section-breaker breaker-road" aria-hidden="true">
  <svg viewBox="0 0 1200 50" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg">
    <path d="M0,25 Q300,10 600,25 Q900,40 1200,25"
          fill="none" stroke="#1B3A2D" stroke-width="1.5" stroke-dasharray="12 10" opacity="0.15"
          class="road-path"/>
    <!-- Compass rose centre -->
    <g transform="translate(600,25)" opacity="0.2">
      <circle r="10" fill="none" stroke="#C9A84C" stroke-width="1.2"/>
      <line x1="0" y1="-10" x2="0" y2="10" stroke="#C9A84C" stroke-width="1"/>
      <line x1="-10" y1="0" x2="10" y2="0" stroke="#C9A84C" stroke-width="1"/>
      <polygon points="0,-10 -3,-5 3,-5" fill="#C9A84C"/>
      <text x="0" y="-13" text-anchor="middle" font-size="6" fill="#C9A84C" font-family="Inter,sans-serif">N</text>
    </g>
  </svg>
</div>

<!-- ─── Section Breaker: After WhyUs (Leaf scatter) ─────────────────────── -->
<div class="section-breaker breaker-leaves" aria-hidden="true">
  <svg viewBox="0 0 1200 55" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg">
    <g class="leaf l1" transform="translate(100,28) rotate(-20)">
      <path d="M0,0 Q8,-18 0,-30 Q-8,-18 0,0Z" fill="#1B3A2D" opacity="0.12"/>
      <line x1="0" y1="0" x2="0" y2="-28" stroke="#1B3A2D" stroke-width="0.8" opacity="0.1"/>
    </g>
    <g class="leaf l2" transform="translate(280,20) rotate(15)">
      <path d="M0,0 Q10,-15 0,-25 Q-10,-15 0,0Z" fill="#C9A84C" opacity="0.13"/>
    </g>
    <g class="leaf l3" transform="translate(490,32) rotate(-35)">
      <path d="M0,0 Q9,-16 0,-28 Q-9,-16 0,0Z" fill="#1B3A2D" opacity="0.10"/>
    </g>
    <g class="leaf l4" transform="translate(700,18) rotate(10)">
      <path d="M0,0 Q7,-14 0,-22 Q-7,-14 0,0Z" fill="#C9A84C" opacity="0.11"/>
    </g>
    <g class="leaf l5" transform="translate(900,30) rotate(-25)">
      <path d="M0,0 Q10,-17 0,-29 Q-10,-17 0,0Z" fill="#1B3A2D" opacity="0.12"/>
    </g>
    <g class="leaf l6" transform="translate(1100,22) rotate(30)">
      <path d="M0,0 Q8,-13 0,-23 Q-8,-13 0,0Z" fill="#1B3A2D" opacity="0.09"/>
    </g>
  </svg>
</div>

<style>
  /* ── Section breakers ──────────────────────────────────── */
  .section-breaker {
    width: 100%;
    overflow: hidden;
    line-height: 0;
    pointer-events: none;
    user-select: none;
  }
  .section-breaker svg { display: block; width: 100%; }

  .breaker-birds  { height: 60px; }
  .breaker-wave   { height: 70px; }
  .breaker-road   { height: 50px; }
  .breaker-leaves { height: 55px; }

  /* ── Bird flap animation ───────────────────────────────── */
  @keyframes flap {
    0%,100% { transform: scaleY(1); }
    50%      { transform: scaleY(0.3); }
  }
  .bird { animation: flap 1.2s ease-in-out infinite; transform-origin: center; }
  .b1 { animation-duration: 1.1s; animation-delay: 0s;    }
  .b2 { animation-duration: 1.3s; animation-delay: 0.2s;  }
  .b3 { animation-duration: 1.0s; animation-delay: 0.4s;  }
  .b4 { animation-duration: 1.2s; animation-delay: 0.1s;  }
  .b5 { animation-duration: 1.4s; animation-delay: 0.3s;  }

  /* ── Wave drift ────────────────────────────────────────── */
  @keyframes wave-drift {
    0%   { d: path("M0,40 C200,10 400,60 600,35 C800,10 1000,55 1200,30 L1200,70 L0,70 Z"); }
    50%  { d: path("M0,35 C200,55 400,15 600,40 C800,60 1000,20 1200,42 L1200,70 L0,70 Z"); }
    100% { d: path("M0,40 C200,10 400,60 600,35 C800,10 1000,55 1200,30 L1200,70 L0,70 Z"); }
  }

  /* ── Leaf gentle sway ──────────────────────────────────── */
  @keyframes sway {
    0%,100% { transform: rotate(var(--r,0deg)) translateY(0); }
    50%      { transform: rotate(calc(var(--r,0deg) + 8deg)) translateY(-3px); }
  }
  .leaf { animation: sway 3s ease-in-out infinite; }
  .l1 { --r: -20deg; animation-delay: 0s;    animation-duration: 3.2s; }
  .l2 { --r:  15deg; animation-delay: 0.5s;  animation-duration: 2.8s; }
  .l3 { --r: -35deg; animation-delay: 1.0s;  animation-duration: 3.5s; }
  .l4 { --r:  10deg; animation-delay: 0.3s;  animation-duration: 3.0s; }
  .l5 { --r: -25deg; animation-delay: 0.8s;  animation-duration: 2.6s; }
  .l6 { --r:  30deg; animation-delay: 0.2s;  animation-duration: 3.3s; }

  /* ── Road path draw ────────────────────────────────────── */
  .road-path {
    stroke-dashoffset: 2000;
    animation: draw-road 2.5s ease forwards;
    animation-play-state: paused;
  }
  .road-path.drawn { animation-play-state: running; }
  @keyframes draw-road {
    to { stroke-dashoffset: 0; }
  }

  /* ── Reduce motion ─────────────────────────────────────── */
  @media (prefers-reduced-motion: reduce) {
    .bird, .leaf, .road-path, #scroll-plane { animation: none !important; }
  }
</style>

<script>
  // ── Plane scroll effect ────────────────────────────────────────────────────
  const plane = document.getElementById('scroll-plane') as HTMLElement | null;
  if (plane) {
    let ticking = false;
    const docH  = () => document.documentElement.scrollHeight - window.innerHeight;

    const updatePlane = () => {
      const progress = Math.min(window.scrollY / docH(), 1);
      const vw       = window.innerWidth;

      // Fly from -120px to vw+120px across the full scroll range
      const x = -120 + progress * (vw + 240);
      // Gentle sine wave vertical drift
      const y = Math.sin(progress * Math.PI * 3) * 40;

      plane.style.transform  = `translate(${x}px, ${y}px)`;
      plane.style.opacity    = progress > 0.02 && progress < 0.98 ? '1' : '0';
      ticking = false;
    };

    window.addEventListener('scroll', () => {
      if (!ticking) { requestAnimationFrame(updatePlane); ticking = true; }
    }, { passive: true });
  }

  // ── Hero parallax ─────────────────────────────────────────────────────────
  const heroImg = document.getElementById('hero-img') as HTMLElement | null;
  if (heroImg) {
    let ticking2 = false;
    window.addEventListener('scroll', () => {
      if (!ticking2) {
        requestAnimationFrame(() => {
          heroImg.style.transform = `scale(1.08) translateY(${window.scrollY * 0.25}px)`;
          ticking2 = false;
        });
        ticking2 = true;
      }
    }, { passive: true });
  }

  // ── Road path draw on scroll into view ───────────────────────────────────
  const roadPath = document.querySelector('.road-path') as SVGPathElement | null;
  if (roadPath) {
    const ro = new IntersectionObserver(entries => {
      entries.forEach(e => { if (e.isIntersecting) { roadPath.classList.add('drawn'); ro.disconnect(); } });
    }, { threshold: 0.5 });
    ro.observe(roadPath.closest('.section-breaker')!);
  }

  // ── Stat counter animation ────────────────────────────────────────────────
  const counterEls = document.querySelectorAll<HTMLElement>('[data-count]');
  if (counterEls.length) {
    const co = new IntersectionObserver(entries => {
      entries.forEach(e => {
        if (!e.isIntersecting) return;
        const el     = e.target as HTMLElement;
        const target = parseFloat(el.dataset.count!);
        const suffix = el.dataset.suffix ?? '';
        const dur    = 1800;
        const start  = performance.now();
        const tick   = (now: number) => {
          const t = Math.min((now - start) / dur, 1);
          const eased = 1 - Math.pow(1 - t, 3);
          el.textContent = (Number.isInteger(target)
            ? Math.round(eased * target).toLocaleString()
            : (eased * target).toFixed(1)) + suffix;
          if (t < 1) requestAnimationFrame(tick);
        };
        requestAnimationFrame(tick);
        co.unobserve(el);
      });
    }, { threshold: 0.5 });
    counterEls.forEach(el => co.observe(el));
  }
</script>
