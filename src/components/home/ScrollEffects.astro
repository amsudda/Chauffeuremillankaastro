---
// Scroll-driven interactive effects for the homepage
---

<!-- Section breakers live in index.astro at correct positions between sections -->

<style>
  /* ── Section breakers ──────────────────────────────────── */
  .section-breaker {
    width: 100%;
    overflow: hidden;
    line-height: 0;
    pointer-events: none;
    user-select: none;
  }
  .section-breaker svg { display: block; width: 100%; }

  .breaker-birds  { height: 60px; }
  .breaker-wave   { height: 70px; }
  .breaker-road   { height: 50px; }
  .breaker-leaves { height: 55px; }

  /* ── Bird flap animation ───────────────────────────────── */
  @keyframes flap {
    0%,100% { transform: scaleY(1); }
    50%      { transform: scaleY(0.3); }
  }
  .bird { animation: flap 1.2s ease-in-out infinite; transform-origin: center; }
  .b1 { animation-duration: 1.1s; animation-delay: 0s;    }
  .b2 { animation-duration: 1.3s; animation-delay: 0.2s;  }
  .b3 { animation-duration: 1.0s; animation-delay: 0.4s;  }
  .b4 { animation-duration: 1.2s; animation-delay: 0.1s;  }
  .b5 { animation-duration: 1.4s; animation-delay: 0.3s;  }

  /* ── Wave drift ────────────────────────────────────────── */
  @keyframes wave-drift {
    0%   { d: path("M0,40 C200,10 400,60 600,35 C800,10 1000,55 1200,30 L1200,70 L0,70 Z"); }
    50%  { d: path("M0,35 C200,55 400,15 600,40 C800,60 1000,20 1200,42 L1200,70 L0,70 Z"); }
    100% { d: path("M0,40 C200,10 400,60 600,35 C800,10 1000,55 1200,30 L1200,70 L0,70 Z"); }
  }

  /* ── Leaf gentle sway ──────────────────────────────────── */
  @keyframes sway {
    0%,100% { transform: rotate(var(--r,0deg)) translateY(0); }
    50%      { transform: rotate(calc(var(--r,0deg) + 8deg)) translateY(-3px); }
  }
  .leaf { animation: sway 3s ease-in-out infinite; }
  .l1 { --r: -20deg; animation-delay: 0s;    animation-duration: 3.2s; }
  .l2 { --r:  15deg; animation-delay: 0.5s;  animation-duration: 2.8s; }
  .l3 { --r: -35deg; animation-delay: 1.0s;  animation-duration: 3.5s; }
  .l4 { --r:  10deg; animation-delay: 0.3s;  animation-duration: 3.0s; }
  .l5 { --r: -25deg; animation-delay: 0.8s;  animation-duration: 2.6s; }
  .l6 { --r:  30deg; animation-delay: 0.2s;  animation-duration: 3.3s; }

  /* ── Road path draw ────────────────────────────────────── */
  .road-path {
    stroke-dashoffset: 2000;
    animation: draw-road 2.5s ease forwards;
    animation-play-state: paused;
  }
  .road-path.drawn { animation-play-state: running; }
  @keyframes draw-road {
    to { stroke-dashoffset: 0; }
  }

  /* ── Word reveal ───────────────────────────────────────── */
  [data-reveal="words"] {
    overflow: visible;
  }
  [data-reveal="words"] .word {
    display: inline-block;
    opacity: 0;
    transform: translateY(22px);
    filter: blur(8px);
    transition:
      opacity   0.65s cubic-bezier(0.22, 1, 0.36, 1),
      transform 0.65s cubic-bezier(0.22, 1, 0.36, 1),
      filter    0.65s cubic-bezier(0.22, 1, 0.36, 1);
    /* keep words from collapsing into each other */
    white-space: pre;
  }
  [data-reveal="words"].words-visible .word {
    opacity: 1;
    transform: translateY(0);
    filter: blur(0);
  }

  /* ── Reduce motion ─────────────────────────────────────── */
  @media (prefers-reduced-motion: reduce) {
    .bird, .leaf, .road-path { animation: none !important; }
    [data-reveal="words"] .word {
      opacity: 1; transform: none; filter: none; transition: none;
    }
  }
</style>

<script>
  // ── Hero parallax ─────────────────────────────────────────────────────────
  const heroImg = document.getElementById('hero-img') as HTMLElement | null;
  if (heroImg) {
    let ticking2 = false;
    window.addEventListener('scroll', () => {
      if (!ticking2) {
        requestAnimationFrame(() => {
          heroImg.style.transform = `scale(1.08) translateY(${window.scrollY * 0.25}px)`;
          ticking2 = false;
        });
        ticking2 = true;
      }
    }, { passive: true });
  }

  // ── Road path draw on scroll into view ───────────────────────────────────
  const roadPath = document.querySelector('.road-path') as SVGPathElement | null;
  if (roadPath) {
    const ro = new IntersectionObserver(entries => {
      entries.forEach(e => { if (e.isIntersecting) { roadPath.classList.add('drawn'); ro.disconnect(); } });
    }, { threshold: 0.5 });
    ro.observe(roadPath.closest('.section-breaker')!);
  }

  // ── Stat counter animation ────────────────────────────────────────────────
  const counterEls = document.querySelectorAll<HTMLElement>('[data-count]');
  if (counterEls.length) {
    const co = new IntersectionObserver(entries => {
      entries.forEach(e => {
        if (!e.isIntersecting) return;
        const el     = e.target as HTMLElement;
        const target = parseFloat(el.dataset.count!);
        const suffix = el.dataset.suffix ?? '';
        const dur    = 1800;
        const start  = performance.now();
        const tick   = (now: number) => {
          const t = Math.min((now - start) / dur, 1);
          const eased = 1 - Math.pow(1 - t, 3);
          el.textContent = (Number.isInteger(target)
            ? Math.round(eased * target).toLocaleString()
            : (eased * target).toFixed(1)) + suffix;
          if (t < 1) requestAnimationFrame(tick);
        };
        requestAnimationFrame(tick);
        co.unobserve(el);
      });
    }, { threshold: 0.5 });
    counterEls.forEach(el => co.observe(el));
  }

  // ── Word-by-word text reveal ──────────────────────────────────────────────
  document.querySelectorAll<HTMLElement>('[data-reveal="words"]').forEach(el => {
    // Split text nodes into individual word spans, preserving <br> elements
    const splitNode = (node: ChildNode): (HTMLElement | ChildNode)[] => {
      if (node.nodeType === Node.TEXT_NODE) {
        const text = node.textContent ?? '';
        return text.split(/(\s+)/).filter(Boolean).map(part => {
          if (/^\s+$/.test(part)) {
            // preserve whitespace as a space
            return document.createTextNode(' ');
          }
          const span = document.createElement('span');
          span.className = 'word';
          span.textContent = part;
          return span;
        });
      }
      if ((node as Element).tagName === 'BR') return [node];
      // For nested elements (em, strong) wrap the whole element as one word
      const wrap = document.createElement('span');
      wrap.className = 'word';
      wrap.appendChild(node.cloneNode(true));
      return [wrap];
    };

    const nodes = Array.from(el.childNodes);
    el.innerHTML = '';
    nodes.flatMap(splitNode).forEach(n => el.appendChild(n));

    // Stagger delays per word
    const words = el.querySelectorAll<HTMLElement>('.word');
    words.forEach((w, i) => {
      w.style.transitionDelay = `${i * 55}ms`;
    });

    // Trigger on intersection
    const wo = new IntersectionObserver(entries => {
      entries.forEach(e => {
        if (e.isIntersecting) {
          el.classList.add('words-visible');
          wo.unobserve(el);
        }
      });
    }, { threshold: 0.2, rootMargin: '0px 0px -60px 0px' });
    wo.observe(el);
  });
</script>
