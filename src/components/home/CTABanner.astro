---
import { SITE } from '../../data/site';
const waUrl = `https://wa.me/${SITE.whatsapp}?text=Hello%20Emil%2C%20I%27m%20ready%20to%20plan%20my%20Sri%20Lanka%20tour`;
---

<section class="relative py-24 sm:py-32 overflow-hidden" aria-label="Call to action">
  <!-- Background -->
  <div class="absolute inset-0 z-0">
    <img
      src="https://images.unsplash.com/photo-1566552881560-0be862a7c445?w=1600&q=80&fit=crop"
      alt="Sri Lanka sunset beach"
      loading="lazy"
      width="1600"
      height="900"
      class="w-full h-full object-cover"
    />
    <div class="absolute inset-0 bg-forest-700/85"></div>
  </div>

  <!-- Content -->
  <div class="relative z-10 section-wrap text-center">
    <div class="max-w-2xl mx-auto reveal">
      <!-- Ornament -->
      <div class="flex items-center justify-center gap-4 mb-8">
        <div class="w-12 h-px bg-gold-400/50"></div>
        <span class="text-gold-400 text-2xl" aria-hidden="true">✦</span>
        <div class="w-12 h-px bg-gold-400/50"></div>
      </div>

      <p class="section-eyebrow">Ready to Begin?</p>
      <h2 class="font-display text-4xl sm:text-5xl text-ivory leading-tight mb-6">
        Your Sri Lanka Story<br/>
        Starts with a Message
      </h2>
      <p class="text-white/70 text-lg leading-relaxed mb-10">
        Tell Emil when you're arriving, how long you have, and what excites you most.
        He'll craft a private itinerary within 24 hours — completely free, no obligation.
      </p>

      <!-- CTAs -->
      <div class="flex flex-col sm:flex-row gap-4 justify-center items-center">
        <a href={waUrl} target="_blank" rel="noopener noreferrer"
           class="w-full sm:w-auto flex items-center justify-center gap-3 bg-[#25D366] hover:bg-[#20b558]
                  text-white font-semibold py-4 px-8 rounded-full text-base transition-all duration-300
                  shadow-lg hover:shadow-xl hover:scale-105">
          <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
          </svg>
          WhatsApp Emil Now
        </a>
        <a href="/tailor-made"
           class="w-full sm:w-auto btn-secondary py-4 px-8 text-base">
          Plan My Tour
        </a>
      </div>

      <!-- Reassurance line -->
      <p class="mt-8 text-white/40 text-sm">
        Free itinerary planning · No obligation · Responds within 2 hours
      </p>
    </div>
  </div>
</section>
