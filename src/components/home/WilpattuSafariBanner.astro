---
import { SITE } from '../../data/site';
import { img } from '../../data/imageUrls';

// Pre-filled WhatsApp enquiry for the Wilpattu pick-up offer
const waMessage = "Hi Emil, I'm interested in your Wilpattu safari with pick-up and drop-off. Can you send me details and pricing?";
const waUrl = `https://wa.me/${SITE.whatsapp}?text=${encodeURIComponent(waMessage)}`;

// Pick-up bases — edit this list freely
const pickups = ['Sigiriya', 'Dambulla', 'Anuradhapura', 'Habarana', 'Negombo', 'Trincomalee'];
---

<section class="section-wrap py-14 sm:py-20">
  <div class="relative overflow-hidden rounded-[2rem] shadow-card-hover reveal">
    <!-- Background image -->
    <img
      src={img('destinations/wilpattu.webp')}
      alt="Leopard in Wilpattu National Park — Sri Lanka's largest wildlife reserve"
      loading="lazy"
      width="1200" height="600"
      class="absolute inset-0 w-full h-full object-cover"
    />
    <!-- Dark forest overlay for legibility -->
    <div class="absolute inset-0 bg-gradient-to-r from-forest-800/95 via-forest-700/85 to-forest-700/40"></div>
    <div class="absolute inset-0 opacity-20"
         style="background-image:radial-gradient(circle at 85% 20%, #C9A84C 0%, transparent 45%)"></div>

    <!-- Content -->
    <div class="relative z-10 px-6 py-10 sm:px-12 sm:py-14 lg:py-16 max-w-3xl">
      <!-- Badge -->
      <div class="inline-flex items-center gap-2 bg-gold-400 text-forest-800 rounded-full px-4 py-1.5 mb-5">
        <span class="relative flex h-2 w-2">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-forest-700/60"></span>
          <span class="relative inline-flex rounded-full h-2 w-2 bg-forest-700"></span>
        </span>
        <span class="text-[11px] font-bold tracking-widest uppercase">Wilpattu Safari Offer</span>
      </div>

      <!-- Headline -->
      <h2 class="font-display text-3xl sm:text-4xl lg:text-5xl text-white leading-tight mb-4">
        Wilpattu Leopard Safari —<br class="hidden sm:block"/>
        <em class="not-italic text-gold-300">We Pick You Up. Anywhere.</em>
      </h2>

      <p class="text-white/80 text-base sm:text-lg leading-relaxed mb-6 max-w-xl">
        Explore Sri Lanka's largest national park — leopards, sloth bears, elephants and
        birdlife across wild lakes and jungle. Emil collects you from your hotel and drops
        you wherever you're headed next. No backtracking, no group bus.
      </p>

      <!-- Pick-up chips -->
      <p class="text-gold-300 text-xs font-semibold tracking-widest uppercase mb-3">Free pick-up from</p>
      <div class="flex flex-wrap gap-2 mb-4">
        {pickups.map(town => (
          <span class="inline-flex items-center gap-1.5 bg-white/10 border border-white/20 rounded-full
                       px-3.5 py-1.5 text-white text-sm backdrop-blur-sm">
            <svg class="w-3.5 h-3.5 text-gold-300 flex-shrink-0" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5a2.5 2.5 0 110-5 2.5 2.5 0 010 5z"/>
            </svg>
            {town}
          </span>
        ))}
        <span class="inline-flex items-center bg-gold-400/15 border border-gold-400/40 rounded-full
                     px-3.5 py-1.5 text-gold-200 text-sm">+ anywhere on the island</span>
      </div>

      <p class="text-white/70 text-sm mb-8">
        <span class="text-white font-semibold">Drop-off anywhere after the safari</span> — continue to
        Sigiriya, the coast, the hills, or straight to the airport. Your route, your call.
      </p>

      <!-- CTAs -->
      <div class="flex flex-wrap gap-3">
        <a href={waUrl} target="_blank" rel="noopener noreferrer"
           class="flex items-center gap-2 bg-[#25D366] text-white font-semibold px-6 py-3.5 rounded-full text-sm hover:bg-[#1fb959] transition-colors">
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
          </svg>
          Book the Wilpattu Safari
        </a>
        <a href="/tailor-made"
           class="flex items-center gap-2 border border-white/40 text-white font-semibold px-6 py-3.5 rounded-full text-sm hover:bg-white/10 transition-colors">
          Get a Custom Quote
        </a>
      </div>

      <!-- Trust line -->
      <p class="text-white/50 text-xs mt-6">
        🏅 SLTDA-certified guide · ⭐ 5.0 · 35 reviews · 💬 Replies within 2 hours
      </p>
    </div>
  </div>
</section>
