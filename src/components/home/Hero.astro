---
import { SITE } from '../../data/site';
import heroImg from '../../images/destinations/Ella/ella 1 nine arch.webp';
---

<section
  id="hero"
  class="relative min-h-screen flex items-end pb-16 sm:pb-24 lg:pb-32 overflow-hidden"
  aria-label="Hero section"
>
  <!-- Background image with parallax effect -->
  <div class="absolute inset-0 z-0">
    <img
      src={heroImg.src}
      alt="Nine Arch Bridge, Ella, Sri Lanka"
      class="w-full h-full object-cover object-center scale-105"
      loading="eager"
      fetchpriority="high"
      width={heroImg.width}
      height={heroImg.height}
      id="hero-img"
    />
    <!-- Cinematic overlay -->
    <div class="absolute inset-0 bg-hero-overlay"></div>
    <!-- Side vignette -->
    <div class="absolute inset-0"
         style="background: radial-gradient(ellipse at 50% 100%, transparent 40%, rgba(7,21,16,0.5) 100%)">
    </div>
  </div>

  <!-- Floating scroll indicator -->
  <div class="absolute bottom-8 left-1/2 -translate-x-1/2 z-20 hidden sm:flex flex-col items-center gap-2 animate-float">
    <span class="text-white/50 text-[10px] tracking-[0.25em] uppercase">Scroll</span>
    <div class="w-px h-10 bg-gradient-to-b from-white/50 to-transparent"></div>
  </div>

  <!-- Content -->
  <div class="relative z-10 section-wrap w-full">
    <div class="flex flex-col lg:flex-row items-end lg:items-center gap-10 lg:gap-16 w-full">

      <!-- ── Left: Headline + CTAs ── -->
      <div class="flex-1 min-w-0">

        <!-- Eyebrow -->
        <div class="flex items-center gap-3 mb-6 animate-fade-in" style="animation-delay:0.2s;animation-fill-mode:both">
          <div class="w-8 h-px bg-gold-400"></div>
          <span class="text-gold-400 text-xs font-semibold tracking-[0.25em] uppercase"
                style="font-family:'Inter',sans-serif">
            Private Chauffeur Tours · Sri Lanka
          </span>
        </div>

        <!-- Main headline -->
        <h1
          class="font-display text-hero text-white mb-4 text-balance animate-slide-up"
          style="animation-delay:0.35s;animation-fill-mode:both"
        >
          Discover Sri Lanka<br/>
          <em class="not-italic text-gold-300">Through Emil's Eyes</em>
        </h1>

        <!-- Mobile-only trust badge: visible right under headline before fold -->
        <div class="flex items-center gap-2.5 mb-5 sm:hidden animate-fade-in" style="animation-delay:0.45s;animation-fill-mode:both">
          <div class="flex">
            {[1,2,3,4,5].map(_ => (
              <svg class="w-4 h-4 text-gold-400" fill="currentColor" viewBox="0 0 20 20">
                <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
              </svg>
            ))}
          </div>
          <span class="text-white/80 text-sm font-medium">5.0 · 312 reviews on TripAdvisor</span>
        </div>

        <!-- Sub-headline -->
        <p
          class="text-white/75 text-lg sm:text-xl leading-relaxed mb-7 sm:mb-10 max-w-xl animate-slide-up"
          style="animation-delay:0.5s;animation-fill-mode:both"
        >
          <span class="hidden sm:inline">Private chauffeur journeys through ancient kingdoms, misty tea mountains,
          wild leopard territory, and turquoise shores — curated by Emil Jayasekara,
          {SITE.guide.experience} on the road.</span>
          <span class="sm:hidden">Private Sri Lanka tours with Emil Jayasekara — {SITE.guide.experience} experience, 5-star rated, SLTDA certified.</span>
        </p>

        <!-- CTA Row -->
        <div
          class="flex flex-wrap gap-4 mb-8 sm:mb-12 animate-slide-up"
          style="animation-delay:0.65s;animation-fill-mode:both"
        >
          <a href="/tours" class="btn-primary text-base px-8 py-4">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
            </svg>
            Explore All Tours
          </a>
          <a href="/tailor-made" class="btn-secondary text-base px-8 py-4">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6m0 0v6m0-6h6m-6 0H6" />
            </svg>
            Customise My Trip
          </a>
        </div>

        <!-- Trust micro-bar -->
        <div
          class="flex flex-wrap items-center gap-5 sm:gap-7 animate-fade-in"
          style="animation-delay:0.8s;animation-fill-mode:both"
        >
          <div class="flex items-center gap-2">
            <div class="flex -space-x-1">
              {[1,2,3,4,5].map(_ => (
                <svg class="w-4 h-4 text-gold-400" fill="currentColor" viewBox="0 0 20 20">
                  <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                </svg>
              ))}
            </div>
            <span class="text-white/70 text-sm">5.0 · 312 reviews</span>
          </div>
          <div class="w-px h-4 bg-white/20 hidden sm:block"></div>
          <span class="text-white/60 text-sm">SLTDA Certified</span>
          <div class="w-px h-4 bg-white/20 hidden sm:block"></div>
          <span class="text-white/60 text-sm">100% Private</span>
          <div class="w-px h-4 bg-white/20 hidden sm:block"></div>
          <span class="text-white/60 text-sm">Free Customisation</span>
        </div>
      </div>

      <!-- ── Right: Cinematic Quick-Quote Form ── -->
      <div
        id="hero-form-card"
        class="w-full lg:w-[360px] xl:w-[400px] flex-shrink-0 hidden lg:block"
        aria-label="Quick tour enquiry"
      >
        <div class="relative rounded-3xl overflow-hidden"
             style="background:rgba(7,21,16,0.55);backdrop-filter:blur(20px);-webkit-backdrop-filter:blur(20px);
                    border:1px solid rgba(201,168,76,0.25);box-shadow:0 24px 64px rgba(0,0,0,0.4);">

          <!-- Ghost demo cursor -->
          <div id="demo-cursor" aria-hidden="true"
               style="position:absolute;z-index:20;pointer-events:none;opacity:0;
                      transition:transform 0.55s cubic-bezier(0.22,1,0.36,1),opacity 0.3s ease;
                      top:0;left:0;will-change:transform;">
            <svg width="22" height="26" viewBox="0 0 22 26" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M1 1L1 21L6 16L10.5 25L13.5 23.5L9 14.5H16L1 1Z"
                    fill="white" fill-opacity="0.95" stroke="#1B3A2D" stroke-width="1.2" stroke-linejoin="round"/>
            </svg>
            <!-- Click ripple -->
            <div id="cursor-ripple"
                 style="position:absolute;top:0;left:0;width:28px;height:28px;border-radius:50%;
                        border:1.5px solid rgba(201,168,76,0.7);transform:scale(0);opacity:0;
                        transition:transform 0.35s ease-out,opacity 0.35s ease-out;pointer-events:none;
                        margin-top:-3px;margin-left:-3px;"></div>
          </div>

          <!-- Gold top bar -->
          <div class="h-px w-full" style="background:linear-gradient(90deg,transparent,rgba(201,168,76,0.6),transparent)"></div>

          <div class="p-7">

            <!-- Form header -->
            <div class="hero-form-step mb-6" style="--sd:0.1s">
              <p class="text-gold-400 text-[10px] font-semibold tracking-[0.22em] uppercase mb-1.5"
                 style="font-family:'Inter',sans-serif">Plan Your Journey</p>
              <h2 class="font-display text-white text-xl leading-snug">
                Where would you like<br/>to go in Sri Lanka?
              </h2>
            </div>

            <!-- Interests -->
            <div class="hero-form-step mb-5" style="--sd:0.3s">
              <p class="text-white/50 text-[10px] tracking-widest uppercase mb-3"
                 style="font-family:'Inter',sans-serif">I'm interested in</p>
              <div class="flex flex-wrap gap-2" id="interest-chips">
                {[
                  { icon: '🏛', label: 'Culture' },
                  { icon: '🐆', label: 'Safari' },
                  { icon: '🏔', label: 'Hill Country' },
                  { icon: '🏖', label: 'Beach' },
                  { icon: '🌿', label: 'Nature' },
                  { icon: '✨', label: 'Custom' },
                ].map(c => (
                  <button
                    type="button"
                    data-chip
                    class="flex items-center gap-1.5 px-3 py-1.5 rounded-full text-xs font-medium
                           border border-white/20 text-white/70 transition-all duration-200
                           hover:border-gold-400/60 hover:text-gold-300 hover:bg-gold-400/10
                           focus:outline-none focus:ring-1 focus:ring-gold-400/50"
                  >
                    <span aria-hidden="true">{c.icon}</span> {c.label}
                  </button>
                ))}
              </div>
            </div>

            <!-- Month + Travellers row -->
            <div class="hero-form-step grid grid-cols-2 gap-3 mb-5" style="--sd:0.5s">
              <div>
                <label class="text-white/50 text-[10px] tracking-widest uppercase block mb-2"
                       style="font-family:'Inter',sans-serif" for="hf-month">When</label>
                <select id="hf-month"
                  class="w-full bg-white/8 border border-white/15 rounded-xl px-3 py-2.5
                         text-white text-sm focus:outline-none focus:border-gold-400/50
                         appearance-none cursor-pointer"
                  style="background-color:rgba(255,255,255,0.06)">
                  <option value="" class="bg-forest-700">Any month</option>
                  {['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'].map((m,i) => (
                    <option value={i+1} class="bg-forest-700">{m} 2026</option>
                  ))}
                </select>
              </div>
              <div>
                <label class="text-white/50 text-[10px] tracking-widest uppercase block mb-2"
                       style="font-family:'Inter',sans-serif">Travellers</label>
                <div class="flex gap-1.5">
                  {['1','2','3–4','5+'].map(n => (
                    <button type="button" data-pax={n}
                      class="flex-1 py-2.5 rounded-xl border border-white/15 text-white/70 text-xs
                             font-medium transition-all duration-200 hover:border-gold-400/50
                             hover:text-gold-300 hover:bg-gold-400/10 focus:outline-none">
                      {n}
                    </button>
                  ))}
                </div>
              </div>
            </div>

            <!-- Name -->
            <div class="hero-form-step mb-5" style="--sd:0.65s">
              <label class="text-white/50 text-[10px] tracking-widest uppercase block mb-2"
                     style="font-family:'Inter',sans-serif" for="hf-name">Your name</label>
              <input
                id="hf-name"
                type="text"
                placeholder="e.g. Sarah"
                autocomplete="given-name"
                class="w-full bg-white/6 border border-white/15 rounded-xl px-4 py-2.5
                       text-white text-sm placeholder-white/30 focus:outline-none
                       focus:border-gold-400/50 transition-colors duration-200"
                style="background-color:rgba(255,255,255,0.06)"
              />
            </div>

            <!-- Submit -->
            <div class="hero-form-step" style="--sd:0.8s">
              <button
                id="hf-submit"
                type="button"
                class="w-full flex items-center justify-center gap-2.5 py-3.5 rounded-2xl
                       font-semibold text-sm text-forest-700 transition-all duration-300
                       hover:scale-[1.02] active:scale-[0.98] hover:shadow-gold"
                style="background:linear-gradient(135deg,#C9A84C,#E8C87A);
                       box-shadow:0 4px 20px rgba(201,168,76,0.3);"
              >
                <!-- WhatsApp icon -->
                <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
                </svg>
                WhatsApp Emil — Get a Quote
              </button>
              <p class="text-center text-white/35 text-[11px] mt-3" style="font-family:'Inter',sans-serif">
                Usually replies within 2 hours · No obligation
              </p>
            </div>

            <!-- Tailor-made link -->
            <div class="hero-form-step mt-5 pt-4 border-t border-white/10 text-center" style="--sd:0.95s">
              <p class="text-white/40 text-[11px] mb-1.5" style="font-family:'Inter',sans-serif">
                Want to share more details?
              </p>
              <a href="/tailor-made"
                 class="inline-flex items-center gap-1.5 text-gold-400/80 text-xs font-medium
                        hover:text-gold-300 transition-colors duration-200 group">
                <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/>
                </svg>
                Fill the detailed planning form
                <svg class="w-3 h-3 group-hover:translate-x-0.5 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
                </svg>
              </a>
            </div>

          </div>

          <!-- Gold bottom bar -->
          <div class="h-px w-full" style="background:linear-gradient(90deg,transparent,rgba(201,168,76,0.3),transparent)"></div>
        </div>
      </div>
      <!-- /form card -->

    </div>
  </div>
</section>

<style>
  /* ── Cinematic form step reveal ────────────────────────── */
  .hero-form-step {
    opacity: 0;
    transform: translateY(14px);
    filter: blur(5px);
    transition: opacity 0.6s cubic-bezier(0.22,1,0.36,1),
                transform 0.6s cubic-bezier(0.22,1,0.36,1),
                filter 0.55s cubic-bezier(0.22,1,0.36,1);
    transition-delay: var(--sd, 0s);
  }
  #hero-form-card.form-visible .hero-form-step {
    opacity: 1;
    transform: translateY(0);
    filter: blur(0);
  }

  /* Active chip / pax button */
  [data-chip].active, [data-pax].active {
    border-color: rgba(201,168,76,0.7) !important;
    color: #C9A84C !important;
    background: rgba(201,168,76,0.12) !important;
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-form-step { opacity: 1; transform: none; filter: none; transition: none; }
  }
</style>

<script>
  // ── Helpers ───────────────────────────────────────────────────────────────
  const wait = (ms: number) => new Promise<void>(r => setTimeout(r, ms));

  // Move cursor to an element (positions relative to the card)
  const moveTo = (cursor: HTMLElement, card: HTMLElement, el: HTMLElement, offX = 6, offY = 6) => {
    const cr = card.getBoundingClientRect();
    const er = el.getBoundingClientRect();
    const x  = er.left - cr.left + offX;
    const y  = er.top  - cr.top  + offY;
    cursor.style.transform = `translate(${x}px,${y}px)`;
  };

  const ripple = (el: HTMLElement) => {
    el.style.transform = 'scale(1.8)';
    el.style.opacity   = '1';
    setTimeout(() => { el.style.transform = 'scale(0)'; el.style.opacity = '0'; }, 350);
  };

  // ── Form reveal + demo sequence ──────────────────────────────────────────
  const card    = document.getElementById('hero-form-card')   as HTMLElement | null;
  const cursor  = document.getElementById('demo-cursor')      as HTMLElement | null;
  const rippleEl= document.getElementById('cursor-ripple')    as HTMLElement | null;
  const nameEl  = document.getElementById('hf-name')          as HTMLInputElement | null;
  const monthEl = document.getElementById('hf-month')         as HTMLSelectElement | null;

  if (card && cursor && rippleEl) {
    // 1. Reveal form fields after headline animations
    await wait(1000);
    card.classList.add('form-visible');

    // 2. Show ghost cursor after form is visible
    await wait(900);
    cursor.style.opacity = '1';

    const chips = [...document.querySelectorAll<HTMLElement>('[data-chip]')];
    const paxBtns = [...document.querySelectorAll<HTMLElement>('[data-pax]')];

    // Step 1 — click "Safari" chip
    await wait(300);
    moveTo(cursor, card, chips[1]);
    await wait(600);
    ripple(rippleEl);
    chips[1].classList.add('active');
    await wait(500);

    // Step 2 — click "Hill Country" chip
    moveTo(cursor, card, chips[2]);
    await wait(650);
    ripple(rippleEl);
    chips[2].classList.add('active');
    await wait(500);

    // Step 3 — hover month select
    if (monthEl) {
      moveTo(cursor, card, monthEl, 30, 14);
      await wait(700);
      ripple(rippleEl);
      monthEl.value = '3'; // March
      monthEl.style.borderColor = 'rgba(201,168,76,0.5)';
      await wait(150);
      monthEl.style.borderColor = '';
    }
    await wait(500);

    // Step 4 — click "2" travellers
    moveTo(cursor, card, paxBtns[1], 12, 10);
    await wait(650);
    ripple(rippleEl);
    paxBtns.forEach(b => b.classList.remove('active'));
    paxBtns[1].classList.add('active');
    await wait(500);

    // Step 5 — click name field and type demo name
    if (nameEl) {
      moveTo(cursor, card, nameEl, 20, 14);
      await wait(650);
      ripple(rippleEl);
      nameEl.style.borderColor = 'rgba(201,168,76,0.5)';
      await wait(200);
      const demoName = 'Sarah';
      for (const ch of demoName) {
        await wait(90);
        nameEl.value += ch;
      }
      await wait(400);
      nameEl.style.borderColor = '';
    }
    await wait(500);

    // Step 6 — move to submit button and hover
    const submitBtn = document.getElementById('hf-submit');
    if (submitBtn) {
      moveTo(cursor, card, submitBtn, submitBtn.offsetWidth / 2, 18);
      await wait(700);
    }

    // Step 7 — fade cursor out, reset demo values
    cursor.style.opacity = '0';
    await wait(800);

    // Reset demo selections so user starts fresh
    chips.forEach(c => c.classList.remove('active'));
    paxBtns.forEach(b => b.classList.remove('active'));
    if (nameEl) nameEl.value = '';
    if (monthEl) monthEl.value = '';
  }

  // ── Chip toggles (real interaction) ─────────────────────────────────────
  document.querySelectorAll('[data-chip]').forEach(btn => {
    btn.addEventListener('click', () => btn.classList.toggle('active'));
  });

  // ── Pax single-select ────────────────────────────────────────────────────
  document.querySelectorAll('[data-pax]').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('[data-pax]').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
    });
  });

  // ── WhatsApp message builder ─────────────────────────────────────────────
  document.getElementById('hf-submit')?.addEventListener('click', () => {
    const interests = [...document.querySelectorAll('[data-chip].active')]
      .map(b => (b.textContent ?? '').trim()).join(', ') || 'Open to suggestions';
    const month = monthEl?.value;
    const monthLabel = month
      ? monthEl!.options[parseInt(month)].text
      : 'Flexible';
    const pax  = document.querySelector('[data-pax].active')?.getAttribute('data-pax') ?? 'Not specified';
    const name = nameEl?.value.trim() || 'there';

    const msg =
      `Hi Emil! I'm ${name} and I'd love a private tour in Sri Lanka.\n\n` +
      `🌿 Interests: ${interests}\n` +
      `📅 When: ${monthLabel}\n` +
      `👥 Travellers: ${pax}\n\n` +
      `Could you put together a personalised itinerary for me?`;

    window.open(`https://wa.me/94761917039?text=${encodeURIComponent(msg)}`, '_blank');
  });

  // ── Hero parallax ─────────────────────────────────────────────────────────
  const heroImg = document.getElementById('hero-img');
  if (heroImg) {
    window.addEventListener('scroll', () => {
      const y = window.scrollY;
      if (y < window.innerHeight)
        heroImg.style.transform = `scale(1.05) translateY(${y * 0.25}px)`;
    }, { passive: true });
  }
</script>

