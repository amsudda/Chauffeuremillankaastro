---
import { SITE } from '../../data/site';
import { img } from '../../data/imageUrls';
import EmilCarousel from './EmilCarousel';

const emilImages = [
  { src: img('Emil images himself/emil 8.webp'),    caption: 'Emil at the Ella Gap' },
  { src: img('Emil images himself/emil 5.webp'),    caption: 'Safari at Minneriya' },
  { src: img('Emil images himself/emil 4.webp'),    caption: 'Mihintale sunset' },
  { src: img('Emil images himself/emil 6.webp'),    caption: 'Ravana Falls, Ella' },
  { src: img('Emil images himself/emil 7.webp'),    caption: 'Madu River safari' },
  { src: img('Emil images himself/emil 9.webp'),    caption: 'Rain or shine — we explore' },
  { src: img('Emil images himself/emil 11.webp'),   caption: 'Wilpattu safari day' },
  { src: img('Emil images himself/emil 12.webp'),   caption: 'Welcome to Sri Lanka!' },
  { src: img('Emil images himself/emil group.webp'),caption: 'Airport welcome, Colombo' },
];

const reasons = [
  {
    icon: `<svg class="w-7 h-7" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>`,
    title:  'One Guide. Your Journey.',
    body:   'Emil is personally present for every single tour — not assigned to you from a pool. You\'re travelling with the man who designed your route.',
  },
  {
    icon: `<svg class="w-7 h-7" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7"/></svg>`,
    title:  'Deeply Local Knowledge',
    body:   '14 years guiding has taken Emil down every back road, into every village, and across every national park. His insight transforms sights into stories.',
  },
  {
    icon: `<svg class="w-7 h-7" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z"/></svg>`,
    title:  '5-Star Rated',
    body:   'A perfect 5.0 rating from 35 five-star reviews on TripAdvisor. Words like "life-changing" appear more than you\'d expect.',
  },
  {
    icon: `<svg class="w-7 h-7" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4"/></svg>`,
    title:  'Fully Customisable',
    body:   'Every itinerary bends to your preferences — pace, accommodation style, dietary needs, special occasions. No rigid fixed-group tours here.',
  },
  {
    icon: `<svg class="w-7 h-7" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>`,
    title:  'Fully Insured & Licensed',
    body:   'SLTDA certified, fully insured vehicle and guide. Your safety and peace of mind are non-negotiable foundations of every tour.',
  },
  {
    icon: `<svg class="w-7 h-7" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064"/></svg>`,
    title:  'Eco-Responsible Travel',
    body:   'Sustainable itineraries, community-supporting stops, and genuine wildlife ethics. Emil\'s philosophy is to give back to the island more than we take.',
  },
];
---

<section id="why-us" class="py-20 sm:py-28 bg-ivory" aria-labelledby="why-heading">
  <div class="section-wrap">
    <div class="grid lg:grid-cols-2 gap-16 items-center">

      <!-- Left: Guide story -->
      <div class="reveal">
        <p class="section-eyebrow">Your Guide</p>
        <h2 id="why-heading" class="section-title mb-6" data-reveal="words">
          Meet Emil — Your Island Storyteller
        </h2>
        <p class="text-warmgray leading-relaxed mb-5 text-lg">
          Born and raised in Sri Lanka, Emil Jayasekara has spent over 14 years travelling every
          corner of his island — from the ancient kingdoms of the north to the whale waters of the
          deep south. He isn't a guide who reads from a script; he's a storyteller who grew up
          among these temples, jungles, and tea estates.
        </p>
        <p class="text-warmgray leading-relaxed mb-5">
          Guests consistently describe the same experience: Emil feels less like a hired driver and
          more like a trusted friend who happens to know every hidden waterfall, every family-run
          curry house, and every leopard trail in the country. He photographs your moments,
          remembers your birthday, and stays reachable every evening in case you need anything.
        </p>
        <p class="text-warmgray leading-relaxed mb-8">
          SLTDA-certified and fully insured, Emil drives with care, guides with honesty, and
          plans every detail so you can be completely present — no logistics, no stress,
          just Sri Lanka at its most authentic.
        </p>

        <!-- Emil's credentials -->
        <div class="flex flex-wrap gap-3 mb-8">
          {['SLTDA Certified', '14+ Years Experience', '5.0 Rated on TripAdvisor', 'Fluent English', 'Wildlife Tracker', 'Eco Responsible'].map(tag => (
            <span class="bg-forest-600/10 text-forest-600 border border-forest-200 text-xs font-medium px-3 py-1.5 rounded-full">
              {tag}
            </span>
          ))}
        </div>

        <a href="/about" class="btn-outline-forest">
          Read Emil's Story
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
          </svg>
        </a>
      </div>

      <!-- Right: Emil photo carousel -->
      <div class="reveal relative">
        <EmilCarousel
          client:visible
          images={emilImages}
          title={SITE.guide.name}
          subtitle={SITE.guide.title}
          experience={SITE.guide.experience}
        />

        <!-- Floating stat -->
        <div class="absolute -top-4 -right-4 sm:top-6 sm:-right-6 bg-sunset-gradient text-white
                    rounded-2xl px-5 py-4 shadow-cta text-center">
          <p class="font-display font-bold text-3xl">5.0</p>
          <p class="text-xs font-medium opacity-90">⭐ TripAdvisor Rating</p>
        </div>
      </div>
    </div>

    <!-- Why reasons grid -->
    <div class="mt-20 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {reasons.map((r, i) => (
        <div class="bg-white rounded-2xl p-6 shadow-card border border-stone hover:shadow-card-hover
                    transition-shadow duration-300 reveal" style={`animation-delay:${i * 80}ms`}>
          <div class="w-12 h-12 rounded-xl bg-forest-600/10 text-forest-600 flex items-center
                      justify-center mb-4" set:html={r.icon} />
          <h3 class="font-display text-forest-700 text-lg mb-2">{r.title}</h3>
          <p class="text-warmgray text-sm leading-relaxed">{r.body}</p>
        </div>
      ))}
    </div>
  </div>
</section>
