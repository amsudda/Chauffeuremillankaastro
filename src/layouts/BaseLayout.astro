---
import '../styles/global.css';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import WhatsAppButton from '../components/ui/WhatsAppButton.astro';
import TripAdvisorButton from '../components/ui/TripAdvisorButton.astro';
import { ViewTransitions } from 'astro:transitions';
import { SITE } from '../data/site';
import { img } from '../data/imageUrls';

interface Props {
  title?:       string;
  description?: string;
  image?:       string;
  type?:        string;
  canonical?:   string;
  noindex?:     boolean;
  alternates?:  { hreflang: string; href: string }[];
  lang?:        string;
}

const {
  title       = SITE.name,
  description = SITE.description,
  image       = '/chauffeuremillanka.png',
  type        = 'website',
  canonical   = Astro.url.href,
  noindex     = false,
  alternates  = [],
  lang        = 'en',
} = Astro.props;

const fullTitle = title === SITE.name ? title : `${title} | ${SITE.name}`;
const ogImage  = image.startsWith('http') ? image : `${SITE.url}${image}`;
const ogLocale = lang === 'en' ? 'en_US' : lang.replace('-', '_');
---

<!DOCTYPE html>
<html lang={lang} class="scroll-smooth">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta http-equiv="X-UA-Compatible" content="IE=edge" />

  <!-- Primary Meta -->
  <title>{fullTitle}</title>
  <meta name="description"     content={description} />
  <meta name="author"          content="Emil Jayasekara — Chauffeur Emil Lanka Tours" />
  <meta name="robots"          content={noindex ? 'noindex,nofollow' : 'index,follow'} />
  <link rel="canonical"        href={canonical} />

  <!-- hreflang alternates (language/region targeting) -->
  {alternates.map(a => (
    <link rel="alternate" hreflang={a.hreflang} href={a.href} />
  ))}

  <!-- Open Graph -->
  <meta property="og:type"         content={type} />
  <meta property="og:url"          content={canonical} />
  <meta property="og:title"        content={fullTitle} />
  <meta property="og:description"  content={description} />
  <meta property="og:image"        content={ogImage} />
  <meta property="og:image:width"  content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt"    content={fullTitle} />
  <meta property="og:site_name"    content={SITE.name} />
  <meta property="og:locale"       content={ogLocale} />

  <!-- Twitter Card -->
  <meta name="twitter:card"        content="summary_large_image" />
  <meta name="twitter:site"        content="@chauffeuremillankatour" />
  <meta name="twitter:title"       content={fullTitle} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image"       content={ogImage} />

  <!-- TripAdvisor -->
  <meta name="tripadvisor-verification" content="chauffeur-emil-lanka-tours" />
  <link rel="me" href="https://www.tripadvisor.com/Attraction_Review-g1500185-d15242639-Reviews-Chauffeur_Emil_Lanka_Tours-Katunayake_Negombo_Western_Province.html" />

  <!-- Google Search Console Verification — replace content value with your code from GSC -->
  <!-- <meta name="google-site-verification" content="PASTE_YOUR_GSC_CODE_HERE" /> -->

  <!-- Geo & Business -->
  <meta name="geo.region"   content="LK" />
  <meta name="geo.country"  content="Sri Lanka" />

  <!-- Schema.org — Local Business -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": ["LocalBusiness", "TourOperator"],
    "name": "Chauffeur Emil Lanka Tours",
    "description": "Private chauffeur-guided Sri Lanka tours with Emil Jayasekara",
    "url": "https://www.chauffeuremillankatour.com",
    "telephone": "+94761917039",
    "email": "emiljayasekara5@gmail.com",
    "address": {
      "@type": "PostalAddress",
      "addressCountry": "LK",
      "addressRegion": "Western Province"
    },
    "sameAs": [
      "https://instagram.com/chauffeuremillankatour",
      "https://facebook.com/chauffeuremillankatour",
      "https://www.tripadvisor.com/Attraction_Review-g1500185-d15242639-Reviews-Chauffeur_Emil_Lanka_Tours-Katunayake_Negombo_Western_Province.html"
    ],
    "areaServed": [
      { "@type": "Country", "name": "Sri Lanka" },
      { "@type": "Country", "name": "Australia" },
      { "@type": "Country", "name": "Belgium" },
      { "@type": "Country", "name": "United Kingdom" },
      { "@type": "Country", "name": "United States" }
    ],
    "priceRange": "$$",
    "image": "https://www.chauffeuremillankatour.com/images/og-default.jpg",
    "aggregateRating": {
      "@type": "AggregateRating",
      "ratingValue": 5.0,
      "reviewCount": 35
    }
  }
  </script>

  <!-- Favicon -->
  <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=2" />
  <link rel="manifest" href="/site.webmanifest" />
  <meta name="theme-color"     content="#1B3A2D" />

  <!-- Fonts: preconnect + non-blocking load -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="preload" as="style"
        href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500&family=Inter:wght@300;400;500;600&family=Cormorant+Garamond:ital,wght@0,400;0,500;1,400;1,500&display=swap"
        onload="this.onload=null;this.rel='stylesheet'" />
  <noscript>
    <link rel="stylesheet"
          href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500&family=Inter:wght@300;400;500;600&family=Cormorant+Garamond:ital,wght@0,400;0,500;1,400;1,500&display=swap" />
  </noscript>

  <!-- Astro View Transitions (smooth cross-page navigation) -->
  <ViewTransitions />

  <!-- Per-page structured data injected here -->
  <slot name="head" />

  <!-- Microsoft Clarity -->
  <script type="text/javascript">
    (function(c,l,a,r,i,t,y){
      c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
      t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;
      y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
    })(window,document,"clarity","script","wphlz3cofp");
  </script>
</head>

<body class="min-h-screen flex flex-col">

  <!-- ═══ Page Transition Overlay ════════════════════════════════════ -->
  <div id="page-transition" transition:persist="page-transition" aria-hidden="true">
    <div class="pt-content">
      <!-- Elegant Travel Spinner -->
      <div class="pt-spinner-wrapper">
        <svg class="pt-spinner" viewBox="0 0 100 100" fill="none" xmlns="http://www.w3.org/2000/svg">
          <!-- Outer dashed ring (spins slowly clockwise) -->
          <circle cx="50" cy="50" r="42" stroke="rgba(200,168,75,0.25)" stroke-width="1.5" stroke-dasharray="4 6" class="spin-slow" />
          <!-- Inner ring with glowing trail (spins fast clockwise) -->
          <circle cx="50" cy="50" r="32" stroke="#C8A84B" stroke-width="2.5" stroke-dasharray="140 201" stroke-linecap="round" class="spin-fast" />
          <!-- Center Map Pin -->
          <path d="M50 36C45 36 41 40 41 45C41 52.5 50 64 50 64C50 64 59 52.5 59 45C59 40 55 36 50 36ZM50 49C47.8 49 46 47.2 46 45C46 42.8 47.8 41 50 41C52.2 41 54 42.8 54 45C54 47.2 52.2 49 50 49Z" fill="#C8A84B" class="pt-pin" />
        </svg>
      </div>
      <!-- Brand name -->
      <div class="pt-brand">Preparing your journey...</div>
    </div>
  </div>

  <style is:global>
    /* ── Overlay base ── */
    #page-transition {
      position: fixed;
      inset: 0;
      z-index: 99999;
      background: #1B3A2D; /* Forest green */
      display: flex;
      align-items: center;
      justify-content: center;
      pointer-events: none;
      opacity: 0;
      transition: opacity 0.4s ease;
    }
    #page-transition.pt-enter  { opacity: 1; pointer-events: all; }
    #page-transition.pt-exit   { opacity: 0; pointer-events: none; }

    /* ── Content ── */
    .pt-content {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 24px;
    }

    /* ── Spinner ── */
    .pt-spinner-wrapper {
      width: 72px;
      height: 72px;
      position: relative;
    }
    .pt-spinner {
      width: 100%;
      height: 100%;
    }
    .spin-slow {
      transform-origin: 50px 50px;
      animation: pt-spin-slow 8s linear infinite;
    }
    .spin-fast {
      transform-origin: 50px 50px;
      animation: pt-spin-fast 1.5s cubic-bezier(0.4, 0, 0.2, 1) infinite;
      filter: drop-shadow(0 0 6px rgba(200,168,75,0.4));
    }
    .pt-pin {
      transform-origin: 50px 50px;
      animation: pt-pulse-pin 2s ease-in-out infinite;
    }
    
    @keyframes pt-spin-slow {
      from { transform: rotate(0deg); }
      to { transform: rotate(360deg); }
    }
    @keyframes pt-spin-fast {
      from { transform: rotate(0deg); }
      to { transform: rotate(360deg); }
    }
    @keyframes pt-pulse-pin {
      0%, 100% { transform: scale(0.95); opacity: 0.8; }
      50% { transform: scale(1.05); opacity: 1; filter: drop-shadow(0 0 4px rgba(200,168,75,0.6)); }
    }

    /* ── Brand Text ── */
    .pt-brand {
      font-family: 'Playfair Display', Georgia, serif;
      font-size: 1.1rem;
      letter-spacing: 0.05em;
      color: rgba(245,230,192,0.9);
      opacity: 0;
      transform: translateY(10px);
      transition: opacity 0.4s ease 0.2s, transform 0.4s ease 0.2s;
    }
    #page-transition.pt-enter .pt-brand {
      opacity: 1;
      transform: translateY(0);
    }
  </style>

  <Header />

  <main class="flex-1">
    <slot />
  </main>

  <Footer />
  <WhatsAppButton />
  <TripAdvisorButton />

  <!-- Page transition + scroll reveal -->
  <script is:inline>
    // ── Page transition overlay ──────────────────────────────────────
    let minWaitTime = 0;

    function getOverlay() {
      return document.getElementById('page-transition');
    }

    function showOverlay() {
      const overlay = getOverlay();
      if (!overlay) return;
      overlay.classList.remove('pt-exit');
      void overlay.offsetWidth;
      overlay.classList.add('pt-enter');
      minWaitTime = Date.now() + 800; // Enforce minimum 800ms display time
    }

    function hideOverlay() {
      const overlay = getOverlay();
      if (!overlay) return;
      const delay = Math.max(0, minWaitTime - Date.now());
      setTimeout(() => {
        overlay.classList.add('pt-exit');
        setTimeout(() => overlay.classList.remove('pt-enter', 'pt-exit'), 400);
      }, delay);
    }

    // Astro ViewTransitions lifecycle hooks
    document.addEventListener('astro:before-preparation', showOverlay);
    document.addEventListener('astro:page-load', hideOverlay);

    // ── Scroll reveal ────────────────────────────────────────────────
    function initReveal() {
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach(e => {
            if (e.isIntersecting) {
              e.target.classList.add('visible');
              observer.unobserve(e.target);
            }
          });
        },
        { threshold: 0.12, rootMargin: '0px 0px -40px 0px' }
      );
      document.querySelectorAll('.reveal:not(.visible)').forEach(el => observer.observe(el));
    }

    // Run on first load and after every page transition
    initReveal();
    document.addEventListener('astro:page-load', initReveal);
  </script>12, rootMargin: '0px 0px -40px 0px' }
