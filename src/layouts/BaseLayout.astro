---
import '../styles/global.css';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import WhatsAppButton from '../components/ui/WhatsAppButton.astro';
import TripAdvisorButton from '../components/ui/TripAdvisorButton.astro';
import { SITE } from '../data/site';
import { img } from '../data/imageUrls';

interface Props {
  title?:       string;
  description?: string;
  image?:       string;
  type?:        string;
  canonical?:   string;
  noindex?:     boolean;
}

const {
  title       = SITE.name,
  description = SITE.description,
  image       = '/chauffeuremillanka.png',
  type        = 'website',
  canonical   = Astro.url.href,
  noindex     = false,
} = Astro.props;

const fullTitle = title === SITE.name ? title : `${title} | ${SITE.name}`;
const ogImage  = image.startsWith('http') ? image : `${SITE.url}${image}`;
---

<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta http-equiv="X-UA-Compatible" content="IE=edge" />

  <!-- Primary Meta -->
  <title>{fullTitle}</title>
  <meta name="description"     content={description} />
  <meta name="author"          content="Emil Jayasekara — Chauffeur Emil Lanka Tours" />
  <meta name="robots"          content={noindex ? 'noindex,nofollow' : 'index,follow'} />
  <link rel="canonical"        href={canonical} />

  <!-- Open Graph -->
  <meta property="og:type"         content={type} />
  <meta property="og:url"          content={canonical} />
  <meta property="og:title"        content={fullTitle} />
  <meta property="og:description"  content={description} />
  <meta property="og:image"        content={ogImage} />
  <meta property="og:image:width"  content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt"    content={fullTitle} />
  <meta property="og:site_name"    content={SITE.name} />
  <meta property="og:locale"       content="en_US" />

  <!-- Twitter Card -->
  <meta name="twitter:card"        content="summary_large_image" />
  <meta name="twitter:site"        content="@chauffeuremillankatour" />
  <meta name="twitter:title"       content={fullTitle} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image"       content={ogImage} />

  <!-- TripAdvisor -->
  <meta name="tripadvisor-verification" content="chauffeur-emil-lanka-tours" />
  <link rel="me" href="https://www.tripadvisor.com/Attraction_Review-g1500185-d15242639-Reviews-Chauffeur_Emil_Lanka_Tours-Katunayake_Negombo_Western_Province.html" />

  <!-- Google Search Console Verification — replace content value with your code from GSC -->
  <!-- <meta name="google-site-verification" content="PASTE_YOUR_GSC_CODE_HERE" /> -->

  <!-- Geo & Business -->
  <meta name="geo.region"   content="LK" />
  <meta name="geo.country"  content="Sri Lanka" />

  <!-- Schema.org — Local Business -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": ["LocalBusiness", "TourOperator"],
    "name": "Chauffeur Emil Lanka Tours",
    "description": "Private chauffeur-guided Sri Lanka tours with Emil Jayasekara",
    "url": "https://www.chauffeuremillankatour.com",
    "telephone": "+94761917039",
    "email": "emiljayasekara5@gmail.com",
    "address": {
      "@type": "PostalAddress",
      "addressCountry": "LK",
      "addressRegion": "Western Province"
    },
    "sameAs": [
      "https://instagram.com/chauffeuremillankatour",
      "https://facebook.com/chauffeuremillankatour",
      "https://www.tripadvisor.com/Attraction_Review-g1500185-d15242639-Reviews-Chauffeur_Emil_Lanka_Tours-Katunayake_Negombo_Western_Province.html"
    ],
    "priceRange": "$$",
    "image": "https://www.chauffeuremillankatour.com/images/og-default.jpg",
    "aggregateRating": {
      "@type": "AggregateRating",
      "ratingValue": 5.0,
      "reviewCount": 312
    }
  }
  </script>

  <!-- Favicon -->
  <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=2" />
  <link rel="manifest" href="/site.webmanifest" />
  <meta name="theme-color"     content="#1B3A2D" />

  <!-- Fonts: preconnect + non-blocking load -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="preload" as="style"
        href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500&family=Inter:wght@300;400;500;600&family=Cormorant+Garamond:ital,wght@0,400;0,500;1,400;1,500&display=swap"
        onload="this.onload=null;this.rel='stylesheet'" />
  <noscript>
    <link rel="stylesheet"
          href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500&family=Inter:wght@300;400;500;600&family=Cormorant+Garamond:ital,wght@0,400;0,500;1,400;1,500&display=swap" />
  </noscript>

  <!-- Per-page structured data injected here -->
  <slot name="head" />

  <!-- Microsoft Clarity -->
  <script type="text/javascript">
    (function(c,l,a,r,i,t,y){
      c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
      t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;
      y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
    })(window,document,"clarity","script","wphlz3cofp");
  </script>
</head>

<body class="min-h-screen flex flex-col">

  <!-- ── Perahera Announcement Bar ── -->
  <div id="perahera-bar"
       class="relative z-50 bg-forest-700 border-b border-gold-400/30 px-4 py-2.5
              flex items-center justify-center gap-3 text-center">
    <span class="text-lg" aria-hidden="true">🐘</span>
    <p class="text-white text-xs sm:text-sm font-medium leading-snug">
      <span class="text-gold-300 font-semibold">Kandy Esala Perahera 2026</span>
      <span class="hidden sm:inline text-white/70"> · </span>
      <span class="block sm:inline text-white/80 text-xs">Sri Lanka's greatest festival — August. Limited tour spots available.</span>
      <a href="/tailor-made"
         class="ml-2 inline-block bg-gold-400 text-forest-800 text-xs font-bold px-3 py-1 rounded-full
                hover:bg-gold-300 transition-colors whitespace-nowrap">
        Book Now →
      </a>
    </p>
    <button id="close-bar" aria-label="Dismiss"
            class="absolute right-3 top-1/2 -translate-y-1/2 text-white/50 hover:text-white transition-colors text-lg leading-none">
      ×
    </button>
  </div>

  <!-- ── Perahera Modal Popup ── -->
  <div id="perahera-modal"
       class="fixed inset-0 z-[999] flex items-center justify-center p-4 opacity-0 pointer-events-none transition-opacity duration-500">
    <!-- Backdrop -->
    <div id="modal-backdrop" class="absolute inset-0 bg-black/60 backdrop-blur-sm"></div>
    <!-- Card -->
    <div class="relative z-10 bg-white rounded-3xl overflow-hidden shadow-2xl max-w-sm w-full">
      <!-- Image -->
      <div class="relative h-52 overflow-hidden">
        <img
          src={img('destinations/kandy/kandy temple of the tooth.webp')}
          alt="Kandy Esala Perahera festival — Temple of the Tooth"
          class="w-full h-full object-cover"
          loading="eager"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-forest-700/80 to-transparent"></div>
        <div class="absolute bottom-4 left-4 right-4">
          <p class="text-gold-300 text-xs font-semibold tracking-widest uppercase mb-1">August 2026</p>
          <h2 class="font-display text-white text-xl leading-tight">Kandy Esala Perahera</h2>
        </div>
        <button id="close-modal" aria-label="Close"
                class="absolute top-3 right-3 w-8 h-8 rounded-full bg-black/40 text-white flex items-center justify-center
                       hover:bg-black/60 transition-colors text-lg leading-none">
          ×
        </button>
      </div>
      <!-- Body -->
      <div class="p-6">
        <p class="text-warmgray text-sm leading-relaxed mb-5">
          Sri Lanka's most spectacular festival — 10 nights of candlelit processions,
          decorated elephants, and traditional drumming through the streets of Kandy.
          Emil arranges front-row viewing, temple access, and full itinerary around the festival.
        </p>
        <div class="flex gap-3">
          <a href="/tailor-made"
             class="flex-1 bg-forest-600 hover:bg-forest-700 text-white text-sm font-semibold
                    py-3 rounded-full text-center transition-colors">
            Plan My Perahera Trip
          </a>
          <a href="/contact"
             class="flex-1 border border-forest-200 text-forest-700 text-sm font-semibold
                    py-3 rounded-full text-center hover:bg-forest-50 transition-colors">
            Ask Emil
          </a>
        </div>
        <p class="text-center text-warmgray/60 text-xs mt-3">Limited spots · August fills fast</p>
      </div>
    </div>
  </div>

  <Header />

  <main class="flex-1">
    <slot />
  </main>

  <Footer />
  <WhatsAppButton />
  <TripAdvisorButton />

  <!-- Perahera bar + modal script -->
  <script>
    // Announcement bar
    const bar = document.getElementById('perahera-bar');
    if (bar && !sessionStorage.getItem('perahera-bar-closed')) {
      document.getElementById('close-bar')?.addEventListener('click', () => {
        bar.style.display = 'none';
        sessionStorage.setItem('perahera-bar-closed', '1');
      });
    } else if (bar) {
      bar.style.display = 'none';
    }

    // Modal — show after 5s, once per session
    const modal = document.getElementById('perahera-modal');
    if (modal && !sessionStorage.getItem('perahera-modal-shown')) {
      setTimeout(() => {
        modal.classList.remove('opacity-0', 'pointer-events-none');
        sessionStorage.setItem('perahera-modal-shown', '1');
      }, 5000);
      const close = () => {
        modal.classList.add('opacity-0', 'pointer-events-none');
      };
      document.getElementById('close-modal')?.addEventListener('click', close);
      document.getElementById('modal-backdrop')?.addEventListener('click', close);
    }
  </script>

  <!-- Scroll reveal script -->
  <script>
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach(e => {
          if (e.isIntersecting) {
            e.target.classList.add('visible');
            observer.unobserve(e.target);
          }
        });
      },
      { threshold: 0.12, rootMargin: '0px 0px -40px 0px' }
    );
    document.querySelectorAll('.reveal').forEach(el => observer.observe(el));
  </script>
</body>
</html>
